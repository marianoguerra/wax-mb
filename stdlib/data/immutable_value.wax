// Immutable JSON-like values for Wax.
//
// Concatenate hashing.wax, persistent_hash_map.wax,
// persistent_hash_set.wax, persistent_vector.wax, and text/utf8.wax before
// this file, then concatenate data/record.wax. Values constructed through this
// API are non-null and acyclic.

const jv_kind_null = 0;
const jv_kind_bool = 1;
const jv_kind_string = 2;
const jv_kind_i32 = 3;
const jv_kind_i64 = 4;
const jv_kind_f32 = 5;
const jv_kind_f64 = 6;
const jv_kind_vector = 7;
const jv_kind_map = 8;
const jv_kind_any = 9;
const jv_kind_set = 10;
const jv_kind_record = 11;

rec {
    type jv_value = open { kind: i32 };
    type jv_null_value : jv_value = { .. };
    type jv_bool_value : jv_value = { .., value: i32 };
    type jv_string_value : jv_value = { .., value: &utf8_string };
    type jv_i32_value : jv_value = { .., value: i32 };
    type jv_i64_value : jv_value = { .., value: i64 };
    type jv_f32_value : jv_value = { .., value: f32 };
    type jv_f64_value : jv_value = { .., value: f64 };
    type jv_vector_value : jv_value = { .., value: &pv_vector };
    type jv_map_value : jv_value = { .., value: &phm_map };
    type jv_any_value : jv_value = { .., value: &?any };
    type jv_set_value : jv_value = { .., value: &phs_set };
    type jv_record_value : jv_value = {
        ..,
        definition: &jv_record_type,
        values: &phm_map,
    };
    type jv_type = open { kind: i32 };
    type jv_type_scalar : jv_type = { .. };
    type jv_type_vector_value : jv_type = { .., element: &jv_type };
    type jv_type_map_value : jv_type = { .., value: &jv_type };
    type jv_type_set_value : jv_type = { .., element: &jv_type };
    type jv_type_record_value : jv_type = {
        ..,
        definition: &jv_record_type,
    };
    type jv_type_or_value : jv_type = {
        ..,
        left: &jv_type,
        right: &jv_type,
    };
    type jv_record_field = {
        value_type: &jv_type,
        default_value: &jv_value,
        validator_context: &?eq,
        validator: &func,
    };
    type jv_record_schema = {
        fields: &phm_map,
        defaults: &phm_map,
    };
    type jv_record_type = {
        name: &utf8_string,
        schema: &jv_record_schema,
        validator_context: &?eq,
        validator: &func,
    };
}

type jv_field_validator = fn(&?eq, &jv_value) -> i32;
type jv_record_validator = fn(&?eq, &jv_record_value) -> i32;

type jv_vector_visit = fn(&?eq, i32, &jv_value);
type jv_map_visit = fn(&?eq, &utf8_string, &jv_value);
type jv_set_visit = fn(&?eq, &jv_value);

type jvt_vector = { value: &pvt_vector };
type jvt_map = { value: &phmt_map };
type jvt_set = { value: &phst_set };

fn jv_null() -> &jv_value {
    let out: &jv_null_value = { kind: jv_kind_null };
    out
}

fn jv_bool(value: i32) -> &jv_value {
    let normalized = if value == 0 { 0 } else { 1 };
    let out: &jv_bool_value = { kind: jv_kind_bool, value: normalized };
    out
}

fn jv_string(value: &utf8_string) -> &jv_value {
    let out: &jv_string_value = { kind: jv_kind_string, value };
    out
}

fn jv_i32(value: i32) -> &jv_value {
    let out: &jv_i32_value = { kind: jv_kind_i32, value };
    out
}

fn jv_i64(value: i64) -> &jv_value {
    let out: &jv_i64_value = { kind: jv_kind_i64, value };
    out
}

fn jv_f32(value: f32) -> &jv_value {
    let out: &jv_f32_value = { kind: jv_kind_f32, value };
    out
}

fn jv_f64(value: f64) -> &jv_value {
    let out: &jv_f64_value = { kind: jv_kind_f64, value };
    out
}

fn jv_any(value: &?any) -> &jv_value {
    let out: &jv_any_value = { kind: jv_kind_any, value };
    out
}

fn jv_kind(value: &jv_value) -> i32 { value.kind }

fn jv_get_bool(value: &jv_value) -> (i32, i32) {
    match value {
        found: &jv_bool_value => { return (1, found.value); }
        _ => { return (0, 0); }
    }
    unreachable;
}

fn jv_require_bool(value: &jv_value) -> i32 {
    let (found, out) = jv_get_bool(value);
    if found == 0 { unreachable; }
    out
}

fn jv_get_string(value: &jv_value) -> (i32, &?utf8_string) {
    match value {
        found: &jv_string_value => { return (1, found.value); }
        _ => { return (0, null); }
    }
    unreachable;
}

fn jv_require_string(value: &jv_value) -> &utf8_string {
    let (found, out) = jv_get_string(value);
    if found == 0 { unreachable; }
    out!
}

fn jv_get_i32(value: &jv_value) -> (i32, i32) {
    match value {
        found: &jv_i32_value => { return (1, found.value); }
        _ => { return (0, 0); }
    }
    unreachable;
}

fn jv_require_i32(value: &jv_value) -> i32 {
    let (found, out) = jv_get_i32(value);
    if found == 0 { unreachable; }
    out
}

fn jv_get_i64(value: &jv_value) -> (i32, i64) {
    match value {
        found: &jv_i64_value => { return (1, found.value); }
        _ => { return (0, 0); }
    }
    unreachable;
}

fn jv_require_i64(value: &jv_value) -> i64 {
    let (found, out) = jv_get_i64(value);
    if found == 0 { unreachable; }
    out
}

fn jv_get_f32(value: &jv_value) -> (i32, f32) {
    match value {
        found: &jv_f32_value => { return (1, found.value); }
        _ => { return (0, 0); }
    }
    unreachable;
}

fn jv_require_f32(value: &jv_value) -> f32 {
    let (found, out) = jv_get_f32(value);
    if found == 0 { unreachable; }
    out
}

fn jv_get_f64(value: &jv_value) -> (i32, f64) {
    match value {
        found: &jv_f64_value => { return (1, found.value); }
        _ => { return (0, 0); }
    }
    unreachable;
}

fn jv_require_f64(value: &jv_value) -> f64 {
    let (found, out) = jv_get_f64(value);
    if found == 0 { unreachable; }
    out
}

fn jv_get_any(value: &jv_value) -> (i32, &?any) {
    match value {
        found: &jv_any_value => { return (1, found.value); }
        _ => { return (0, null); }
    }
    unreachable;
}

fn jv_require_any(value: &jv_value) -> &?any {
    let (found, out) = jv_get_any(value);
    if found == 0 { unreachable; }
    out
}

fn jv_any_equal(left: &?any, right: &?any) -> i32 {
    match left {
        null => {
            match right {
                null => { return 1; }
                _ => { return 0; }
            }
        }
        value: &eq => {
            match right {
                other: &eq => { return if value == other { 1 } else { 0 }; }
                _ => { return 0; }
            }
        }
        _ => { return 0; }
    }
    unreachable;
}

fn jv_vector_empty() -> &jv_vector_value {
    { kind: jv_kind_vector, value: pv_empty() }
}

fn jv_get_vector(value: &jv_value) -> (i32, &?jv_vector_value) {
    match value {
        found: &jv_vector_value => { return (1, found); }
        _ => { return (0, null); }
    }
    unreachable;
}

fn jv_require_vector(value: &jv_value) -> &jv_vector_value {
    let (found, out) = jv_get_vector(value);
    if found == 0 { unreachable; }
    out!
}

fn jv_vector_count(vector: &jv_vector_value) -> i32 {
    pv_count(vector.value)
}

fn jv_vector_get(vector: &jv_vector_value, index: i32) -> (i32, &?jv_value) {
    let (found, value) = pv_get(vector.value, index);
    if found == 0 { return (0, null); }
    (1, value! as &jv_value)
}

fn jv_vector_at(vector: &jv_vector_value, index: i32) -> &jv_value {
    let (found, value) = jv_vector_get(vector, index);
    if found == 0 { unreachable; }
    value!
}

fn jv_vector_push(vector: &jv_vector_value, value: &jv_value) -> &jv_vector_value {
    let raw = pv_push(vector.value, value);
    { kind: jv_kind_vector, value: raw }
}

fn jv_vector_assoc(
    vector: &jv_vector_value,
    index: i32,
    value: &jv_value,
) -> &jv_vector_value {
    let raw = pv_assoc(vector.value, index, value);
    if raw == vector.value { return vector; }
    { kind: jv_kind_vector, value: raw }
}

fn jv_vector_peek(vector: &jv_vector_value) -> (i32, &?jv_value) {
    let (found, value) = pv_peek(vector.value);
    if found == 0 { return (0, null); }
    (1, value! as &jv_value)
}

fn jv_vector_pop(vector: &jv_vector_value) -> &jv_vector_value {
    { kind: jv_kind_vector, value: pv_pop(vector.value) }
}

type jv_vector_each_context = {
    context: &?eq,
    visit: &jv_vector_visit,
};

fn jv_vector_each_adapter(context: &?eq, index: i32, value: &?eq) {
    let state = context! as &jv_vector_each_context;
    state.visit(state.context, index, value! as &jv_value);
}

fn jv_vector_each(
    vector: &jv_vector_value,
    context: &?eq,
    visit: &jv_vector_visit,
) {
    let state: &jv_vector_each_context = { context, visit };
    pv_each(vector.value, state, jv_vector_each_adapter);
}

fn jv_vector_as_transient(vector: &jv_vector_value) -> &jvt_vector {
    { value: pv_as_transient(vector.value) }
}

fn jvt_vector_count(vector: &jvt_vector) -> i32 { pvt_count(vector.value) }

fn jvt_vector_get(vector: &jvt_vector, index: i32) -> (i32, &?jv_value) {
    let (found, value) = pvt_get(vector.value, index);
    if found == 0 { return (0, null); }
    (1, value! as &jv_value)
}

fn jvt_vector_push(vector: &jvt_vector, value: &jv_value) {
    pvt_push(vector.value, value);
}

fn jvt_vector_assoc(vector: &jvt_vector, index: i32, value: &jv_value) {
    pvt_assoc(vector.value, index, value);
}

fn jvt_vector_pop(vector: &jvt_vector) { pvt_pop(vector.value); }

fn jvt_vector_persistent(vector: &jvt_vector) -> &jv_vector_value {
    { kind: jv_kind_vector, value: pvt_persistent(vector.value) }
}

fn jv_map_empty() -> &jv_map_value {
    { kind: jv_kind_map, value: phm_empty(utf8_hash_key, utf8_equal_key) }
}

fn jv_get_map(value: &jv_value) -> (i32, &?jv_map_value) {
    match value {
        found: &jv_map_value => { return (1, found); }
        _ => { return (0, null); }
    }
    unreachable;
}

fn jv_require_map(value: &jv_value) -> &jv_map_value {
    let (found, out) = jv_get_map(value);
    if found == 0 { unreachable; }
    out!
}

fn jv_map_count(map: &jv_map_value) -> i32 { phm_count(map.value) }

fn jv_map_get(map: &jv_map_value, key: &utf8_string) -> (i32, &?jv_value) {
    let (found, value) = phm_get(map.value, key);
    if found == 0 { return (0, null); }
    (1, value! as &jv_value)
}

fn jv_map_contains(map: &jv_map_value, key: &utf8_string) -> i32 {
    phm_contains(map.value, key)
}

fn jv_map_assoc(
    map: &jv_map_value,
    key: &utf8_string,
    value: &jv_value,
) -> &jv_map_value {
    let raw = phm_assoc(map.value, key, value);
    if raw == map.value { return map; }
    { kind: jv_kind_map, value: raw }
}

fn jv_map_dissoc(map: &jv_map_value, key: &utf8_string) -> &jv_map_value {
    let raw = phm_dissoc(map.value, key);
    if raw == map.value { return map; }
    { kind: jv_kind_map, value: raw }
}

type jv_map_each_context = {
    context: &?eq,
    visit: &jv_map_visit,
};

fn jv_map_each_adapter(context: &?eq, key: &?eq, value: &?eq) {
    let state = context! as &jv_map_each_context;
    state.visit(state.context, key! as &utf8_string, value! as &jv_value);
}

fn jv_map_each(map: &jv_map_value, context: &?eq, visit: &jv_map_visit) {
    let state: &jv_map_each_context = { context, visit };
    phm_each(map.value, state, jv_map_each_adapter);
}

fn jv_map_as_transient(map: &jv_map_value) -> &jvt_map {
    { value: phm_as_transient(map.value) }
}

fn jvt_map_count(map: &jvt_map) -> i32 { phmt_count(map.value) }

fn jvt_map_get(map: &jvt_map, key: &utf8_string) -> (i32, &?jv_value) {
    let (found, value) = phmt_get(map.value, key);
    if found == 0 { return (0, null); }
    (1, value! as &jv_value)
}

fn jvt_map_contains(map: &jvt_map, key: &utf8_string) -> i32 {
    phmt_contains(map.value, key)
}

fn jvt_map_assoc(map: &jvt_map, key: &utf8_string, value: &jv_value) {
    phmt_assoc(map.value, key, value);
}

fn jvt_map_dissoc(map: &jvt_map, key: &utf8_string) {
    phmt_dissoc(map.value, key);
}

fn jvt_map_persistent(map: &jvt_map) -> &jv_map_value {
    { kind: jv_kind_map, value: phmt_persistent(map.value) }
}

fn jv_hash_key(value: &eq) -> i32 { jv_hash(value as &jv_value) }

fn jv_equal_key(left: &eq, right: &eq) -> i32 {
    jv_equal(left as &jv_value, right as &jv_value)
}

fn jv_set_empty() -> &jv_set_value {
    { kind: jv_kind_set, value: phs_empty(jv_hash_key, jv_equal_key) }
}

fn jv_get_set(value: &jv_value) -> (i32, &?jv_set_value) {
    match value {
        found: &jv_set_value => { return (1, found); }
        _ => { return (0, null); }
    }
    unreachable;
}

fn jv_require_set(value: &jv_value) -> &jv_set_value {
    let (found, out) = jv_get_set(value);
    if found == 0 { unreachable; }
    out!
}

fn jv_set_count(set: &jv_set_value) -> i32 { phs_count(set.value) }

fn jv_set_contains(set: &jv_set_value, value: &jv_value) -> i32 {
    phs_contains(set.value, value)
}

fn jv_set_add(set: &jv_set_value, value: &jv_value) -> &jv_set_value {
    let raw = phs_add(set.value, value);
    if raw == set.value { return set; }
    { kind: jv_kind_set, value: raw }
}

fn jv_set_remove(set: &jv_set_value, value: &jv_value) -> &jv_set_value {
    let raw = phs_remove(set.value, value);
    if raw == set.value { return set; }
    { kind: jv_kind_set, value: raw }
}

type jv_set_each_context = {
    context: &?eq,
    visit: &jv_set_visit,
};

fn jv_set_each_adapter(context: &?eq, value: &?eq) {
    let state = context! as &jv_set_each_context;
    state.visit(state.context, value! as &jv_value);
}

fn jv_set_each(set: &jv_set_value, context: &?eq, visit: &jv_set_visit) {
    let state: &jv_set_each_context = { context, visit };
    phs_each(set.value, state, jv_set_each_adapter);
}

fn jv_set_union(left: &jv_set_value, right: &jv_set_value) -> &jv_set_value {
    { kind: jv_kind_set, value: phs_union(left.value, right.value) }
}

fn jv_set_intersection(left: &jv_set_value, right: &jv_set_value) -> &jv_set_value {
    { kind: jv_kind_set, value: phs_intersection(left.value, right.value) }
}

fn jv_set_difference(left: &jv_set_value, right: &jv_set_value) -> &jv_set_value {
    { kind: jv_kind_set, value: phs_difference(left.value, right.value) }
}

fn jv_set_as_transient(set: &jv_set_value) -> &jvt_set {
    { value: phs_as_transient(set.value) }
}

fn jvt_set_count(set: &jvt_set) -> i32 { phst_count(set.value) }

fn jvt_set_contains(set: &jvt_set, value: &jv_value) -> i32 {
    phst_contains(set.value, value)
}

fn jvt_set_add(set: &jvt_set, value: &jv_value) {
    phst_add(set.value, value);
}

fn jvt_set_remove(set: &jvt_set, value: &jv_value) {
    phst_remove(set.value, value);
}

fn jvt_set_persistent(set: &jvt_set) -> &jv_set_value {
    { kind: jv_kind_set, value: phst_persistent(set.value) }
}

type jv_map_equal_context = {
    right: &jv_map_value,
    equal: mut i32,
};

fn jv_map_equal_entry(context: &?eq, key: &utf8_string, value: &jv_value) {
    let state = context! as &jv_map_equal_context;
    if state.equal == 0 { return; }
    let (found, other) = jv_map_get(state.right, key);
    if found == 0 { state.equal = 0; return; }
    if jv_equal(value, other!) == 0 { state.equal = 0; }
}

type jv_set_equal_context = {
    right: &jv_set_value,
    equal: mut i32,
};

fn jv_set_equal_entry(context: &?eq, value: &jv_value) {
    let state = context! as &jv_set_equal_context;
    if state.equal == 0 { return; }
    if jv_set_contains(state.right, value) == 0 { state.equal = 0; }
}

fn jv_equal(left: &jv_value, right: &jv_value) -> i32 {
    if left == right { return 1; }
    if left.kind != right.kind { return 0; }
    match left {
        found: &jv_null_value => { _ = found; return 1; }
        a: &jv_bool_value => {
            return if a.value == (right as &jv_bool_value).value { 1 } else { 0 };
        }
        a: &jv_string_value => {
            return utf8_equal(a.value, (right as &jv_string_value).value);
        }
        a: &jv_i32_value => {
            return if a.value == (right as &jv_i32_value).value { 1 } else { 0 };
        }
        a: &jv_i64_value => {
            return if a.value == (right as &jv_i64_value).value { 1 } else { 0 };
        }
        a: &jv_f32_value => {
            return if a.value.to_bits() == (right as &jv_f32_value).value.to_bits() { 1 } else { 0 };
        }
        a: &jv_f64_value => {
            return if a.value.to_bits() == (right as &jv_f64_value).value.to_bits() { 1 } else { 0 };
        }
        a: &jv_vector_value => {
            let b = right as &jv_vector_value;
            if jv_vector_count(a) != jv_vector_count(b) { return 0; }
            let i: i32 = 0;
            while i <s jv_vector_count(a) {
                if jv_equal(jv_vector_at(a, i), jv_vector_at(b, i)) == 0 { return 0; }
                i += 1;
            }
            return 1;
        }
        a: &jv_map_value => {
            let b = right as &jv_map_value;
            if jv_map_count(a) != jv_map_count(b) { return 0; }
            let state: &jv_map_equal_context = { right: b, equal: 1 };
            jv_map_each(a, state, jv_map_equal_entry);
            return state.equal;
        }
        a: &jv_any_value => {
            return jv_any_equal(a.value, (right as &jv_any_value).value);
        }
        a: &jv_set_value => {
            let b = right as &jv_set_value;
            if jv_set_count(a) != jv_set_count(b) { return 0; }
            let state: &jv_set_equal_context = { right: b, equal: 1 };
            jv_set_each(a, state, jv_set_equal_entry);
            return state.equal;
        }
        a: &jv_record_value => {
            return jv_record_equal(a, right as &jv_record_value);
        }
        _ => { unreachable; }
    }
    unreachable;
}

fn jv_hash_tag(kind: i32) -> i32 {
    wax_hash_i32_seeded(kind, 0x4a56414c)
}

type jv_hash_unordered_context = {
    sum: mut i32,
    xor: mut i32,
};

fn jv_hash_unordered_add(state: &jv_hash_unordered_context, hash: i32) {
    state.sum = state.sum + hash * 0x9e3779b1;
    state.xor = state.xor ^ hash.rotl(hash & 31);
}

fn jv_hash_map_entry(context: &?eq, key: &utf8_string, value: &jv_value) {
    let state = context! as &jv_hash_unordered_context;
    let entry = wax_hash_add_i32(utf8_hash(key), jv_hash(value));
    jv_hash_unordered_add(state, wax_hash_finalize(entry, 8));
}

fn jv_hash_set_entry(context: &?eq, value: &jv_value) {
    jv_hash_unordered_add(context! as &jv_hash_unordered_context, jv_hash(value));
}

fn jv_hash(value: &jv_value) -> i32 {
    match value {
        found: &jv_null_value => { _ = found; return jv_hash_tag(jv_kind_null); }
        found: &jv_bool_value => {
            return wax_hash_i32_seeded(found.value, jv_hash_tag(jv_kind_bool));
        }
        found: &jv_string_value => {
            return wax_hash_i32_seeded(utf8_hash(found.value), jv_hash_tag(jv_kind_string));
        }
        found: &jv_i32_value => {
            return wax_hash_i32_seeded(found.value, jv_hash_tag(jv_kind_i32));
        }
        found: &jv_i64_value => {
            let bits = found.value;
            let state = wax_hash_add_i32(jv_hash_tag(jv_kind_i64), bits as i32);
            return wax_hash_finalize(wax_hash_add_i32(state, (bits >>u 32) as i32), 8);
        }
        found: &jv_f32_value => {
            return wax_hash_i32_seeded(found.value.to_bits(), jv_hash_tag(jv_kind_f32));
        }
        found: &jv_f64_value => {
            let bits = found.value.to_bits();
            let state = wax_hash_add_i32(jv_hash_tag(jv_kind_f64), bits as i32);
            return wax_hash_finalize(wax_hash_add_i32(state, (bits >>u 32) as i32), 8);
        }
        found: &jv_vector_value => {
            let state = jv_hash_tag(jv_kind_vector);
            let i: i32 = 0;
            while i <s jv_vector_count(found) {
                state = wax_hash_add_i32(state, jv_hash(jv_vector_at(found, i)));
                i += 1;
            }
            return wax_hash_finalize(state, jv_vector_count(found) * 4);
        }
        found: &jv_map_value => {
            let state: &jv_hash_unordered_context = { sum: 0, xor: 0 };
            jv_map_each(found, state, jv_hash_map_entry);
            let hash = wax_hash_add_i32(jv_hash_tag(jv_kind_map), state.sum);
            return wax_hash_finalize(wax_hash_add_i32(hash, state.xor), jv_map_count(found) * 8);
        }
        found: &jv_any_value => {
            _ = found;
            // WebAssembly exposes reference equality but no stable identity hash.
            // A constant preserves equal => same hash; many opaque values collide.
            return jv_hash_tag(jv_kind_any);
        }
        found: &jv_set_value => {
            let state: &jv_hash_unordered_context = { sum: 0, xor: 0 };
            jv_set_each(found, state, jv_hash_set_entry);
            let hash = wax_hash_add_i32(jv_hash_tag(jv_kind_set), state.sum);
            return wax_hash_finalize(wax_hash_add_i32(hash, state.xor), jv_set_count(found) * 4);
        }
        found: &jv_record_value => { return jv_record_hash(found); }
        _ => { unreachable; }
    }
    unreachable;
}
