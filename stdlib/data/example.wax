// Concatenate the immutable-data profile before this example.

#[export]
fn immutable_data_example() -> i32 {
    let name = utf8_from_bytes([wax_hash_bytes| 0x57, 0x61, 0x78]);
    let tags = jv_set_add(jv_set_empty(), jv_string(name));
    let numbers = jv_vector_push(jv_vector_push(jv_vector_empty(), jv_i32(7)), jv_i64(8));
    let object = jv_map_assoc(
        jv_map_assoc(jv_map_empty(), utf8_from_bytes([wax_hash_bytes| 0x6e, 0x61, 0x6d, 0x65]), jv_string(name)),
        utf8_from_bytes([wax_hash_bytes| 0x69, 0x74, 0x65, 0x6d, 0x73]),
        numbers,
    );
    object = jv_map_assoc(
        object,
        utf8_from_bytes([wax_hash_bytes| 0x74, 0x61, 0x67, 0x73]),
        tags,
    );
    jv_map_count(object) + jv_vector_count(numbers) + jv_set_count(tags)
}
