#!/usr/bin/env bash
# The MoonBit implementation, for the differential harness.
#
# A thin wrapper over the built executable rather than `moon run`, which would
# re-check the build graph once per file -- and that dominates over a
# 1900-file corpus.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
bin="$here/../_build/native/debug/build/marianoguerra/wax-cli/wax-mb/wax-mb.exe"
[ -x "$bin" ] || { echo "wax-mb: not built; run 'moon build --target native'" >&2; exit 127; }
exec "$bin" "$@"
