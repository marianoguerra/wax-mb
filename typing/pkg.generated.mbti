// Errors

// Types and methods
pub struct Checker {
  ctx : @typing_env.ModuleContext
  ops : Operands
  unpeeled : Map[String, Int]
}
pub fn Checker::check(Self, @infer.Cell[@infer.InferredType], @ast.Instr[@basic.Location]) -> @ast.Instr[(Array[@infer.Cell[@infer.InferredType]], @basic.Location)]
pub fn Checker::check_against(Self, Array[@infer.Cell[@infer.InferredType]], @ast.Instr[@basic.Location]) -> @ast.Instr[(Array[@infer.Cell[@infer.InferredType]], @basic.Location)]
pub fn Checker::expression(Self, @ast.Instr[@basic.Location]) -> @ast.Instr[(Array[@infer.Cell[@infer.InferredType]], @basic.Location)]
pub fn Checker::gaps(Self) -> Array[(String, Int)]
pub fn Checker::new(@typing_env.ModuleContext, Operands) -> Self
pub fn Checker::statement(Self, @ast.Instr[@basic.Location]) -> @ast.Instr[(Array[@infer.Cell[@infer.InferredType]], @basic.Location)]
pub fn Checker::statements(Self, Array[@ast.Instr[@basic.Location]]) -> Array[@ast.Instr[(Array[@infer.Cell[@infer.InferredType]], @basic.Location)]]

pub struct MemArgs {
  positional : Array[@ast.Instr[@basic.Location]]
  labelled : Array[(@ast.Ident, @ast.Instr[@basic.Location])]
}

pub(all) enum MethodCall {
  Atomic(@atomics.Family)
  MemAccess
  SimdMemAccess
  MemManage
  TableManage
  SegmentDrop
  Ordinary
} derive(Eq)

pub(all) struct MissingBatch {
  mut hole_reported : Bool
  hole_actual : Int
  hole_expected : Int
}

pub struct Operands {
  mut stack : Stack
  missing_holes : Array[(@infer.Cell[@infer.InferredType], MissingBatch)]
}
pub fn Operands::new() -> Self
pub fn Operands::pop(Self, @type_store.SubtypingInfo, @diagnostic.Context, StackKind, @basic.Location, Int, Int, @infer.Cell[@infer.InferredType]) -> Unit
pub fn Operands::pop_any(Self, @ref.Ref[MissingBatch?], Int, Int) -> @infer.Cell[@infer.InferredType]
pub fn Operands::pop_args(Self, @type_store.SubtypingInfo, @diagnostic.Context, StackKind, @basic.Location, Array[@infer.Cell[@infer.InferredType]]) -> Unit
pub fn Operands::pop_many(Self, Int) -> (Array[@infer.Cell[@infer.InferredType]], MissingBatch?)
pub fn Operands::push(Self, @basic.Location?, @infer.Cell[@infer.InferredType]) -> Unit
pub fn Operands::push_results(Self, @basic.Location, Array[@infer.Cell[@infer.InferredType]]) -> Unit
pub fn Operands::set_unreachable(Self) -> Unit
pub fn[A] Operands::with_empty(Self, () -> A) -> (A, Stack)

pub(all) enum ResolvedVar {
  Local(@infer.InferredValType?, @basic.Location)
  Global(Bool, @infer.InferredValType?)
  FuncRef(@type_store.Id, String, Bool)
  Poisoned
  Unbound
}

pub(all) enum Stack {
  Unreachable
  Empty
  Poisoned
  Cons(@basic.Location?, @infer.Cell[@infer.InferredType], Stack)
}

pub(all) enum StackKind {
  Input
  Output
  Holes
} derive(Eq, @debug.Debug)

// Type aliases
pub type Supplied = (@infer.Cell[@infer.InferredType], @basic.Location)

pub type ValLub = (@infer.InferredValType, @infer.InferredValType) -> @infer.InferredValType?

// Traits
