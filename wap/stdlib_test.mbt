let collections_persistent_hash_map_wap : String =
  #|// A persistent hash map: the HAMT, ported from
  #|// `stdlib/collections/persistent_hash_map.wax`.
  #|//
  #|// The .wax original opens by explaining its own name:
  #|//
  #|//   This file is deliberately standalone and uses a phm_/phmt_ prefix because
  #|//   Wax modules do not have source namespaces.
  #|//
  #|// Here the module supplies the prefix and the names are `empty`, `assoc`,
  #|// `get`. The wasm export names keep the `phm_` spelling, because those are an
  #|// ABI rather than an identifier and a consumer already linking against them
  #|// should not have to change.
  #|//
  #|// Three other things read differently from the original, and all three are the
  #|// type saying what the operator had to say in Wax:
  #|//
  #|//   * A hash is `u32`, so `>>` is the logical shift and `<` is the unsigned
  #|//     comparison. The .wax file writes `>>u` and `<u` on an `i32`.
  #|//   * `||` is bitwise or on those, not logical: shrubbery's `|` introduces
  #|//     alternatives, so `||` carries both meanings and the operand type decides.
  #|//   * A predicate returns `bool`. Wax has no `bool`, so the original returns
  #|//     `i32` and compares it against 0 at every call site.
  #|//
  #|// This is the persistent half. The transient half of the .wax file -- `phmt_*`,
  #|// edit ownership, in-place mutation -- is a separate exercise and is not ported
  #|// here, so the `edit` field below is carried but never set.
  #|
  #|module persistent_hash_map
  #|
  #|type hash_fn = fn(eq) -> u32
  #|type equal_fn = fn(eq, eq) -> bool
  #|type visit = fn(eq?, eq?, eq?)
  #|
  #|type edit = { active :: mut i32 }
  #|type slots = [eq?]
  #|
  #|type node = { edit :: mut edit? }
  #|
  #|type bitmap_node :: node = {
  #|  bitmap :: mut u32,
  #|  slots :: mut slots,
  #|}
  #|
  #|type node_slots = [node?]
  #|
  #|type array_node :: node = {
  #|  count :: mut i32,
  #|  children :: mut node_slots,
  #|}
  #|
  #|type collision_node :: node = {
  #|  hash :: u32,
  #|  count :: mut i32,
  #|  slots :: mut slots,
  #|}
  #|
  #|pub type map = {
  #|  count :: i32,
  #|  root :: node?,
  #|  has_null :: bool,
  #|  null_value :: eq?,
  #|  hash :: hash_fn,
  #|  equal :: equal_fn,
  #|}
  #|
  #|fn bitpos(hash :: u32, shift :: u32) -> u32:
  #|  1 << ((hash >> shift) & 31)
  #|
  #|fn bitmap_index(bitmap :: u32, bit :: u32) -> i32:
  #|  (bitmap && (bit - 1)).popcnt()
  #|
  #|fn copy_slots(src :: slots, length :: i32) -> slots:
  #|  let dst = slots[null ** length]
  #|  let n = if src.len() < length | src.len() | length
  #|  if n != 0:
  #|    dst.copy(0, src, 0, n)
  #|  dst
  #|
  #|fn insert_pair(src :: slots, at :: i32, key :: eq?, value :: eq?) -> slots:
  #|  let n = src.len()
  #|  let dst = slots[null ** (n + 2)]
  #|  if at != 0:
  #|    dst.copy(0, src, 0, at)
  #|  dst[at] = key
  #|  dst[at + 1] = value
  #|  if at != n:
  #|    dst.copy(at + 2, src, at, n - at)
  #|  dst
  #|
  #|fn remove_pair(src :: slots, at :: i32) -> slots:
  #|  let n = src.len()
  #|  let dst = slots[null ** (n - 2)]
  #|  if at != 0:
  #|    dst.copy(0, src, 0, at)
  #|  if at + 2 != n:
  #|    dst.copy(at, src, at + 2, n - at - 2)
  #|  dst
  #|
  #|fn bitmap(owner :: edit?, bits :: u32, entries :: slots) -> node:
  #|  bitmap_node{edit: owner, bitmap: bits, slots: entries}
  #|
  #|fn array(owner :: edit?, count :: i32, children :: node_slots) -> node:
  #|  array_node{edit: owner, count: count, children: children}
  #|
  #|fn collision(owner :: edit?, hash :: u32, count :: i32, entries :: slots) -> node:
  #|  collision_node{edit: owner, hash: hash, count: count, slots: entries}
  #|
  #|fn singleton_at(shift :: u32, hash :: u32, key :: eq, value :: eq?) -> node:
  #|  bitmap(null, bitpos(hash, shift), slots[key, value])
  #|
  #|fn merge_two(
  #|  shift :: u32,
  #|  hash1 :: u32,
  #|  key1 :: eq,
  #|  value1 :: eq?,
  #|  hash2 :: u32,
  #|  key2 :: eq,
  #|  value2 :: eq?,
  #|) -> node:
  #|  if hash1 == hash2:
  #|    return collision(null, hash1, 2, slots[key1, value1, key2, value2])
  #|  let bit1 = bitpos(hash1, shift)
  #|  let bit2 = bitpos(hash2, shift)
  #|  if bit1 == bit2:
  #|    let child = merge_two(shift + 5, hash1, key1, value1, hash2, key2, value2)
  #|    return bitmap(null, bit1, slots[null, child])
  #|  if bit1 < bit2
  #|  | bitmap(null, bit1 || bit2, slots[key1, value1, key2, value2])
  #|  | bitmap(null, bit1 || bit2, slots[key2, value2, key1, value1])
  #|
  #|fn node_get(
  #|  n :: node,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  equal :: equal_fn,
  #|) -> (bool, eq?):
  #|  match n
  #|  | b :: bitmap_node:
  #|      let bit = bitpos(hash, shift)
  #|      if (b.bitmap && bit) == 0:
  #|        return (false, null)
  #|      let at = bitmap_index(b.bitmap, bit) * 2
  #|      let found_key = b.slots[at]
  #|      if found_key == null:
  #|        return node_get(b.slots[at + 1] as node, shift + 5, hash, key, equal)
  #|      if equal(found_key!, key):
  #|        return (true, b.slots[at + 1])
  #|      return (false, null)
  #|  | a :: array_node:
  #|      let child = a.children[(hash >> shift) & 31]
  #|      if child == null:
  #|        return (false, null)
  #|      return node_get(child!, shift + 5, hash, key, equal)
  #|  | c :: collision_node:
  #|      if c.hash != hash:
  #|        return (false, null)
  #|      for i in 0 ..< c.count:
  #|        let at = i * 2
  #|        if equal(c.slots[at]!, key):
  #|          return (true, c.slots[at + 1])
  #|      return (false, null)
  #|  | _: unreachable
  #|  unreachable
  #|
  #|// A bitmap node with sixteen entries becomes an array node: past that, the
  #|// packed representation costs more to copy than the sparse one costs to hold.
  #|fn promote(
  #|  n :: bitmap_node,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  value :: eq?,
  #|  hash_of :: hash_fn,
  #|) -> node:
  #|  let children = node_slots[null ** 32]
  #|  var slot = 0
  #|  for branch in 0 ..< 32:
  #|    let bit :: u32 = 1 << branch
  #|    if (n.bitmap && bit) != 0:
  #|      let old_key = n.slots[slot]
  #|      if old_key == null
  #|      | children[branch] = n.slots[slot + 1] as node
  #|      | children[branch] = singleton_at(
  #|          shift + 5,
  #|          hash_of(old_key!),
  #|          old_key!,
  #|          n.slots[slot + 1],
  #|        )
  #|      slot += 2
  #|  let index = (hash >> shift) & 31
  #|  children[index] = singleton_at(shift + 5, hash, key, value)
  #|  array(null, 17, children)
  #|
  #|fn node_assoc(
  #|  n :: node?,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  value :: eq?,
  #|  hash_of :: hash_fn,
  #|  equal :: equal_fn,
  #|) -> (node, i32):
  #|  if n == null:
  #|    return (singleton_at(shift, hash, key, value), 1)
  #|  match n!
  #|  | b :: bitmap_node:
  #|      let bit = bitpos(hash, shift)
  #|      let at = bitmap_index(b.bitmap, bit) * 2
  #|      if (b.bitmap && bit) == 0:
  #|        if b.bitmap.popcnt() >= 16:
  #|          return (promote(b, shift, hash, key, value, hash_of), 1)
  #|        return (bitmap(null, b.bitmap || bit, insert_pair(b.slots, at, key, value)), 1)
  #|      let old_key = b.slots[at]
  #|      if old_key == null:
  #|        let (child, added) = node_assoc(
  #|          b.slots[at + 1] as node,
  #|          shift + 5,
  #|          hash,
  #|          key,
  #|          value,
  #|          hash_of,
  #|          equal,
  #|        )
  #|        if child == b.slots[at + 1]:
  #|          return (b, added)
  #|        let entries = copy_slots(b.slots, b.slots.len())
  #|        entries[at + 1] = child
  #|        return (bitmap(null, b.bitmap, entries), added)
  #|      if equal(old_key!, key):
  #|        if b.slots[at + 1] == value:
  #|          return (b, 0)
  #|        let entries = copy_slots(b.slots, b.slots.len())
  #|        entries[at + 1] = value
  #|        return (bitmap(null, b.bitmap, entries), 0)
  #|      let child = merge_two(
  #|        shift + 5,
  #|        hash_of(old_key!),
  #|        old_key!,
  #|        b.slots[at + 1],
  #|        hash,
  #|        key,
  #|        value,
  #|      )
  #|      let entries = copy_slots(b.slots, b.slots.len())
  #|      entries[at] = null
  #|      entries[at + 1] = child
  #|      return (bitmap(null, b.bitmap, entries), 1)
  #|  | a :: array_node:
  #|      let index = (hash >> shift) & 31
  #|      let old = a.children[index]
  #|      let (child, added) = node_assoc(old, shift + 5, hash, key, value, hash_of, equal)
  #|      if old == child:
  #|        return (a, added)
  #|      let children = node_slots[null ** 32]
  #|      children.copy(0, a.children, 0, 32)
  #|      children[index] = child
  #|      let child_delta = if old == null | 1 | 0
  #|      return (array(null, a.count + child_delta, children), added)
  #|  | c :: collision_node:
  #|      if c.hash != hash:
  #|        let bit1 = bitpos(c.hash, shift)
  #|        let bit2 = bitpos(hash, shift)
  #|        if bit1 == bit2:
  #|          let (child, _) = node_assoc(c, shift + 5, hash, key, value, hash_of, equal)
  #|          return (bitmap(null, bit1, slots[null, child]), 1)
  #|        if bit1 < bit2:
  #|          return (bitmap(null, bit1 || bit2, slots[null, c, key, value]), 1)
  #|        return (bitmap(null, bit1 || bit2, slots[key, value, null, c]), 1)
  #|      for i in 0 ..< c.count:
  #|        let at = i * 2
  #|        if equal(c.slots[at]!, key):
  #|          if c.slots[at + 1] == value:
  #|            return (c, 0)
  #|          let entries = copy_slots(c.slots, c.slots.len())
  #|          entries[at + 1] = value
  #|          return (collision(null, hash, c.count, entries), 0)
  #|      return (
  #|        collision(null, hash, c.count + 1, insert_pair(c.slots, c.slots.len(), key, value)),
  #|        1,
  #|      )
  #|  | _: unreachable
  #|  unreachable
  #|
  #|// An array node that has shrunk back below nine children becomes a bitmap node
  #|// again, so a map that grew and shrank does not keep paying for the wide one.
  #|fn pack_array(n :: array_node, removed_index :: i32) -> node?:
  #|  var bits :: u32 = 0
  #|  let entries = slots[null ** ((n.count - 1) * 2)]
  #|  var out = 0
  #|  for i in 0 ..< 32:
  #|    let child = n.children[i]
  #|    if i != removed_index:
  #|      if child != null:
  #|        bits ||= 1 << i
  #|        entries[out] = null
  #|        entries[out + 1] = child
  #|        out += 2
  #|  if bits == 0:
  #|    return null
  #|  bitmap(null, bits, entries)
  #|
  #|fn node_dissoc(
  #|  n :: node,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  equal :: equal_fn,
  #|) -> (node?, bool):
  #|  match n
  #|  | b :: bitmap_node:
  #|      let bit = bitpos(hash, shift)
  #|      if (b.bitmap && bit) == 0:
  #|        return (b, false)
  #|      let at = bitmap_index(b.bitmap, bit) * 2
  #|      let old_key = b.slots[at]
  #|      if old_key == null:
  #|        let (child, removed) = node_dissoc(
  #|          b.slots[at + 1] as node,
  #|          shift + 5,
  #|          hash,
  #|          key,
  #|          equal,
  #|        )
  #|        if !removed:
  #|          return (b, false)
  #|        if child == null:
  #|          if b.bitmap == bit:
  #|            return (null, true)
  #|          return (bitmap(null, b.bitmap ^ bit, remove_pair(b.slots, at)), true)
  #|        let entries = copy_slots(b.slots, b.slots.len())
  #|        entries[at + 1] = child
  #|        return (bitmap(null, b.bitmap, entries), true)
  #|      if !equal(old_key!, key):
  #|        return (b, false)
  #|      if b.bitmap == bit:
  #|        return (null, true)
  #|      return (bitmap(null, b.bitmap ^ bit, remove_pair(b.slots, at)), true)
  #|  | a :: array_node:
  #|      let index = (hash >> shift) & 31
  #|      let old = a.children[index]
  #|      if old == null:
  #|        return (a, false)
  #|      let (child, removed) = node_dissoc(old!, shift + 5, hash, key, equal)
  #|      if !removed:
  #|        return (a, false)
  #|      if child == null:
  #|        if a.count <= 9:
  #|          return (pack_array(a, index), true)
  #|      let children = node_slots[null ** 32]
  #|      children.copy(0, a.children, 0, 32)
  #|      children[index] = child
  #|      let delta = if child == null | 1 | 0
  #|      return (array(null, a.count - delta, children), true)
  #|  | c :: collision_node:
  #|      if c.hash != hash:
  #|        return (c, false)
  #|      for i in 0 ..< c.count:
  #|        let at = i * 2
  #|        if equal(c.slots[at]!, key):
  #|          if c.count == 1:
  #|            return (null, true)
  #|          if c.count == 2:
  #|            let keep = if at == 0 | 2 | 0
  #|            return (singleton_at(shift, hash, c.slots[keep]!, c.slots[keep + 1]), true)
  #|          return (collision(null, hash, c.count - 1, remove_pair(c.slots, at)), true)
  #|      return (c, false)
  #|  | _: unreachable
  #|  unreachable
  #|
  #|fn node_each(n :: node, context :: eq?, seen :: visit):
  #|  match n
  #|  | b :: bitmap_node:
  #|      var i = 0
  #|      while i < b.slots.len() by 2:
  #|        let key = b.slots[i]
  #|        if key == null
  #|        | node_each(b.slots[i + 1] as node, context, seen)
  #|        | seen(context, key, b.slots[i + 1])
  #|      return
  #|  | a :: array_node:
  #|      for i in 0 ..< 32:
  #|        if a.children[i] != null:
  #|          node_each(a.children[i]!, context, seen)
  #|      return
  #|  | c :: collision_node:
  #|      for i in 0 ..< c.count:
  #|        seen(context, c.slots[i * 2], c.slots[i * 2 + 1])
  #|      return
  #|  | _: unreachable
  #|
  #|export "phm_empty" pub fn empty(hash :: hash_fn, equal :: equal_fn) -> map:
  #|  map{count: 0, root: null, has_null: false, null_value: null, hash: hash, equal: equal}
  #|
  #|export "phm_count" pub fn count(m :: map) -> i32:
  #|  m.count
  #|
  #|export "phm_get" pub fn get(m :: map, key :: eq?) -> (bool, eq?):
  #|  if key == null:
  #|    return (m.has_null, m.null_value)
  #|  if m.root == null:
  #|    return (false, null)
  #|  node_get(m.root!, 0, m.hash(key!), key!, m.equal)
  #|
  #|export "phm_contains" pub fn contains(m :: map, key :: eq?) -> bool:
  #|  let (found, _) = get(m, key)
  #|  found
  #|
  #|export "phm_assoc" pub fn assoc(m :: map, key :: eq?, value :: eq?) -> map:
  #|  if key == null:
  #|    if m.has_null:
  #|      if m.null_value == value:
  #|        return m
  #|    let grew = if m.has_null | 0 | 1
  #|    return map{
  #|      count: m.count + grew,
  #|      root: m.root,
  #|      has_null: true,
  #|      null_value: value,
  #|      hash: m.hash,
  #|      equal: m.equal,
  #|    }
  #|  if m.count == 0x7fffffff:
  #|    unreachable
  #|  let (root, added) = node_assoc(m.root, 0, m.hash(key!), key!, value, m.hash, m.equal)
  #|  if root == m.root:
  #|    return m
  #|  map{
  #|    count: m.count + added,
  #|    root: root,
  #|    has_null: m.has_null,
  #|    null_value: m.null_value,
  #|    hash: m.hash,
  #|    equal: m.equal,
  #|  }
  #|
  #|export "phm_dissoc" pub fn dissoc(m :: map, key :: eq?) -> map:
  #|  if key == null:
  #|    if !m.has_null:
  #|      return m
  #|    return map{
  #|      count: m.count - 1,
  #|      root: m.root,
  #|      has_null: false,
  #|      null_value: null,
  #|      hash: m.hash,
  #|      equal: m.equal,
  #|    }
  #|  if m.root == null:
  #|    return m
  #|  let (root, removed) = node_dissoc(m.root!, 0, m.hash(key!), key!, m.equal)
  #|  if !removed:
  #|    return m
  #|  map{
  #|    count: m.count - 1,
  #|    root: root,
  #|    has_null: m.has_null,
  #|    null_value: m.null_value,
  #|    hash: m.hash,
  #|    equal: m.equal,
  #|  }
  #|
  #|export "phm_each" pub fn each(m :: map, context :: eq?, seen :: visit):
  #|  if m.has_null:
  #|    seen(context, null, m.null_value)
  #|  if m.root != null:
  #|    node_each(m.root!, context, seen)

///|
let collections_persistent_hash_set_wap : String =
  #|// A persistent hash set, ported from
  #|// `stdlib/collections/persistent_hash_set.wax`.
  #|//
  #|// The .wax file has to be concatenated after `persistent_hash_map.wax` and
  #|// takes its prefix, `phs_`, to stay out of the map's way. Here it says
  #|// `import collections.persistent_hash_map` and the compiler keeps them apart,
  #|// which is the whole point of the exercise: this is the first module in the
  #|// ported stdlib that depends on another one.
  #|//
  #|// The set is the map with a marker for a value, so everything about hashing,
  #|// equality, structural sharing and null keys is the map's. Only the transient
  #|// half is missing, because the map's is -- see the note there.
  #|
  #|module persistent_hash_set
  #|
  #|import collections.persistent_hash_map
  #|
  #|type visit = fn(eq?, eq?)
  #|
  #|pub type set = { map :: persistent_hash_map.map }
  #|
  #|type each_context = {
  #|  context :: eq?,
  #|  visit :: visit,
  #|}
  #|
  #|fn each_entry(context :: eq?, key :: eq?, value :: eq?):
  #|  let state = context! as each_context
  #|  state.visit(state.context, key)
  #|
  #|export "phs_empty" pub fn empty(
  #|  hash :: persistent_hash_map.hash_fn,
  #|  equal :: persistent_hash_map.equal_fn,
  #|) -> set:
  #|  set{map: persistent_hash_map.empty(hash, equal)}
  #|
  #|export "phs_count" pub fn count(s :: set) -> i32:
  #|  persistent_hash_map.count(s.map)
  #|
  #|export "phs_contains" pub fn contains(s :: set, value :: eq?) -> bool:
  #|  persistent_hash_map.contains(s.map, value)
  #|
  #|export "phs_add" pub fn add(s :: set, value :: eq?) -> set:
  #|  let m = persistent_hash_map.assoc(s.map, value, 0 as i31)
  #|  if m == s.map:
  #|    return s
  #|  set{map: m}
  #|
  #|export "phs_remove" pub fn remove(s :: set, value :: eq?) -> set:
  #|  let m = persistent_hash_map.dissoc(s.map, value)
  #|  if m == s.map:
  #|    return s
  #|  set{map: m}
  #|
  #|export "phs_each" pub fn each(s :: set, context :: eq?, seen :: visit):
  #|  let state = each_context{context: context, visit: seen}
  #|  persistent_hash_map.each(s.map, state, each_entry)
  #|
  #|type union_context = { out :: mut set }
  #|
  #|fn union_add(context :: eq?, value :: eq?):
  #|  let state = context! as union_context
  #|  state.out = add(state.out, value)
  #|
  #|export "phs_union" pub fn union(left :: set, right :: set) -> set:
  #|  let state = union_context{out: left}
  #|  each(right, state, union_add)
  #|  state.out
  #|
  #|// Intersection and difference are the same walk with the answer inverted, so
  #|// they share a context and differ only in which way `keep_present` points.
  #|type filter_context = {
  #|  other :: set,
  #|  out :: mut set,
  #|  keep_present :: bool,
  #|}
  #|
  #|fn filter_add(context :: eq?, value :: eq?):
  #|  let state = context! as filter_context
  #|  if contains(state.other, value) == state.keep_present:
  #|    state.out = add(state.out, value)
  #|
  #|export "phs_intersection" pub fn intersection(left :: set, right :: set) -> set:
  #|  let state = filter_context{
  #|    other: right,
  #|    out: empty(left.map.hash, left.map.equal),
  #|    keep_present: true,
  #|  }
  #|  each(left, state, filter_add)
  #|  state.out
  #|
  #|export "phs_difference" pub fn difference(left :: set, right :: set) -> set:
  #|  let state = filter_context{
  #|    other: right,
  #|    out: empty(left.map.hash, left.map.equal),
  #|    keep_present: false,
  #|  }
  #|  each(left, state, filter_add)
  #|  state.out

///|
let collections_persistent_vector_wap : String =
  #|// A persistent vector: the bit-partitioned trie, ported from
  #|// `stdlib/collections/persistent_vector.wax`.
  #|//
  #|// The .wax original opens with this comment:
  #|//
  #|//   All names use pv_/pvt_ prefixes because Wax has no source namespaces.
  #|//
  #|// That is the whole difference. Here the names are `node`, `empty`, `push`;
  #|// the module supplies the prefix, and the emitted wasm calls them
  #|// `persistent_vector__node`, `persistent_vector__empty` and so on. Nothing
  #|// else about the data structure changed.
  #|//
  #|// This is the persistent half. The transient half of the .wax file is a
  #|// separate exercise and is not ported here.
  #|
  #|module persistent_vector
  #|
  #|const branching = 32
  #|const shift_bits = 5
  #|const mask = 31
  #|
  #|type visit = fn(eq?, i32, eq?)
  #|type edit = { active :: mut i32 }
  #|type slots = [eq?]
  #|
  #|type node = {
  #|  edit :: mut edit?,
  #|  slots :: mut slots,
  #|}
  #|
  #|pub type vector = {
  #|  count :: i32,
  #|  shift :: i32,
  #|  root :: node,
  #|  tail :: slots,
  #|}
  #|
  #|fn node_new(owner :: edit?) -> node:
  #|  node{edit: owner, slots: slots[null ** branching]}
  #|
  #|fn copy_slots(src :: slots, length :: i32) -> slots:
  #|  let dst = slots[null ** length]
  #|  let n = if src.len() < length | src.len() | length
  #|  if n != 0:
  #|    dst.copy(0, src, 0, n)
  #|  dst
  #|
  #|fn node_copy(n :: node) -> node:
  #|  node{edit: null, slots: copy_slots(n.slots, branching)}
  #|
  #|fn tail_offset(count :: i32) -> i32:
  #|  if count < branching:
  #|    return 0
  #|  ((count - 1) >> shift_bits) << shift_bits
  #|
  #|fn new_path(level :: i32, n :: node) -> node:
  #|  if level == 0:
  #|    return n
  #|  let parent = node_new(null)
  #|  parent.slots[0] = new_path(level - shift_bits, n)
  #|  parent
  #|
  #|fn push_tail(level :: i32, parent :: node, tail_node :: node, index :: i32) -> node:
  #|  let out = node_copy(parent)
  #|  let subidx = (index >> level) & mask
  #|  if level == shift_bits:
  #|    out.slots[subidx] = tail_node
  #|    return out
  #|  let child = parent.slots[subidx]
  #|  if child == null
  #|  | out.slots[subidx] = new_path(level - shift_bits, tail_node)
  #|  | out.slots[subidx] = push_tail(level - shift_bits, child as node, tail_node, index)
  #|  out
  #|
  #|fn do_assoc(level :: i32, n :: node, index :: i32, value :: eq?) -> node:
  #|  let out = node_copy(n)
  #|  if level == 0:
  #|    out.slots[index & mask] = value
  #|    return out
  #|  let subidx = (index >> level) & mask
  #|  out.slots[subidx] = do_assoc(level - shift_bits, n.slots[subidx] as node, index, value)
  #|  out
  #|
  #|fn array_for(v :: vector, index :: i32) -> slots:
  #|  if index < 0:
  #|    unreachable
  #|  if index >= v.count:
  #|    unreachable
  #|  if index >= tail_offset(v.count):
  #|    return v.tail
  #|  var n = v.root
  #|  var level = v.shift
  #|  while level > 0:
  #|    n = n.slots[(index >> level) & mask] as node
  #|    level -= shift_bits
  #|  n.slots
  #|
  #|fn pop_tail(level :: i32, n :: node, index :: i32) -> node?:
  #|  let subidx = (index >> level) & mask
  #|  if level > shift_bits:
  #|    let child = pop_tail(level - shift_bits, n.slots[subidx] as node, index)
  #|    if child == null:
  #|      if subidx == 0:
  #|        return null
  #|    let out = node_copy(n)
  #|    out.slots[subidx] = child
  #|    return out
  #|  if subidx == 0:
  #|    return null
  #|  let out = node_copy(n)
  #|  out.slots[subidx] = null
  #|  out
  #|
  #|export "pv_empty" pub fn empty() -> vector:
  #|  vector{count: 0, shift: shift_bits, root: node_new(null), tail: slots[null ** 0]}
  #|
  #|export "pv_count" pub fn count(v :: vector) -> i32:
  #|  v.count
  #|
  #|fn get(v :: vector, index :: i32) -> (i32, eq?):
  #|  if index < 0:
  #|    return (0, null)
  #|  if index >= v.count:
  #|    return (0, null)
  #|  let found = array_for(v, index)
  #|  (1, found[index & mask])
  #|
  #|export "pv_at" pub fn at(v :: vector, index :: i32) -> eq?:
  #|  let (ok, value) = get(v, index)
  #|  if ok == 0:
  #|    unreachable
  #|  value
  #|
  #|export "pv_push" pub fn push(v :: vector, value :: eq?) -> vector:
  #|  if v.count == 0x7fffffff:
  #|    unreachable
  #|  if v.tail.len() < branching:
  #|    let grown_tail = copy_slots(v.tail, v.tail.len() + 1)
  #|    grown_tail[v.tail.len()] = value
  #|    return vector{
  #|      count: v.count + 1,
  #|      shift: v.shift,
  #|      root: v.root,
  #|      tail: grown_tail,
  #|    }
  #|  let tail_node = node{edit: null, slots: v.tail}
  #|  var shift = v.shift
  #|  var root = v.root
  #|  if (v.count >> shift_bits) > (1 << shift)
  #|  | let grown = node_new(null)
  #|    grown.slots[0] = v.root
  #|    grown.slots[1] = new_path(shift, tail_node)
  #|    shift += shift_bits
  #|    root = grown
  #|  | root = push_tail(shift, v.root, tail_node, v.count - 1)
  #|  vector{count: v.count + 1, shift: shift, root: root, tail: slots[value]}
  #|
  #|export "pv_assoc" pub fn assoc(v :: vector, index :: i32, value :: eq?) -> vector:
  #|  if index == v.count:
  #|    return push(v, value)
  #|  if index < 0:
  #|    unreachable
  #|  if index >= v.count:
  #|    unreachable
  #|  let offset = tail_offset(v.count)
  #|  if index >= offset:
  #|    if v.tail[index & mask] == value:
  #|      return v
  #|    let updated = copy_slots(v.tail, v.tail.len())
  #|    updated[index & mask] = value
  #|    return vector{
  #|      count: v.count,
  #|      shift: v.shift,
  #|      root: v.root,
  #|      tail: updated,
  #|    }
  #|  vector{
  #|    count: v.count,
  #|    shift: v.shift,
  #|    root: do_assoc(v.shift, v.root, index, value),
  #|    tail: v.tail,
  #|  }
  #|
  #|fn peek(v :: vector) -> (i32, eq?):
  #|  if v.count == 0:
  #|    return (0, null)
  #|  (1, v.tail[v.tail.len() - 1])
  #|
  #|export "pv_pop" pub fn pop(v :: vector) -> vector:
  #|  if v.count == 0:
  #|    unreachable
  #|  if v.count == 1:
  #|    return empty()
  #|  if v.tail.len() > 1:
  #|    return vector{
  #|      count: v.count - 1,
  #|      shift: v.shift,
  #|      root: v.root,
  #|      tail: copy_slots(v.tail, v.tail.len() - 1),
  #|    }
  #|  let new_tail = array_for(v, v.count - 2)
  #|  let shrunk = pop_tail(v.shift, v.root, v.count - 2)
  #|  var root = if shrunk == null | node_new(null) | shrunk!
  #|  var shift = v.shift
  #|  if shift > shift_bits:
  #|    if root.slots[1] == null:
  #|      root = root.slots[0] as node
  #|      shift -= shift_bits
  #|  vector{count: v.count - 1, shift: shift, root: root, tail: new_tail}
  #|
  #|export "pv_each" pub fn each(v :: vector, context :: eq?, seen :: visit):
  #|  for i in 0 ..< v.count:
  #|    seen(context, i, at(v, i))

///|
let text_utf8_wap : String =
  #|// Owned UTF-8 strings, ported from `stdlib/text/utf8.wax`.
  #|//
  #|// Construction validates and copies. The copy is not a policy choice: a
  #|// WebAssembly GC array cannot be filled dynamically once it is declared
  #|// immutable, so the type owns a mutable byte array and never lets it out. The
  #|// .wax file says to treat `storage_internal` as opaque after vendoring; here
  #|// the module says it, because a field of a `pub type` is still only reachable
  #|// through this module's own functions.
  #|//
  #|// One shape from the original could not be carried over. Wax has labelled
  #|// blocks, and the validator uses one as a `switch`:
  #|//
  #|//     'unit: do {
  #|//       if first <=u 0x7f { i += 1; br 'unit; }
  #|//       ...
  #|//     }
  #|//
  #|// wap has labelled `break` and `continue` but no labelled block, so each of
  #|// those becomes an arm of a multi-arm `if`, which is what the block was
  #|// standing in for. The arms are in the same order and the bounds are the same
  #|// ones -- Unicode Table 3-7's well-formed byte ranges.
  #|
  #|module utf8
  #|
  #|import collections.hashing
  #|
  #|type visit = fn(eq?, i32, i32, u32)
  #|
  #|pub type string = {
  #|  storage_internal :: hashing.bytes,
  #|  byte_length :: i32,
  #|  codepoint_length :: i32,
  #|  hash :: u32,
  #|}
  #|
  #|fn continuation(byte :: u32) -> bool:
  #|  if byte < 0x80:
  #|    return false
  #|  if byte > 0xbf:
  #|    return false
  #|  true
  #|
  #|// The answer is `(well_formed, codepoints)`: one pass decides both, and a
  #|// caller that has already validated does not pay for a second walk.
  #|fn validate(data :: hashing.bytes) -> (bool, i32):
  #|  var i = 0
  #|  var count = 0
  #|  let length = data.len()
  #|  while i < length:
  #|    let first :: u32 = data[i]
  #|    if
  #|    | first <= 0x7f:
  #|        i += 1
  #|    | first <= 0xc1:
  #|        return (false, 0)
  #|    | first <= 0xdf:
  #|        if i + 1 >= length:
  #|          return (false, 0)
  #|        if !continuation(data[i + 1]):
  #|          return (false, 0)
  #|        i += 2
  #|    | first <= 0xef:
  #|        if i + 2 >= length:
  #|          return (false, 0)
  #|        let second :: u32 = data[i + 1]
  #|        if !continuation(second):
  #|          return (false, 0)
  #|        if !continuation(data[i + 2]):
  #|          return (false, 0)
  #|        if first == 0xe0:
  #|          if second < 0xa0:
  #|            return (false, 0)
  #|        if first == 0xed:
  #|          if second > 0x9f:
  #|            return (false, 0)
  #|        i += 3
  #|    | first <= 0xf4:
  #|        if i + 3 >= length:
  #|          return (false, 0)
  #|        let second :: u32 = data[i + 1]
  #|        if !continuation(second):
  #|          return (false, 0)
  #|        if !continuation(data[i + 2]):
  #|          return (false, 0)
  #|        if !continuation(data[i + 3]):
  #|          return (false, 0)
  #|        if first == 0xf0:
  #|          if second < 0x90:
  #|            return (false, 0)
  #|        if first == 0xf4:
  #|          if second > 0x8f:
  #|            return (false, 0)
  #|        i += 4
  #|    | _:
  #|        return (false, 0)
  #|    count += 1
  #|  (true, count)
  #|
  #|fn copy_storage(data :: hashing.bytes, start :: i32, length :: i32) -> hashing.bytes:
  #|  let out = hashing.bytes_new(length)
  #|  if length != 0:
  #|    out.copy(0, data, start, length)
  #|  out
  #|
  #|fn new_valid(data :: hashing.bytes, codepoints :: i32) -> string:
  #|  let owned = copy_storage(data, 0, data.len())
  #|  string{
  #|    storage_internal: owned,
  #|    byte_length: owned.len(),
  #|    codepoint_length: codepoints,
  #|    hash: hashing.bytes_value(owned),
  #|  }
  #|
  #|export "utf8_try_from_bytes" pub fn try_from_bytes(data :: hashing.bytes) -> (bool, string?):
  #|  let (valid, codepoints) = validate(data)
  #|  if !valid:
  #|    return (false, null)
  #|  (true, new_valid(data, codepoints))
  #|
  #|export "utf8_from_bytes" pub fn from_bytes(data :: hashing.bytes) -> string:
  #|  let (valid, value) = try_from_bytes(data)
  #|  if !valid:
  #|    unreachable
  #|  value!
  #|
  #|export "utf8_empty" pub fn empty() -> string:
  #|  new_valid(hashing.bytes_new(0), 0)
  #|
  #|export "utf8_copy_bytes" pub fn copy_bytes(value :: string) -> hashing.bytes:
  #|  copy_storage(value.storage_internal, 0, value.byte_length)
  #|
  #|export "utf8_byte_length" pub fn byte_length(value :: string) -> i32:
  #|  value.byte_length
  #|
  #|export "utf8_codepoint_length" pub fn codepoint_length(value :: string) -> i32:
  #|  value.codepoint_length
  #|
  #|export "utf8_is_empty" pub fn is_empty(value :: string) -> bool:
  #|  value.byte_length == 0
  #|
  #|export "utf8_get_byte" pub fn get_byte(value :: string, index :: i32) -> (bool, u32):
  #|  if index < 0:
  #|    return (false, 0)
  #|  if index >= value.byte_length:
  #|    return (false, 0)
  #|  (true, value.storage_internal[index])
  #|
  #|export "utf8_at_byte" pub fn at_byte(value :: string, index :: i32) -> u32:
  #|  let (found, byte) = get_byte(value, index)
  #|  if !found:
  #|    unreachable
  #|  byte
  #|
  #|// The hash is cached, so an inequality is usually one comparison. It is
  #|// MurmurHash3 and not cryptographic.
  #|export "utf8_equal" pub fn equal(left :: string, right :: string) -> bool:
  #|  if left == right:
  #|    return true
  #|  if left.hash != right.hash:
  #|    return false
  #|  if left.byte_length != right.byte_length:
  #|    return false
  #|  for i in 0 ..< left.byte_length:
  #|    if left.storage_internal[i] != right.storage_internal[i]:
  #|      return false
  #|  true
  #|
  #|export "utf8_compare" pub fn compare(left :: string, right :: string) -> i32:
  #|  let length = if left.byte_length < right.byte_length
  #|  | left.byte_length
  #|  | right.byte_length
  #|  for i in 0 ..< length:
  #|    let a :: u32 = left.storage_internal[i]
  #|    let b :: u32 = right.storage_internal[i]
  #|    if a < b:
  #|      return -1
  #|    if a > b:
  #|      return 1
  #|  if left.byte_length < right.byte_length:
  #|    return -1
  #|  if left.byte_length > right.byte_length:
  #|    return 1
  #|  0
  #|
  #|export "utf8_hash" pub fn hash(value :: string) -> u32:
  #|  value.hash
  #|
  #|pub fn hash_key(key :: eq) -> u32:
  #|  hash(key as string)
  #|
  #|pub fn equal_key(left :: eq, right :: eq) -> bool:
  #|  equal(left as string, right as string)
  #|
  #|export "utf8_concat" pub fn concat(left :: string, right :: string) -> string:
  #|  if left.byte_length == 0:
  #|    return right
  #|  if right.byte_length == 0:
  #|    return left
  #|  if left.byte_length > 0x7fffffff - right.byte_length:
  #|    unreachable
  #|  let length = left.byte_length + right.byte_length
  #|  let storage = hashing.bytes_new(length)
  #|  storage.copy(0, left.storage_internal, 0, left.byte_length)
  #|  storage.copy(left.byte_length, right.storage_internal, 0, right.byte_length)
  #|  string{
  #|    storage_internal: storage,
  #|    byte_length: length,
  #|    codepoint_length: left.codepoint_length + right.codepoint_length,
  #|    hash: hashing.bytes_value(storage),
  #|  }
  #|
  #|// A slice is taken in bytes but refuses to cut a code point in half, so an
  #|// offset has to land on a boundary at both ends.
  #|export "utf8_is_boundary" pub fn is_boundary(value :: string, offset :: i32) -> bool:
  #|  if offset < 0:
  #|    return false
  #|  if offset > value.byte_length:
  #|    return false
  #|  if offset == 0:
  #|    return true
  #|  if offset == value.byte_length:
  #|    return true
  #|  !continuation(value.storage_internal[offset])
  #|
  #|export "utf8_try_slice_bytes" pub fn try_slice_bytes(
  #|  value :: string,
  #|  start :: i32,
  #|  length :: i32,
  #|) -> (bool, string?):
  #|  if start < 0:
  #|    return (false, null)
  #|  if length < 0:
  #|    return (false, null)
  #|  if start > value.byte_length:
  #|    return (false, null)
  #|  if length > value.byte_length - start:
  #|    return (false, null)
  #|  let end = start + length
  #|  if !is_boundary(value, start):
  #|    return (false, null)
  #|  if !is_boundary(value, end):
  #|    return (false, null)
  #|  if start == 0:
  #|    if length == value.byte_length:
  #|      return (true, value)
  #|  let storage = copy_storage(value.storage_internal, start, length)
  #|  let (_, codepoints) = validate(storage)
  #|  (true, new_valid(storage, codepoints))
  #|
  #|export "utf8_slice_bytes" pub fn slice_bytes(
  #|  value :: string,
  #|  start :: i32,
  #|  length :: i32,
  #|) -> string:
  #|  let (valid, slice) = try_slice_bytes(value, start, length)
  #|  if !valid:
  #|    unreachable
  #|  slice!
  #|
  #|export "utf8_each_codepoint" pub fn each_codepoint(
  #|  value :: string,
  #|  context :: eq?,
  #|  seen :: visit,
  #|):
  #|  var offset = 0
  #|  var index = 0
  #|  while offset < value.byte_length:
  #|    let first :: u32 = value.storage_internal[offset]
  #|    var scalar :: u32 = 0
  #|    var width = 0
  #|    if
  #|    | first <= 0x7f:
  #|        scalar = first
  #|        width = 1
  #|    | first <= 0xdf:
  #|        scalar = (first & 0x1f) << 6 || (value.storage_internal[offset + 1] & 0x3f)
  #|        width = 2
  #|    | first <= 0xef:
  #|        scalar = (first & 0x0f) << 12
  #|          || (value.storage_internal[offset + 1] & 0x3f) << 6
  #|          || (value.storage_internal[offset + 2] & 0x3f)
  #|        width = 3
  #|    | _:
  #|        scalar = (first & 0x07) << 18
  #|          || (value.storage_internal[offset + 1] & 0x3f) << 12
  #|          || (value.storage_internal[offset + 2] & 0x3f) << 6
  #|          || (value.storage_internal[offset + 3] & 0x3f)
  #|        width = 4
  #|    seen(context, index, offset, scalar)
  #|    offset += width
  #|    index += 1

///|
/// Every ported module, under the path its importers name it by.
fn stdlib_loader() -> @resolve.MapLoader {
  @resolve.MapLoader::new(entries=[
    ("collections.example", collections_example_wap),
    ("collections.hashing", collections_hashing_wap),
    ("collections.persistent_hash_map", collections_persistent_hash_map_wap),
    ("collections.persistent_hash_set", collections_persistent_hash_set_wap),
    ("collections.persistent_vector", collections_persistent_vector_wap),
    ("text.utf8", text_utf8_wap),
  ])
}

///|
/// Compile one module, and everything it imports, to wat.
fn stdlib_wat(path : String, src : String) -> String raise @compile.CompileError {
  match @wap.compile_program_to_wat(path, src, stdlib_loader()) {
    Ok(w) => w
    Err(d) => {
      let sb = StringBuilder()
      for r in d.wap {
        sb.write_string("wap: " + r.message + "\n")
      }
      let sink = @diagnostic.buffer_sink(sb)
      let theme = @diagnostic.get_theme(is_tty=false)
      for r in d.wax {
        @diagnostic.output_error(sink, theme, Human, Some(src), r)
      }
      "FAILED\n" + sb.to_string()
    }
  }
}

///|
test "the collections.example stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.example", collections_example_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.example did not compile")
  }
  assert_true(w.contains("\"collections_example\""))
}

///|
test "the collections.hashing stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.hashing", collections_hashing_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.hashing did not compile")
  }
  // The module supplies the prefix the .wax file writes by hand.
  assert_true(w.contains("$hashing__mix_i32"))
  // `u32` chose the logical shift with no `>>u` in the source.
  assert_true(w.contains("i32.shr_u"))
  assert_true(w.contains("i32.rotl"))
  assert_true(w.contains("array.get_u"))
}

///|
test "the collections.persistent_hash_map stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.persistent_hash_map", collections_persistent_hash_map_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.persistent_hash_map did not compile")
  }
  assert_true(w.contains("$persistent_hash_map__node_assoc"))
  assert_true(w.contains("i32.popcnt"))
  // A callback reaches `each` without a cast; see the rec-group tests.
  assert_true(!w.contains("ref.cast (ref $persistent_hash_map__visit)"))
}

///|
test "the collections.persistent_hash_set stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.persistent_hash_set", collections_persistent_hash_set_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.persistent_hash_set did not compile")
  }
  // The set reaches the map by name rather than by concatenation.
  assert_true(w.contains("$persistent_hash_set__union"))
  assert_true(w.contains("$persistent_hash_map__assoc"))
}

///|
test "the collections.persistent_vector stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.persistent_vector", collections_persistent_vector_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.persistent_vector did not compile")
  }
  assert_true(w.contains("$persistent_vector__push"))
  // The wasm export name is an ABI and is left alone.
  assert_true(w.contains("\"pv_empty\""))
}

///|
test "the text.utf8 stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("text.utf8", text_utf8_wap)
  if w.contains("FAILED") {
    println(w)
    fail("text.utf8 did not compile")
  }
  assert_true(w.contains("$utf8__validate"))
  // The hash is the one from `collections.hashing`, not a copy of it.
  assert_true(w.contains("$hashing__bytes_value"))
}
