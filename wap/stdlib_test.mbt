let collections_persistent_hash_map_wap : String =
  #|// A persistent hash map: the HAMT, ported from
  #|// `stdlib/collections/persistent_hash_map.wax`.
  #|//
  #|// The .wax original opens by explaining its own name:
  #|//
  #|//   This file is deliberately standalone and uses a phm_/phmt_ prefix because
  #|//   Wax modules do not have source namespaces.
  #|//
  #|// Here the module supplies the prefix and the names are `empty`, `assoc`,
  #|// `get`. The wasm export names keep the `phm_` spelling, because those are an
  #|// ABI rather than an identifier and a consumer already linking against them
  #|// should not have to change.
  #|//
  #|// Three other things read differently from the original, and all three are the
  #|// type saying what the operator had to say in Wax:
  #|//
  #|//   * A hash is `u32`, so `>>` is the logical shift and `<` is the unsigned
  #|//     comparison. The .wax file writes `>>u` and `<u` on an `i32`.
  #|//   * `||` is bitwise or on those, not logical: shrubbery's `|` introduces
  #|//     alternatives, so `||` carries both meanings and the operand type decides.
  #|//   * A predicate returns `bool`. Wax has no `bool`, so the original returns
  #|//     `i32` and compares it against 0 at every call site.
  #|//
  #|// The transient half is here too. It is the same HAMT with the copying turned
  #|// off: a builder owns an `edit` token, a node that already carries that token
  #|// is written in place rather than copied, and `persistent` clears the token so
  #|// that a builder used after freezing traps instead of writing into the value it
  #|// handed out.
  #|
  #|module persistent_hash_map
  #|
  #|type hash_fn = fn(eq) -> u32
  #|type equal_fn = fn(eq, eq) -> bool
  #|type visit = fn(eq?, eq?, eq?)
  #|
  #|type edit = { active :: mut i32 }
  #|type slots = [eq?]
  #|
  #|type node = { edit :: mut edit? }
  #|
  #|type bitmap_node :: node = {
  #|  bitmap :: mut u32,
  #|  slots :: mut slots,
  #|}
  #|
  #|type node_slots = [node?]
  #|
  #|type array_node :: node = {
  #|  count :: mut i32,
  #|  children :: mut node_slots,
  #|}
  #|
  #|type collision_node :: node = {
  #|  hash :: u32,
  #|  count :: mut i32,
  #|  slots :: mut slots,
  #|}
  #|
  #|pub type map = {
  #|  count :: i32,
  #|  root :: node?,
  #|  has_null :: bool,
  #|  null_value :: eq?,
  #|  hash :: hash_fn,
  #|  equal :: equal_fn,
  #|}
  #|
  #|fn bitpos(hash :: u32, shift :: u32) -> u32:
  #|  1 << ((hash >> shift) & 31)
  #|
  #|fn bitmap_index(bitmap :: u32, bit :: u32) -> i32:
  #|  (bitmap && (bit - 1)).popcnt()
  #|
  #|fn copy_slots(src :: slots, length :: i32) -> slots:
  #|  let dst = slots[null ** length]
  #|  let n = if src.len() < length | src.len() | length
  #|  if n != 0:
  #|    dst.copy(0, src, 0, n)
  #|  dst
  #|
  #|fn insert_pair(src :: slots, at :: i32, key :: eq?, value :: eq?) -> slots:
  #|  let n = src.len()
  #|  let dst = slots[null ** (n + 2)]
  #|  if at != 0:
  #|    dst.copy(0, src, 0, at)
  #|  dst[at] = key
  #|  dst[at + 1] = value
  #|  if at != n:
  #|    dst.copy(at + 2, src, at, n - at)
  #|  dst
  #|
  #|fn remove_pair(src :: slots, at :: i32) -> slots:
  #|  let n = src.len()
  #|  let dst = slots[null ** (n - 2)]
  #|  if at != 0:
  #|    dst.copy(0, src, 0, at)
  #|  if at + 2 != n:
  #|    dst.copy(at, src, at + 2, n - at - 2)
  #|  dst
  #|
  #|fn bitmap(owner :: edit?, bits :: u32, entries :: slots) -> node:
  #|  bitmap_node{edit: owner, bitmap: bits, slots: entries}
  #|
  #|fn array(owner :: edit?, count :: i32, children :: node_slots) -> node:
  #|  array_node{edit: owner, count: count, children: children}
  #|
  #|fn collision(owner :: edit?, hash :: u32, count :: i32, entries :: slots) -> node:
  #|  collision_node{edit: owner, hash: hash, count: count, slots: entries}
  #|
  #|fn singleton_at(shift :: u32, hash :: u32, key :: eq, value :: eq?) -> node:
  #|  bitmap(null, bitpos(hash, shift), slots[key, value])
  #|
  #|fn merge_two(
  #|  shift :: u32,
  #|  hash1 :: u32,
  #|  key1 :: eq,
  #|  value1 :: eq?,
  #|  hash2 :: u32,
  #|  key2 :: eq,
  #|  value2 :: eq?,
  #|) -> node:
  #|  if hash1 == hash2:
  #|    return collision(null, hash1, 2, slots[key1, value1, key2, value2])
  #|  let bit1 = bitpos(hash1, shift)
  #|  let bit2 = bitpos(hash2, shift)
  #|  if bit1 == bit2:
  #|    let child = merge_two(shift + 5, hash1, key1, value1, hash2, key2, value2)
  #|    return bitmap(null, bit1, slots[null, child])
  #|  if bit1 < bit2
  #|  | bitmap(null, bit1 || bit2, slots[key1, value1, key2, value2])
  #|  | bitmap(null, bit1 || bit2, slots[key2, value2, key1, value1])
  #|
  #|fn node_get(
  #|  n :: node,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  equal :: equal_fn,
  #|) -> (bool, eq?):
  #|  match n
  #|  | b :: bitmap_node:
  #|      let bit = bitpos(hash, shift)
  #|      if (b.bitmap && bit) == 0:
  #|        return (false, null)
  #|      let at = bitmap_index(b.bitmap, bit) * 2
  #|      let found_key = b.slots[at]
  #|      if found_key == null:
  #|        return node_get(b.slots[at + 1] as node, shift + 5, hash, key, equal)
  #|      if equal(found_key!, key):
  #|        return (true, b.slots[at + 1])
  #|      return (false, null)
  #|  | a :: array_node:
  #|      let child = a.children[(hash >> shift) & 31]
  #|      if child == null:
  #|        return (false, null)
  #|      return node_get(child!, shift + 5, hash, key, equal)
  #|  | c :: collision_node:
  #|      if c.hash != hash:
  #|        return (false, null)
  #|      for i in 0 ..< c.count:
  #|        let at = i * 2
  #|        if equal(c.slots[at]!, key):
  #|          return (true, c.slots[at + 1])
  #|      return (false, null)
  #|  | _: unreachable
  #|  unreachable
  #|
  #|// A bitmap node with sixteen entries becomes an array node: past that, the
  #|// packed representation costs more to copy than the sparse one costs to hold.
  #|fn promote(
  #|  n :: bitmap_node,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  value :: eq?,
  #|  hash_of :: hash_fn,
  #|) -> node:
  #|  let children = node_slots[null ** 32]
  #|  var slot = 0
  #|  for branch in 0 ..< 32:
  #|    let bit :: u32 = 1 << branch
  #|    if (n.bitmap && bit) != 0:
  #|      let old_key = n.slots[slot]
  #|      if old_key == null
  #|      | children[branch] = n.slots[slot + 1] as node
  #|      | children[branch] = singleton_at(
  #|          shift + 5,
  #|          hash_of(old_key!),
  #|          old_key!,
  #|          n.slots[slot + 1],
  #|        )
  #|      slot += 2
  #|  let index = (hash >> shift) & 31
  #|  children[index] = singleton_at(shift + 5, hash, key, value)
  #|  array(null, 17, children)
  #|
  #|fn node_assoc(
  #|  n :: node?,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  value :: eq?,
  #|  hash_of :: hash_fn,
  #|  equal :: equal_fn,
  #|) -> (node, i32):
  #|  if n == null:
  #|    return (singleton_at(shift, hash, key, value), 1)
  #|  match n!
  #|  | b :: bitmap_node:
  #|      let bit = bitpos(hash, shift)
  #|      let at = bitmap_index(b.bitmap, bit) * 2
  #|      if (b.bitmap && bit) == 0:
  #|        if b.bitmap.popcnt() >= 16:
  #|          return (promote(b, shift, hash, key, value, hash_of), 1)
  #|        return (bitmap(null, b.bitmap || bit, insert_pair(b.slots, at, key, value)), 1)
  #|      let old_key = b.slots[at]
  #|      if old_key == null:
  #|        let (child, added) = node_assoc(
  #|          b.slots[at + 1] as node,
  #|          shift + 5,
  #|          hash,
  #|          key,
  #|          value,
  #|          hash_of,
  #|          equal,
  #|        )
  #|        if child == b.slots[at + 1]:
  #|          return (b, added)
  #|        let entries = copy_slots(b.slots, b.slots.len())
  #|        entries[at + 1] = child
  #|        return (bitmap(null, b.bitmap, entries), added)
  #|      if equal(old_key!, key):
  #|        if b.slots[at + 1] == value:
  #|          return (b, 0)
  #|        let entries = copy_slots(b.slots, b.slots.len())
  #|        entries[at + 1] = value
  #|        return (bitmap(null, b.bitmap, entries), 0)
  #|      let child = merge_two(
  #|        shift + 5,
  #|        hash_of(old_key!),
  #|        old_key!,
  #|        b.slots[at + 1],
  #|        hash,
  #|        key,
  #|        value,
  #|      )
  #|      let entries = copy_slots(b.slots, b.slots.len())
  #|      entries[at] = null
  #|      entries[at + 1] = child
  #|      return (bitmap(null, b.bitmap, entries), 1)
  #|  | a :: array_node:
  #|      let index = (hash >> shift) & 31
  #|      let old = a.children[index]
  #|      let (child, added) = node_assoc(old, shift + 5, hash, key, value, hash_of, equal)
  #|      if old == child:
  #|        return (a, added)
  #|      let children = node_slots[null ** 32]
  #|      children.copy(0, a.children, 0, 32)
  #|      children[index] = child
  #|      let child_delta = if old == null | 1 | 0
  #|      return (array(null, a.count + child_delta, children), added)
  #|  | c :: collision_node:
  #|      if c.hash != hash:
  #|        let bit1 = bitpos(c.hash, shift)
  #|        let bit2 = bitpos(hash, shift)
  #|        if bit1 == bit2:
  #|          let (child, _) = node_assoc(c, shift + 5, hash, key, value, hash_of, equal)
  #|          return (bitmap(null, bit1, slots[null, child]), 1)
  #|        if bit1 < bit2:
  #|          return (bitmap(null, bit1 || bit2, slots[null, c, key, value]), 1)
  #|        return (bitmap(null, bit1 || bit2, slots[key, value, null, c]), 1)
  #|      for i in 0 ..< c.count:
  #|        let at = i * 2
  #|        if equal(c.slots[at]!, key):
  #|          if c.slots[at + 1] == value:
  #|            return (c, 0)
  #|          let entries = copy_slots(c.slots, c.slots.len())
  #|          entries[at + 1] = value
  #|          return (collision(null, hash, c.count, entries), 0)
  #|      return (
  #|        collision(null, hash, c.count + 1, insert_pair(c.slots, c.slots.len(), key, value)),
  #|        1,
  #|      )
  #|  | _: unreachable
  #|  unreachable
  #|
  #|// An array node that has shrunk back below nine children becomes a bitmap node
  #|// again, so a map that grew and shrank does not keep paying for the wide one.
  #|fn pack_array(n :: array_node, removed_index :: i32) -> node?:
  #|  var bits :: u32 = 0
  #|  let entries = slots[null ** ((n.count - 1) * 2)]
  #|  var out = 0
  #|  for i in 0 ..< 32:
  #|    let child = n.children[i]
  #|    if i != removed_index:
  #|      if child != null:
  #|        bits ||= 1 << i
  #|        entries[out] = null
  #|        entries[out + 1] = child
  #|        out += 2
  #|  if bits == 0:
  #|    return null
  #|  bitmap(null, bits, entries)
  #|
  #|fn node_dissoc(
  #|  n :: node,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  equal :: equal_fn,
  #|) -> (node?, bool):
  #|  match n
  #|  | b :: bitmap_node:
  #|      let bit = bitpos(hash, shift)
  #|      if (b.bitmap && bit) == 0:
  #|        return (b, false)
  #|      let at = bitmap_index(b.bitmap, bit) * 2
  #|      let old_key = b.slots[at]
  #|      if old_key == null:
  #|        let (child, removed) = node_dissoc(
  #|          b.slots[at + 1] as node,
  #|          shift + 5,
  #|          hash,
  #|          key,
  #|          equal,
  #|        )
  #|        if !removed:
  #|          return (b, false)
  #|        if child == null:
  #|          if b.bitmap == bit:
  #|            return (null, true)
  #|          return (bitmap(null, b.bitmap ^ bit, remove_pair(b.slots, at)), true)
  #|        let entries = copy_slots(b.slots, b.slots.len())
  #|        entries[at + 1] = child
  #|        return (bitmap(null, b.bitmap, entries), true)
  #|      if !equal(old_key!, key):
  #|        return (b, false)
  #|      if b.bitmap == bit:
  #|        return (null, true)
  #|      return (bitmap(null, b.bitmap ^ bit, remove_pair(b.slots, at)), true)
  #|  | a :: array_node:
  #|      let index = (hash >> shift) & 31
  #|      let old = a.children[index]
  #|      if old == null:
  #|        return (a, false)
  #|      let (child, removed) = node_dissoc(old!, shift + 5, hash, key, equal)
  #|      if !removed:
  #|        return (a, false)
  #|      if child == null:
  #|        if a.count <= 9:
  #|          return (pack_array(a, index), true)
  #|      let children = node_slots[null ** 32]
  #|      children.copy(0, a.children, 0, 32)
  #|      children[index] = child
  #|      let delta = if child == null | 1 | 0
  #|      return (array(null, a.count - delta, children), true)
  #|  | c :: collision_node:
  #|      if c.hash != hash:
  #|        return (c, false)
  #|      for i in 0 ..< c.count:
  #|        let at = i * 2
  #|        if equal(c.slots[at]!, key):
  #|          if c.count == 1:
  #|            return (null, true)
  #|          if c.count == 2:
  #|            let keep = if at == 0 | 2 | 0
  #|            return (singleton_at(shift, hash, c.slots[keep]!, c.slots[keep + 1]), true)
  #|          return (collision(null, hash, c.count - 1, remove_pair(c.slots, at)), true)
  #|      return (c, false)
  #|  | _: unreachable
  #|  unreachable
  #|
  #|fn node_each(n :: node, context :: eq?, seen :: visit):
  #|  match n
  #|  | b :: bitmap_node:
  #|      var i = 0
  #|      while i < b.slots.len() by 2:
  #|        let key = b.slots[i]
  #|        if key == null
  #|        | node_each(b.slots[i + 1] as node, context, seen)
  #|        | seen(context, key, b.slots[i + 1])
  #|      return
  #|  | a :: array_node:
  #|      for i in 0 ..< 32:
  #|        if a.children[i] != null:
  #|          node_each(a.children[i]!, context, seen)
  #|      return
  #|  | c :: collision_node:
  #|      for i in 0 ..< c.count:
  #|        seen(context, c.slots[i * 2], c.slots[i * 2 + 1])
  #|      return
  #|  | _: unreachable
  #|
  #|export "phm_empty" pub fn empty(hash :: hash_fn, equal :: equal_fn) -> map:
  #|  map{count: 0, root: null, has_null: false, null_value: null, hash: hash, equal: equal}
  #|
  #|export "phm_count" pub fn count(m :: map) -> i32:
  #|  m.count
  #|
  #|export "phm_get" pub fn get(m :: map, key :: eq?) -> (bool, eq?):
  #|  if key == null:
  #|    return (m.has_null, m.null_value)
  #|  if m.root == null:
  #|    return (false, null)
  #|  node_get(m.root!, 0, m.hash(key!), key!, m.equal)
  #|
  #|export "phm_contains" pub fn contains(m :: map, key :: eq?) -> bool:
  #|  let (found, _) = get(m, key)
  #|  found
  #|
  #|export "phm_assoc" pub fn assoc(m :: map, key :: eq?, value :: eq?) -> map:
  #|  if key == null:
  #|    if m.has_null:
  #|      if m.null_value == value:
  #|        return m
  #|    let grew = if m.has_null | 0 | 1
  #|    return map{
  #|      count: m.count + grew,
  #|      root: m.root,
  #|      has_null: true,
  #|      null_value: value,
  #|      hash: m.hash,
  #|      equal: m.equal,
  #|    }
  #|  if m.count == 0x7fffffff:
  #|    unreachable
  #|  let (root, added) = node_assoc(m.root, 0, m.hash(key!), key!, value, m.hash, m.equal)
  #|  if root == m.root:
  #|    return m
  #|  map{
  #|    count: m.count + added,
  #|    root: root,
  #|    has_null: m.has_null,
  #|    null_value: m.null_value,
  #|    hash: m.hash,
  #|    equal: m.equal,
  #|  }
  #|
  #|export "phm_dissoc" pub fn dissoc(m :: map, key :: eq?) -> map:
  #|  if key == null:
  #|    if !m.has_null:
  #|      return m
  #|    return map{
  #|      count: m.count - 1,
  #|      root: m.root,
  #|      has_null: false,
  #|      null_value: null,
  #|      hash: m.hash,
  #|      equal: m.equal,
  #|    }
  #|  if m.root == null:
  #|    return m
  #|  let (root, removed) = node_dissoc(m.root!, 0, m.hash(key!), key!, m.equal)
  #|  if !removed:
  #|    return m
  #|  map{
  #|    count: m.count - 1,
  #|    root: root,
  #|    has_null: m.has_null,
  #|    null_value: m.null_value,
  #|    hash: m.hash,
  #|    equal: m.equal,
  #|  }
  #|
  #|export "phm_each" pub fn each(m :: map, context :: eq?, seen :: visit):
  #|  if m.has_null:
  #|    seen(context, null, m.null_value)
  #|  if m.root != null:
  #|    node_each(m.root!, context, seen)
  #|
  #|// ---------------------------------------------------------------- transient
  #|
  #|pub type transient = {
  #|  edit :: edit,
  #|  count :: mut i32,
  #|  root :: mut node?,
  #|  has_null :: mut bool,
  #|  null_value :: mut eq?,
  #|  hash :: hash_fn,
  #|  equal :: equal_fn,
  #|}
  #|
  #|// Every transient operation starts here. A builder that has been frozen is a
  #|// programming mistake rather than a value, so it traps.
  #|fn require_active(t :: transient):
  #|  if t.edit.active == 0:
  #|    unreachable
  #|
  #|// The node this builder is allowed to write into: itself when it already owns
  #|// it, a copy carrying the token otherwise. Ownership is what makes the whole
  #|// structure safe to mutate -- a node the persistent value still points at was
  #|// made by someone else and is never touched.
  #|fn ensure_node(n :: node, owner :: edit) -> node:
  #|  match n
  #|  | b :: bitmap_node:
  #|      if b.edit == owner:
  #|        return b
  #|      return bitmap(owner, b.bitmap, copy_slots(b.slots, b.slots.len()))
  #|  | a :: array_node:
  #|      if a.edit == owner:
  #|        return a
  #|      let children = node_slots[null ** 32]
  #|      children.copy(0, a.children, 0, 32)
  #|      return array(owner, a.count, children)
  #|  | c :: collision_node:
  #|      if c.edit == owner:
  #|        return c
  #|      return collision(owner, c.hash, c.count, copy_slots(c.slots, c.slots.len()))
  #|  | _: unreachable
  #|  unreachable
  #|
  #|fn t_node_assoc(
  #|  n :: node?,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  value :: eq?,
  #|  hash_of :: hash_fn,
  #|  equal :: equal_fn,
  #|  owner :: edit,
  #|) -> (node, i32):
  #|  if n == null:
  #|    let out = singleton_at(shift, hash, key, value)
  #|    out.edit = owner
  #|    return (out, 1)
  #|  let owned = ensure_node(n!, owner)
  #|  match owned
  #|  | b :: bitmap_node:
  #|      let bit = bitpos(hash, shift)
  #|      let at = bitmap_index(b.bitmap, bit) * 2
  #|      if (b.bitmap && bit) == 0:
  #|        if b.bitmap.popcnt() >= 16:
  #|          let promoted = promote(b, shift, hash, key, value, hash_of)
  #|          promoted.edit = owner
  #|          return (promoted, 1)
  #|        b.bitmap = b.bitmap || bit
  #|        b.slots = insert_pair(b.slots, at, key, value)
  #|        return (b, 1)
  #|      let old_key = b.slots[at]
  #|      if old_key == null:
  #|        let (child, added) = t_node_assoc(
  #|          b.slots[at + 1] as node,
  #|          shift + 5,
  #|          hash,
  #|          key,
  #|          value,
  #|          hash_of,
  #|          equal,
  #|          owner,
  #|        )
  #|        b.slots[at + 1] = child
  #|        return (b, added)
  #|      if equal(old_key!, key):
  #|        b.slots[at + 1] = value
  #|        return (b, 0)
  #|      let child = merge_two(
  #|        shift + 5,
  #|        hash_of(old_key!),
  #|        old_key!,
  #|        b.slots[at + 1],
  #|        hash,
  #|        key,
  #|        value,
  #|      )
  #|      b.slots[at] = null
  #|      b.slots[at + 1] = child
  #|      return (b, 1)
  #|  | a :: array_node:
  #|      let index = (hash >> shift) & 31
  #|      let (child, added) = t_node_assoc(
  #|        a.children[index],
  #|        shift + 5,
  #|        hash,
  #|        key,
  #|        value,
  #|        hash_of,
  #|        equal,
  #|        owner,
  #|      )
  #|      if a.children[index] == null:
  #|        a.count = a.count + 1
  #|      a.children[index] = child
  #|      return (a, added)
  #|  | c :: collision_node:
  #|      if c.hash != hash:
  #|        let (out, added) = node_assoc(c, shift, hash, key, value, hash_of, equal)
  #|        out.edit = owner
  #|        return (out, added)
  #|      for i in 0 ..< c.count:
  #|        let at = i * 2
  #|        if equal(c.slots[at]!, key):
  #|          c.slots[at + 1] = value
  #|          return (c, 0)
  #|      c.slots = insert_pair(c.slots, c.slots.len(), key, value)
  #|      c.count = c.count + 1
  #|      return (c, 1)
  #|  | _: unreachable
  #|  unreachable
  #|
  #|fn t_node_dissoc(
  #|  n :: node,
  #|  shift :: u32,
  #|  hash :: u32,
  #|  key :: eq,
  #|  equal :: equal_fn,
  #|  owner :: edit,
  #|) -> (node?, bool):
  #|  let owned = ensure_node(n, owner)
  #|  match owned
  #|  | b :: bitmap_node:
  #|      let bit = bitpos(hash, shift)
  #|      if (b.bitmap && bit) == 0:
  #|        return (b, false)
  #|      let at = bitmap_index(b.bitmap, bit) * 2
  #|      let old_key = b.slots[at]
  #|      if old_key == null:
  #|        let (child, removed) = t_node_dissoc(
  #|          b.slots[at + 1] as node,
  #|          shift + 5,
  #|          hash,
  #|          key,
  #|          equal,
  #|          owner,
  #|        )
  #|        if !removed:
  #|          return (b, false)
  #|        if child == null
  #|        | if b.bitmap == bit:
  #|            return (null, true)
  #|          b.bitmap = b.bitmap ^ bit
  #|          b.slots = remove_pair(b.slots, at)
  #|        | b.slots[at + 1] = child
  #|        return (b, true)
  #|      if !equal(old_key!, key):
  #|        return (b, false)
  #|      if b.bitmap == bit:
  #|        return (null, true)
  #|      b.bitmap = b.bitmap ^ bit
  #|      b.slots = remove_pair(b.slots, at)
  #|      return (b, true)
  #|  | a :: array_node:
  #|      let index = (hash >> shift) & 31
  #|      let old = a.children[index]
  #|      if old == null:
  #|        return (a, false)
  #|      let (child, removed) = t_node_dissoc(old!, shift + 5, hash, key, equal, owner)
  #|      if !removed:
  #|        return (a, false)
  #|      if child == null:
  #|        if a.count <= 9:
  #|          let packed = pack_array(a, index)
  #|          if packed != null:
  #|            packed!.edit = owner
  #|          return (packed, true)
  #|        a.count = a.count - 1
  #|      a.children[index] = child
  #|      return (a, true)
  #|  | c :: collision_node:
  #|      if c.hash != hash:
  #|        return (c, false)
  #|      for i in 0 ..< c.count:
  #|        let at = i * 2
  #|        if equal(c.slots[at]!, key):
  #|          if c.count == 1:
  #|            return (null, true)
  #|          if c.count == 2:
  #|            let keep = if at == 0 | 2 | 0
  #|            let out = singleton_at(shift, hash, c.slots[keep]!, c.slots[keep + 1])
  #|            out.edit = owner
  #|            return (out, true)
  #|          c.slots = remove_pair(c.slots, at)
  #|          c.count = c.count - 1
  #|          return (c, true)
  #|      return (c, false)
  #|  | _: unreachable
  #|  unreachable
  #|
  #|export "phm_as_transient" pub fn as_transient(m :: map) -> transient:
  #|  transient{
  #|    edit: edit{active: 1},
  #|    count: m.count,
  #|    root: m.root,
  #|    has_null: m.has_null,
  #|    null_value: m.null_value,
  #|    hash: m.hash,
  #|    equal: m.equal,
  #|  }
  #|
  #|export "phmt_count" pub fn t_count(t :: transient) -> i32:
  #|  require_active(t)
  #|  t.count
  #|
  #|export "phmt_get" pub fn t_get(t :: transient, key :: eq?) -> (bool, eq?):
  #|  require_active(t)
  #|  if key == null:
  #|    return (t.has_null, t.null_value)
  #|  if t.root == null:
  #|    return (false, null)
  #|  node_get(t.root!, 0, t.hash(key!), key!, t.equal)
  #|
  #|export "phmt_contains" pub fn t_contains(t :: transient, key :: eq?) -> bool:
  #|  let (found, _) = t_get(t, key)
  #|  found
  #|
  #|export "phmt_assoc" pub fn t_assoc(t :: transient, key :: eq?, value :: eq?):
  #|  require_active(t)
  #|  if key == null:
  #|    if !t.has_null:
  #|      t.count = t.count + 1
  #|    t.has_null = true
  #|    t.null_value = value
  #|    return
  #|  if t.count == 0x7fffffff:
  #|    unreachable
  #|  let (root, added) = t_node_assoc(
  #|    t.root,
  #|    0,
  #|    t.hash(key!),
  #|    key!,
  #|    value,
  #|    t.hash,
  #|    t.equal,
  #|    t.edit,
  #|  )
  #|  t.root = root
  #|  t.count = t.count + added
  #|
  #|export "phmt_dissoc" pub fn t_dissoc(t :: transient, key :: eq?):
  #|  require_active(t)
  #|  if key == null:
  #|    if t.has_null:
  #|      t.has_null = false
  #|      t.null_value = null
  #|      t.count = t.count - 1
  #|    return
  #|  if t.root == null:
  #|    return
  #|  let (root, removed) = t_node_dissoc(t.root!, 0, t.hash(key!), key!, t.equal, t.edit)
  #|  t.root = root
  #|  if removed:
  #|    t.count = t.count - 1
  #|
  #|export "phmt_persistent" pub fn t_persistent(t :: transient) -> map:
  #|  require_active(t)
  #|  t.edit.active = 0
  #|  map{
  #|    count: t.count,
  #|    root: t.root,
  #|    has_null: t.has_null,
  #|    null_value: t.null_value,
  #|    hash: t.hash,
  #|    equal: t.equal,
  #|  }

///|
let collections_persistent_hash_set_wap : String =
  #|// A persistent hash set, ported from
  #|// `stdlib/collections/persistent_hash_set.wax`.
  #|//
  #|// The .wax file has to be concatenated after `persistent_hash_map.wax` and
  #|// takes its prefix, `phs_`, to stay out of the map's way. Here it says
  #|// `import collections.persistent_hash_map` and the compiler keeps them apart,
  #|// which is the whole point of the exercise: this is the first module in the
  #|// ported stdlib that depends on another one.
  #|//
  #|// The set is the map with a marker for a value, so everything about hashing,
  #|// equality, structural sharing, null keys and edit ownership is the map's. That
  #|// includes the transient half, which is why it is four lines per operation.
  #|
  #|module persistent_hash_set
  #|
  #|import collections.persistent_hash_map
  #|
  #|type visit = fn(eq?, eq?)
  #|
  #|pub type set = { map :: persistent_hash_map.map }
  #|
  #|type each_context = {
  #|  context :: eq?,
  #|  visit :: visit,
  #|}
  #|
  #|fn each_entry(context :: eq?, key :: eq?, value :: eq?):
  #|  let state = context! as each_context
  #|  state.visit(state.context, key)
  #|
  #|export "phs_empty" pub fn empty(
  #|  hash :: persistent_hash_map.hash_fn,
  #|  equal :: persistent_hash_map.equal_fn,
  #|) -> set:
  #|  set{map: persistent_hash_map.empty(hash, equal)}
  #|
  #|export "phs_count" pub fn count(s :: set) -> i32:
  #|  persistent_hash_map.count(s.map)
  #|
  #|export "phs_contains" pub fn contains(s :: set, value :: eq?) -> bool:
  #|  persistent_hash_map.contains(s.map, value)
  #|
  #|export "phs_add" pub fn add(s :: set, value :: eq?) -> set:
  #|  let m = persistent_hash_map.assoc(s.map, value, 0 as i31)
  #|  if m == s.map:
  #|    return s
  #|  set{map: m}
  #|
  #|export "phs_remove" pub fn remove(s :: set, value :: eq?) -> set:
  #|  let m = persistent_hash_map.dissoc(s.map, value)
  #|  if m == s.map:
  #|    return s
  #|  set{map: m}
  #|
  #|export "phs_each" pub fn each(s :: set, context :: eq?, seen :: visit):
  #|  let state = each_context{context: context, visit: seen}
  #|  persistent_hash_map.each(s.map, state, each_entry)
  #|
  #|type union_context = { out :: mut set }
  #|
  #|fn union_add(context :: eq?, value :: eq?):
  #|  let state = context! as union_context
  #|  state.out = add(state.out, value)
  #|
  #|export "phs_union" pub fn union(left :: set, right :: set) -> set:
  #|  let state = union_context{out: left}
  #|  each(right, state, union_add)
  #|  state.out
  #|
  #|// Intersection and difference are the same walk with the answer inverted, so
  #|// they share a context and differ only in which way `keep_present` points.
  #|type filter_context = {
  #|  other :: set,
  #|  out :: mut set,
  #|  keep_present :: bool,
  #|}
  #|
  #|fn filter_add(context :: eq?, value :: eq?):
  #|  let state = context! as filter_context
  #|  if contains(state.other, value) == state.keep_present:
  #|    state.out = add(state.out, value)
  #|
  #|export "phs_intersection" pub fn intersection(left :: set, right :: set) -> set:
  #|  let state = filter_context{
  #|    other: right,
  #|    out: empty(left.map.hash, left.map.equal),
  #|    keep_present: true,
  #|  }
  #|  each(left, state, filter_add)
  #|  state.out
  #|
  #|export "phs_difference" pub fn difference(left :: set, right :: set) -> set:
  #|  let state = filter_context{
  #|    other: right,
  #|    out: empty(left.map.hash, left.map.equal),
  #|    keep_present: false,
  #|  }
  #|  each(left, state, filter_add)
  #|  state.out
  #|
  #|// ---------------------------------------------------------------- transient
  #|
  #|pub type transient = { map :: persistent_hash_map.transient }
  #|
  #|export "phs_as_transient" pub fn as_transient(s :: set) -> transient:
  #|  transient{map: persistent_hash_map.as_transient(s.map)}
  #|
  #|export "phst_count" pub fn t_count(t :: transient) -> i32:
  #|  persistent_hash_map.t_count(t.map)
  #|
  #|export "phst_contains" pub fn t_contains(t :: transient, value :: eq?) -> bool:
  #|  persistent_hash_map.t_contains(t.map, value)
  #|
  #|export "phst_add" pub fn t_add(t :: transient, value :: eq?):
  #|  persistent_hash_map.t_assoc(t.map, value, 0 as i31)
  #|
  #|export "phst_remove" pub fn t_remove(t :: transient, value :: eq?):
  #|  persistent_hash_map.t_dissoc(t.map, value)
  #|
  #|export "phst_persistent" pub fn t_persistent(t :: transient) -> set:
  #|  set{map: persistent_hash_map.t_persistent(t.map)}

///|
let collections_persistent_vector_wap : String =
  #|// A persistent vector: the bit-partitioned trie, ported from
  #|// `stdlib/collections/persistent_vector.wax`.
  #|//
  #|// The .wax original opens with this comment:
  #|//
  #|//   All names use pv_/pvt_ prefixes because Wax has no source namespaces.
  #|//
  #|// That is the whole difference. Here the names are `node`, `empty`, `push`;
  #|// the module supplies the prefix, and the emitted wasm calls them
  #|// `persistent_vector__node`, `persistent_vector__empty` and so on. Nothing
  #|// else about the data structure changed.
  #|//
  #|// The transient half is here too. It is the same trie with the copying turned
  #|// off: a builder owns an `edit` token, every node it made carries that token,
  #|// and a node that already carries it is written in place instead of being
  #|// copied. `persistent` clears the token, so a builder used after freezing
  #|// traps rather than corrupting the value it handed out.
  #|
  #|module persistent_vector
  #|
  #|const branching = 32
  #|const shift_bits = 5
  #|const mask = 31
  #|
  #|type visit = fn(eq?, i32, eq?)
  #|type edit = { active :: mut i32 }
  #|type slots = [eq?]
  #|
  #|type node = {
  #|  edit :: mut edit?,
  #|  slots :: mut slots,
  #|}
  #|
  #|pub type vector = {
  #|  count :: i32,
  #|  shift :: i32,
  #|  root :: node,
  #|  tail :: slots,
  #|}
  #|
  #|fn node_new(owner :: edit?) -> node:
  #|  node{edit: owner, slots: slots[null ** branching]}
  #|
  #|fn copy_slots(src :: slots, length :: i32) -> slots:
  #|  let dst = slots[null ** length]
  #|  let n = if src.len() < length | src.len() | length
  #|  if n != 0:
  #|    dst.copy(0, src, 0, n)
  #|  dst
  #|
  #|fn node_copy(n :: node) -> node:
  #|  node{edit: null, slots: copy_slots(n.slots, branching)}
  #|
  #|fn tail_offset(count :: i32) -> i32:
  #|  if count < branching:
  #|    return 0
  #|  ((count - 1) >> shift_bits) << shift_bits
  #|
  #|fn new_path(level :: i32, n :: node) -> node:
  #|  if level == 0:
  #|    return n
  #|  let parent = node_new(null)
  #|  parent.slots[0] = new_path(level - shift_bits, n)
  #|  parent
  #|
  #|fn push_tail(level :: i32, parent :: node, tail_node :: node, index :: i32) -> node:
  #|  let out = node_copy(parent)
  #|  let subidx = (index >> level) & mask
  #|  if level == shift_bits:
  #|    out.slots[subidx] = tail_node
  #|    return out
  #|  let child = parent.slots[subidx]
  #|  if child == null
  #|  | out.slots[subidx] = new_path(level - shift_bits, tail_node)
  #|  | out.slots[subidx] = push_tail(level - shift_bits, child as node, tail_node, index)
  #|  out
  #|
  #|fn do_assoc(level :: i32, n :: node, index :: i32, value :: eq?) -> node:
  #|  let out = node_copy(n)
  #|  if level == 0:
  #|    out.slots[index & mask] = value
  #|    return out
  #|  let subidx = (index >> level) & mask
  #|  out.slots[subidx] = do_assoc(level - shift_bits, n.slots[subidx] as node, index, value)
  #|  out
  #|
  #|fn array_for(v :: vector, index :: i32) -> slots:
  #|  if index < 0:
  #|    unreachable
  #|  if index >= v.count:
  #|    unreachable
  #|  if index >= tail_offset(v.count):
  #|    return v.tail
  #|  var n = v.root
  #|  var level = v.shift
  #|  while level > 0:
  #|    n = n.slots[(index >> level) & mask] as node
  #|    level -= shift_bits
  #|  n.slots
  #|
  #|fn pop_tail(level :: i32, n :: node, index :: i32) -> node?:
  #|  let subidx = (index >> level) & mask
  #|  if level > shift_bits:
  #|    let child = pop_tail(level - shift_bits, n.slots[subidx] as node, index)
  #|    if child == null:
  #|      if subidx == 0:
  #|        return null
  #|    let out = node_copy(n)
  #|    out.slots[subidx] = child
  #|    return out
  #|  if subidx == 0:
  #|    return null
  #|  let out = node_copy(n)
  #|  out.slots[subidx] = null
  #|  out
  #|
  #|export "pv_empty" pub fn empty() -> vector:
  #|  vector{count: 0, shift: shift_bits, root: node_new(null), tail: slots[null ** 0]}
  #|
  #|export "pv_count" pub fn count(v :: vector) -> i32:
  #|  v.count
  #|
  #|pub fn get(v :: vector, index :: i32) -> (bool, eq?):
  #|  if index < 0:
  #|    return (false, null)
  #|  if index >= v.count:
  #|    return (false, null)
  #|  let found = array_for(v, index)
  #|  (true, found[index & mask])
  #|
  #|export "pv_at" pub fn at(v :: vector, index :: i32) -> eq?:
  #|  let (ok, value) = get(v, index)
  #|  if !ok:
  #|    unreachable
  #|  value
  #|
  #|export "pv_push" pub fn push(v :: vector, value :: eq?) -> vector:
  #|  if v.count == 0x7fffffff:
  #|    unreachable
  #|  if v.tail.len() < branching:
  #|    let grown_tail = copy_slots(v.tail, v.tail.len() + 1)
  #|    grown_tail[v.tail.len()] = value
  #|    return vector{
  #|      count: v.count + 1,
  #|      shift: v.shift,
  #|      root: v.root,
  #|      tail: grown_tail,
  #|    }
  #|  let tail_node = node{edit: null, slots: v.tail}
  #|  var shift = v.shift
  #|  var root = v.root
  #|  if (v.count >> shift_bits) > (1 << shift)
  #|  | let grown = node_new(null)
  #|    grown.slots[0] = v.root
  #|    grown.slots[1] = new_path(shift, tail_node)
  #|    shift += shift_bits
  #|    root = grown
  #|  | root = push_tail(shift, v.root, tail_node, v.count - 1)
  #|  vector{count: v.count + 1, shift: shift, root: root, tail: slots[value]}
  #|
  #|export "pv_assoc" pub fn assoc(v :: vector, index :: i32, value :: eq?) -> vector:
  #|  if index == v.count:
  #|    return push(v, value)
  #|  if index < 0:
  #|    unreachable
  #|  if index >= v.count:
  #|    unreachable
  #|  let offset = tail_offset(v.count)
  #|  if index >= offset:
  #|    if v.tail[index & mask] == value:
  #|      return v
  #|    let updated = copy_slots(v.tail, v.tail.len())
  #|    updated[index & mask] = value
  #|    return vector{
  #|      count: v.count,
  #|      shift: v.shift,
  #|      root: v.root,
  #|      tail: updated,
  #|    }
  #|  vector{
  #|    count: v.count,
  #|    shift: v.shift,
  #|    root: do_assoc(v.shift, v.root, index, value),
  #|    tail: v.tail,
  #|  }
  #|
  #|pub fn peek(v :: vector) -> (bool, eq?):
  #|  if v.count == 0:
  #|    return (false, null)
  #|  (true, v.tail[v.tail.len() - 1])
  #|
  #|export "pv_pop" pub fn pop(v :: vector) -> vector:
  #|  if v.count == 0:
  #|    unreachable
  #|  if v.count == 1:
  #|    return empty()
  #|  if v.tail.len() > 1:
  #|    return vector{
  #|      count: v.count - 1,
  #|      shift: v.shift,
  #|      root: v.root,
  #|      tail: copy_slots(v.tail, v.tail.len() - 1),
  #|    }
  #|  let new_tail = array_for(v, v.count - 2)
  #|  let shrunk = pop_tail(v.shift, v.root, v.count - 2)
  #|  var root = if shrunk == null | node_new(null) | shrunk!
  #|  var shift = v.shift
  #|  if shift > shift_bits:
  #|    if root.slots[1] == null:
  #|      root = root.slots[0] as node
  #|      shift -= shift_bits
  #|  vector{count: v.count - 1, shift: shift, root: root, tail: new_tail}
  #|
  #|export "pv_each" pub fn each(v :: vector, context :: eq?, seen :: visit):
  #|  for i in 0 ..< v.count:
  #|    seen(context, i, at(v, i))
  #|
  #|// ---------------------------------------------------------------- transient
  #|
  #|pub type transient = {
  #|  edit :: edit,
  #|  count :: mut i32,
  #|  shift :: mut i32,
  #|  root :: mut node,
  #|  tail :: mut slots,
  #|  // The tail array is always full width; this is how much of it is live. The
  #|  // persistent side has no such field because its tail is exactly as long as
  #|  // it is full.
  #|  tail_count :: mut i32,
  #|}
  #|
  #|fn ensure_node(n :: node, owner :: edit) -> node:
  #|  if n.edit == owner:
  #|    return n
  #|  node{edit: owner, slots: copy_slots(n.slots, branching)}
  #|
  #|fn t_new_path(level :: i32, n :: node, owner :: edit) -> node:
  #|  if level == 0:
  #|    return n
  #|  let parent = node_new(owner)
  #|  parent.slots[0] = t_new_path(level - shift_bits, n, owner)
  #|  parent
  #|
  #|fn t_push_tail(
  #|  level :: i32,
  #|  parent :: node,
  #|  tail_node :: node,
  #|  index :: i32,
  #|  owner :: edit,
  #|) -> node:
  #|  let out = ensure_node(parent, owner)
  #|  let subidx = (index >> level) & mask
  #|  if level == shift_bits:
  #|    out.slots[subidx] = tail_node
  #|    return out
  #|  let child = out.slots[subidx]
  #|  if child == null
  #|  | out.slots[subidx] = t_new_path(level - shift_bits, tail_node, owner)
  #|  | out.slots[subidx] = t_push_tail(level - shift_bits, child as node, tail_node, index, owner)
  #|  out
  #|
  #|fn t_do_assoc(
  #|  level :: i32,
  #|  n :: node,
  #|  index :: i32,
  #|  value :: eq?,
  #|  owner :: edit,
  #|) -> node:
  #|  let out = ensure_node(n, owner)
  #|  if level == 0:
  #|    out.slots[index & mask] = value
  #|    return out
  #|  let subidx = (index >> level) & mask
  #|  out.slots[subidx] = t_do_assoc(
  #|    level - shift_bits,
  #|    out.slots[subidx] as node,
  #|    index,
  #|    value,
  #|    owner,
  #|  )
  #|  out
  #|
  #|fn t_pop_tail(level :: i32, n :: node, index :: i32, owner :: edit) -> node?:
  #|  let out = ensure_node(n, owner)
  #|  let subidx = (index >> level) & mask
  #|  if level > shift_bits:
  #|    let child = t_pop_tail(level - shift_bits, out.slots[subidx] as node, index, owner)
  #|    if child == null:
  #|      if subidx == 0:
  #|        return null
  #|    out.slots[subidx] = child
  #|    return out
  #|  if subidx == 0:
  #|    return null
  #|  out.slots[subidx] = null
  #|  out
  #|
  #|// Every transient operation starts here. A builder that has been frozen is a
  #|// programming mistake rather than a value, so it traps.
  #|fn require_active(t :: transient):
  #|  if t.edit.active == 0:
  #|    unreachable
  #|
  #|fn snapshot(t :: transient) -> vector:
  #|  vector{
  #|    count: t.count,
  #|    shift: t.shift,
  #|    root: t.root,
  #|    tail: copy_slots(t.tail, t.tail_count),
  #|  }
  #|
  #|export "pv_as_transient" pub fn as_transient(v :: vector) -> transient:
  #|  let owner = edit{active: 1}
  #|  transient{
  #|    edit: owner,
  #|    count: v.count,
  #|    shift: v.shift,
  #|    root: ensure_node(v.root, owner),
  #|    tail: copy_slots(v.tail, branching),
  #|    tail_count: v.tail.len(),
  #|  }
  #|
  #|export "pvt_count" pub fn t_count(t :: transient) -> i32:
  #|  require_active(t)
  #|  t.count
  #|
  #|export "pvt_get" pub fn t_get(t :: transient, index :: i32) -> (bool, eq?):
  #|  require_active(t)
  #|  if index < 0:
  #|    return (false, null)
  #|  if index >= t.count:
  #|    return (false, null)
  #|  if index >= tail_offset(t.count):
  #|    return (true, t.tail[index & mask])
  #|  var n = t.root
  #|  var level = t.shift
  #|  while level > 0:
  #|    n = n.slots[(index >> level) & mask] as node
  #|    level -= shift_bits
  #|  (true, n.slots[index & mask])
  #|
  #|export "pvt_at" pub fn t_at(t :: transient, index :: i32) -> eq?:
  #|  require_active(t)
  #|  let (found, value) = t_get(t, index)
  #|  if !found:
  #|    unreachable
  #|  value
  #|
  #|export "pvt_push" pub fn t_push(t :: transient, value :: eq?):
  #|  require_active(t)
  #|  if t.count == 0x7fffffff:
  #|    unreachable
  #|  if t.tail_count < branching:
  #|    t.tail[t.tail_count] = value
  #|    t.tail_count = t.tail_count + 1
  #|    t.count = t.count + 1
  #|    return
  #|  let tail_node = node{edit: t.edit, slots: t.tail}
  #|  if (t.count >> shift_bits) > (1 << t.shift)
  #|  | let grown = node_new(t.edit)
  #|    grown.slots[0] = t.root
  #|    grown.slots[1] = t_new_path(t.shift, tail_node, t.edit)
  #|    t.root = grown
  #|    t.shift = t.shift + shift_bits
  #|  | t.root = t_push_tail(t.shift, t.root, tail_node, t.count - 1, t.edit)
  #|  t.tail = slots[null ** branching]
  #|  t.tail[0] = value
  #|  t.tail_count = 1
  #|  t.count = t.count + 1
  #|
  #|export "pvt_assoc" pub fn t_assoc(t :: transient, index :: i32, value :: eq?):
  #|  require_active(t)
  #|  if index == t.count:
  #|    t_push(t, value)
  #|    return
  #|  if index < 0:
  #|    unreachable
  #|  if index >= t.count:
  #|    unreachable
  #|  if index >= tail_offset(t.count):
  #|    t.tail[index & mask] = value
  #|    return
  #|  t.root = t_do_assoc(t.shift, t.root, index, value, t.edit)
  #|
  #|export "pvt_pop" pub fn t_pop(t :: transient):
  #|  require_active(t)
  #|  if t.count == 0:
  #|    unreachable
  #|  if t.count == 1:
  #|    t.count = 0
  #|    t.tail[0] = null
  #|    t.tail_count = 0
  #|    return
  #|  if t.tail_count > 1:
  #|    t.tail_count = t.tail_count - 1
  #|    t.tail[t.tail_count] = null
  #|    t.count = t.count - 1
  #|    return
  #|  var leaf = t.root
  #|  var level = t.shift
  #|  let index = t.count - 2
  #|  while level > 0:
  #|    leaf = leaf.slots[(index >> level) & mask] as node
  #|    level -= shift_bits
  #|  t.tail = copy_slots(leaf.slots, branching)
  #|  t.tail_count = branching
  #|  let shrunk = t_pop_tail(t.shift, t.root, t.count - 2, t.edit)
  #|  t.root = if shrunk == null | node_new(t.edit) | shrunk!
  #|  if t.shift > shift_bits:
  #|    if t.root.slots[1] == null:
  #|      t.root = t.root.slots[0] as node
  #|      t.shift = t.shift - shift_bits
  #|  t.count = t.count - 1
  #|
  #|export "pvt_persistent" pub fn t_persistent(t :: transient) -> vector:
  #|  require_active(t)
  #|  t.edit.active = 0
  #|  snapshot(t)

///|
let data_immutable_value_wap : String =
  #|// Immutable JSON-like values, ported from `stdlib/data/immutable_value.wax`.
  #|//
  #|// The module is called `jv`, not `immutable_value`, and that is deliberate:
  #|// wap takes the module's own declared name as the alias, not the last segment
  #|// of the path it was found at, so `import data.immutable_value` brings this in
  #|// as `jv`. Every name in the .wax file is `jv_something`, and the module now
  #|// supplies that prefix -- `jv_i32` is `jv.i32`, emitted as `jv__i32`.
  #|//
  #|// It is also why `fn i32` and `fn bool` are not a problem: a type and a
  #|// function do not share a namespace, and the qualifier says which is meant.
  #|//
  #|// Three differences from the original beyond the prefix.
  #|//
  #|// A predicate returns `bool` and a lookup returns `(bool, value)`. Wax has no
  #|// `bool`, so the original returns `i32` and every caller compares it against 0.
  #|//
  #|// A hash is `u32`, because that is what `collections.hashing` produces and what
  #|// the map's `hash_fn` expects.
  #|//
  #|// `record_to_map`, `record_equal` and `record_hash` live here rather than in
  #|// `data/record.wap`. In the .wax files they are in record.wax, which is fine
  #|// when the sources are concatenated into one namespace: `jv_equal` calls
  #|// `jv_record_equal` and `jv_record_equal` calls `jv_equal`. wap modules cannot
  #|// import each other in a circle, so the three functions that close the loop
  #|// move to this side. All three are one-liners over fields declared here, and
  #|// `data/record.wap` calls them by name.
  #|
  #|module jv
  #|
  #|import collections.hashing
  #|import collections.persistent_hash_map
  #|import collections.persistent_hash_set
  #|import collections.persistent_vector
  #|import text.utf8
  #|
  #|pub const kind_null = 0
  #|pub const kind_bool = 1
  #|pub const kind_string = 2
  #|pub const kind_i32 = 3
  #|pub const kind_i64 = 4
  #|pub const kind_f32 = 5
  #|pub const kind_f64 = 6
  #|pub const kind_vector = 7
  #|pub const kind_map = 8
  #|pub const kind_any = 9
  #|pub const kind_set = 10
  #|pub const kind_record = 11
  #|pub const kind_ordered_map = 12
  #|pub const kind_ordered_set = 13
  #|
  #|// Insertion-ordered storage, shared by the ordered map and the ordered set: a
  #|// HAMT from key to slot, and a vector of entries in encounter order. A removed
  #|// entry leaves a tombstone until the trailing ones are trimmed or the whole
  #|// thing is compacted.
  #|pub type entry = { key :: eq, value :: eq? }
  #|
  #|pub type store = {
  #|  index :: persistent_hash_map.map,
  #|  entries :: persistent_vector.vector,
  #|}
  #|
  #|pub type transient_store = {
  #|  index :: persistent_hash_map.transient,
  #|  entries :: persistent_vector.transient,
  #|}
  #|
  #|pub type value = { kind :: i32 }
  #|pub type null_value :: value = {}
  #|pub type bool_value :: value = { value :: bool }
  #|pub type string_value :: value = { value :: utf8.string }
  #|pub type i32_value :: value = { value :: i32 }
  #|pub type i64_value :: value = { value :: i64 }
  #|pub type f32_value :: value = { value :: f32 }
  #|pub type f64_value :: value = { value :: f64 }
  #|pub type vector_value :: value = { value :: persistent_vector.vector }
  #|pub type map_value :: value = { value :: persistent_hash_map.map }
  #|pub type any_value :: value = { value :: any? }
  #|pub type set_value :: value = { value :: persistent_hash_set.set }
  #|pub type ordered_map_value :: value = { value :: store }
  #|pub type ordered_set_value :: value = { value :: store }
  #|
  #|pub type record_value :: value = {
  #|  definition :: record_type,
  #|  values :: persistent_hash_map.map,
  #|}
  #|
  #|// The runtime type descriptors. Their constructors and the validation walk are
  #|// in `data/record.wap`; the shapes are here because `record_value` names them
  #|// and everything in one module is visible to the rest of it.
  #|pub type runtime_type = { kind :: i32 }
  #|pub type type_scalar :: runtime_type = {}
  #|pub type type_vector_value :: runtime_type = { element :: runtime_type }
  #|pub type type_map_value :: runtime_type = { value :: runtime_type }
  #|pub type type_set_value :: runtime_type = { element :: runtime_type }
  #|pub type type_ordered_map_value :: runtime_type = { value :: runtime_type }
  #|pub type type_ordered_set_value :: runtime_type = { element :: runtime_type }
  #|pub type type_record_value :: runtime_type = { definition :: record_type }
  #|pub type type_or_value :: runtime_type = {
  #|  left :: runtime_type,
  #|  right :: runtime_type,
  #|}
  #|
  #|pub type field_validator = fn(eq?, value) -> bool
  #|pub type record_validator = fn(eq?, record_value) -> bool
  #|
  #|pub type record_field = {
  #|  value_type :: runtime_type,
  #|  default_value :: value,
  #|  validator_context :: eq?,
  #|  validator :: field_validator,
  #|}
  #|
  #|pub type record_schema = {
  #|  fields :: persistent_hash_map.map,
  #|  defaults :: persistent_hash_map.map,
  #|}
  #|
  #|pub type record_type = {
  #|  name :: utf8.string,
  #|  schema :: record_schema,
  #|  validator_context :: eq?,
  #|  validator :: record_validator,
  #|}
  #|
  #|pub type vector_visit = fn(eq?, i32, value)
  #|pub type map_visit = fn(eq?, utf8.string, value)
  #|pub type set_visit = fn(eq?, value)
  #|
  #|pub type transient_vector = { value :: persistent_vector.transient }
  #|pub type transient_map = { value :: persistent_hash_map.transient }
  #|pub type transient_set = { value :: persistent_hash_set.transient }
  #|pub type transient_ordered_map = { value :: transient_store }
  #|pub type transient_ordered_set = { value :: transient_store }
  #|
  #|// ------------------------------------------------------------------ scalars
  #|
  #|pub fn null() -> value:
  #|  null_value{kind: kind_null}
  #|
  #|pub fn bool(v :: bool) -> value:
  #|  bool_value{kind: kind_bool, value: v}
  #|
  #|pub fn string(v :: utf8.string) -> value:
  #|  string_value{kind: kind_string, value: v}
  #|
  #|pub fn i32(v :: i32) -> value:
  #|  i32_value{kind: kind_i32, value: v}
  #|
  #|pub fn i64(v :: i64) -> value:
  #|  i64_value{kind: kind_i64, value: v}
  #|
  #|pub fn f32(v :: f32) -> value:
  #|  f32_value{kind: kind_f32, value: v}
  #|
  #|pub fn f64(v :: f64) -> value:
  #|  f64_value{kind: kind_f64, value: v}
  #|
  #|pub fn any(v :: any?) -> value:
  #|  any_value{kind: kind_any, value: v}
  #|
  #|pub fn kind(v :: value) -> i32:
  #|  v.kind
  #|
  #|// Each scalar has a safe accessor and a trapping one. The safe one answers
  #|// `(false, zero)` for the wrong kind, so a caller that is asking rather than
  #|// asserting never traps.
  #|pub fn get_bool(v :: value) -> (bool, bool):
  #|  match v
  #|  | found :: bool_value: return (true, found.value)
  #|  | _: return (false, false)
  #|  unreachable
  #|
  #|pub fn require_bool(v :: value) -> bool:
  #|  let (found, out) = get_bool(v)
  #|  if !found:
  #|    unreachable
  #|  out
  #|
  #|pub fn get_string(v :: value) -> (bool, utf8.string?):
  #|  match v
  #|  | found :: string_value: return (true, found.value)
  #|  | _: return (false, null)
  #|  unreachable
  #|
  #|pub fn require_string(v :: value) -> utf8.string:
  #|  let (found, out) = get_string(v)
  #|  if !found:
  #|    unreachable
  #|  out!
  #|
  #|pub fn get_i32(v :: value) -> (bool, i32):
  #|  match v
  #|  | found :: i32_value: return (true, found.value)
  #|  | _: return (false, 0)
  #|  unreachable
  #|
  #|pub fn require_i32(v :: value) -> i32:
  #|  let (found, out) = get_i32(v)
  #|  if !found:
  #|    unreachable
  #|  out
  #|
  #|pub fn get_i64(v :: value) -> (bool, i64):
  #|  match v
  #|  | found :: i64_value: return (true, found.value)
  #|  | _: return (false, 0)
  #|  unreachable
  #|
  #|pub fn require_i64(v :: value) -> i64:
  #|  let (found, out) = get_i64(v)
  #|  if !found:
  #|    unreachable
  #|  out
  #|
  #|pub fn get_f32(v :: value) -> (bool, f32):
  #|  match v
  #|  | found :: f32_value: return (true, found.value)
  #|  | _: return (false, 0.0)
  #|  unreachable
  #|
  #|pub fn require_f32(v :: value) -> f32:
  #|  let (found, out) = get_f32(v)
  #|  if !found:
  #|    unreachable
  #|  out
  #|
  #|pub fn get_f64(v :: value) -> (bool, f64):
  #|  match v
  #|  | found :: f64_value: return (true, found.value)
  #|  | _: return (false, 0.0)
  #|  unreachable
  #|
  #|pub fn require_f64(v :: value) -> f64:
  #|  let (found, out) = get_f64(v)
  #|  if !found:
  #|    unreachable
  #|  out
  #|
  #|pub fn get_any(v :: value) -> (bool, any?):
  #|  match v
  #|  | found :: any_value: return (true, found.value)
  #|  | _: return (false, null)
  #|  unreachable
  #|
  #|pub fn require_any(v :: value) -> any?:
  #|  let (found, out) = get_any(v)
  #|  if !found:
  #|    unreachable
  #|  out
  #|
  #|// An opaque payload compares by reference when it is in the equality
  #|// hierarchy, and is unequal to everything otherwise.
  #|pub fn any_equal(left :: any?, right :: any?) -> bool:
  #|  match left
  #|  | null:
  #|      match right
  #|      | null: return true
  #|      | _: return false
  #|      unreachable
  #|  | v :: eq:
  #|      match right
  #|      | other :: eq: return v == other
  #|      | _: return false
  #|      unreachable
  #|  | _: return false
  #|  unreachable
  #|
  #|// ---------------------------------------------- insertion-ordered storage
  #|
  #|pub fn store_empty(
  #|  hash :: persistent_hash_map.hash_fn,
  #|  equal :: persistent_hash_map.equal_fn,
  #|) -> store:
  #|  store{
  #|    index: persistent_hash_map.empty(hash, equal),
  #|    entries: persistent_vector.empty(),
  #|  }
  #|
  #|pub fn store_count(s :: store) -> i32:
  #|  persistent_hash_map.count(s.index)
  #|
  #|fn store_slot(s :: store, key :: eq) -> (bool, i32):
  #|  let (found, v) = persistent_hash_map.get(s.index, key)
  #|  if !found:
  #|    return (false, 0)
  #|  (true, v! as i32_s)
  #|
  #|pub fn store_get(s :: store, key :: eq) -> (bool, eq?):
  #|  let (found, slot) = store_slot(s, key)
  #|  if !found:
  #|    return (false, null)
  #|  let e = persistent_vector.at(s.entries, slot)! as entry
  #|  (true, e.value)
  #|
  #|pub fn store_contains(s :: store, key :: eq) -> bool:
  #|  persistent_hash_map.contains(s.index, key)
  #|
  #|// The cursor walks slots, skipping tombstones, and answers where to resume.
  #|pub fn store_next(s :: store, start :: i32) -> (i32, entry?):
  #|  var i = start
  #|  while i < persistent_vector.count(s.entries):
  #|    let raw = persistent_vector.at(s.entries, i)
  #|    i += 1
  #|    if raw != null:
  #|      return (i, raw! as entry)
  #|  (i, null)
  #|
  #|// Sparse storage is rebuilt once it is more than half tombstones, and only
  #|// past a floor where the copy is cheap. Encounter order does not change.
  #|fn store_compact(s :: store) -> store:
  #|  let slots = persistent_vector.count(s.entries)
  #|  let count = store_count(s)
  #|  if slots < 32:
  #|    return s
  #|  if slots < count * 2:
  #|    return s
  #|  var index = persistent_hash_map.empty(s.index.hash, s.index.equal)
  #|  var entries = persistent_vector.empty()
  #|  for cursor in 0 ..< slots:
  #|    let raw = persistent_vector.at(s.entries, cursor)
  #|    if raw != null:
  #|      let e = raw! as entry
  #|      index = persistent_hash_map.assoc(
  #|        index,
  #|        e.key,
  #|        persistent_vector.count(entries) as i31,
  #|      )
  #|      entries = persistent_vector.push(entries, e)
  #|  store{index: index, entries: entries}
  #|
  #|pub fn store_assoc(s :: store, key :: eq, value :: eq?) -> store:
  #|  let (found, slot) = store_slot(s, key)
  #|  if found:
  #|    let old = persistent_vector.at(s.entries, slot)! as entry
  #|    if old.value == value:
  #|      return s
  #|    let e = entry{key: old.key, value: value}
  #|    return store{
  #|      index: s.index,
  #|      entries: persistent_vector.assoc(s.entries, slot, e),
  #|    }
  #|  let slot = persistent_vector.count(s.entries)
  #|  let e = entry{key: key, value: value}
  #|  store{
  #|    index: persistent_hash_map.assoc(s.index, key, slot as i31),
  #|    entries: persistent_vector.push(s.entries, e),
  #|  }
  #|
  #|fn has_trailing_tombstone(entries :: persistent_vector.vector) -> bool:
  #|  if persistent_vector.count(entries) == 0:
  #|    return false
  #|  persistent_vector.at(entries, persistent_vector.count(entries) - 1) == null
  #|
  #|pub fn store_dissoc(s :: store, key :: eq) -> store:
  #|  let (found, slot) = store_slot(s, key)
  #|  if !found:
  #|    return s
  #|  let index = persistent_hash_map.dissoc(s.index, key)
  #|  var entries = persistent_vector.assoc(s.entries, slot, null)
  #|  while has_trailing_tombstone(entries):
  #|    entries = persistent_vector.pop(entries)
  #|  store_compact(store{index: index, entries: entries})
  #|
  #|pub fn store_as_transient(s :: store) -> transient_store:
  #|  transient_store{
  #|    index: persistent_hash_map.as_transient(s.index),
  #|    entries: persistent_vector.as_transient(s.entries),
  #|  }
  #|
  #|pub fn t_store_count(s :: transient_store) -> i32:
  #|  persistent_hash_map.t_count(s.index)
  #|
  #|fn t_store_slot(s :: transient_store, key :: eq) -> (bool, i32):
  #|  let (found, v) = persistent_hash_map.t_get(s.index, key)
  #|  if !found:
  #|    return (false, 0)
  #|  (true, v! as i32_s)
  #|
  #|pub fn t_store_get(s :: transient_store, key :: eq) -> (bool, eq?):
  #|  let (found, slot) = t_store_slot(s, key)
  #|  if !found:
  #|    return (false, null)
  #|  let e = persistent_vector.t_at(s.entries, slot)! as entry
  #|  (true, e.value)
  #|
  #|pub fn t_store_contains(s :: transient_store, key :: eq) -> bool:
  #|  persistent_hash_map.t_contains(s.index, key)
  #|
  #|pub fn t_store_assoc(s :: transient_store, key :: eq, value :: eq?):
  #|  let (found, slot) = t_store_slot(s, key)
  #|  if found:
  #|    let old = persistent_vector.t_at(s.entries, slot)! as entry
  #|    if old.value == value:
  #|      return
  #|    persistent_vector.t_assoc(s.entries, slot, entry{key: old.key, value: value})
  #|    return
  #|  let slot = persistent_vector.t_count(s.entries)
  #|  persistent_hash_map.t_assoc(s.index, key, slot as i31)
  #|  persistent_vector.t_push(s.entries, entry{key: key, value: value})
  #|
  #|fn t_has_trailing_tombstone(entries :: persistent_vector.transient) -> bool:
  #|  if persistent_vector.t_count(entries) == 0:
  #|    return false
  #|  persistent_vector.t_at(entries, persistent_vector.t_count(entries) - 1) == null
  #|
  #|pub fn t_store_dissoc(s :: transient_store, key :: eq):
  #|  let (found, slot) = t_store_slot(s, key)
  #|  if !found:
  #|    return
  #|  persistent_hash_map.t_dissoc(s.index, key)
  #|  persistent_vector.t_assoc(s.entries, slot, null)
  #|  while t_has_trailing_tombstone(s.entries):
  #|    persistent_vector.t_pop(s.entries)
  #|
  #|pub fn t_store_persistent(s :: transient_store) -> store:
  #|  let index = persistent_hash_map.t_persistent(s.index)
  #|  let entries = persistent_vector.t_persistent(s.entries)
  #|  store_compact(store{index: index, entries: entries})
  #|
  #|// ------------------------------------------------------------------ vectors
  #|
  #|pub fn vector_empty() -> vector_value:
  #|  vector_value{kind: kind_vector, value: persistent_vector.empty()}
  #|
  #|pub fn get_vector(v :: value) -> (bool, vector_value?):
  #|  match v
  #|  | found :: vector_value: return (true, found)
  #|  | _: return (false, null)
  #|  unreachable
  #|
  #|pub fn require_vector(v :: value) -> vector_value:
  #|  let (found, out) = get_vector(v)
  #|  if !found:
  #|    unreachable
  #|  out!
