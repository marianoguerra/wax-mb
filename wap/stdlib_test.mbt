  #|  vector_value{kind: kind_vector, value: persistent_vector.push(v.value, item)}
  #|
  #|pub fn vector_assoc(v :: vector_value, index :: i32, item :: value) -> vector_value:
  #|  let raw = persistent_vector.assoc(v.value, index, item)
  #|  if raw == v.value:
  #|    return v
  #|  vector_value{kind: kind_vector, value: raw}
  #|
  #|pub fn vector_peek(v :: vector_value) -> (bool, value?):
  #|  let (found, out) = persistent_vector.peek(v.value)
  #|  if !found:
  #|    return (false, null)
  #|  (true, out! as value)
  #|
  #|pub fn vector_pop(v :: vector_value) -> vector_value:
  #|  vector_value{kind: kind_vector, value: persistent_vector.pop(v.value)}
  #|
  #|type vector_each_context = {
  #|  context :: eq?,
  #|  visit :: vector_visit,
  #|}
  #|
  #|fn vector_each_adapter(context :: eq?, index :: i32, item :: eq?):
  #|  let state = context! as vector_each_context
  #|  state.visit(state.context, index, item! as value)
  #|
  #|pub fn vector_each(v :: vector_value, context :: eq?, seen :: vector_visit):
  #|  let state = vector_each_context{context: context, visit: seen}
  #|  persistent_vector.each(v.value, state, vector_each_adapter)
  #|
