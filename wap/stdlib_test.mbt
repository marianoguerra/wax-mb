  #|pub fn vector_count(v :: vector_value) -> i32:
  #|  persistent_vector.count(v.value)
  #|
  #|pub fn vector_get(v :: vector_value, index :: i32) -> (bool, value?):
  #|  let (found, out) = persistent_vector.get(v.value, index)
  #|  if !found:
  #|    return (false, null)
  #|  (true, out! as value)
  #|
  #|pub fn vector_at(v :: vector_value, index :: i32) -> value:
  #|  let (found, out) = vector_get(v, index)
  #|  if !found:
  #|    unreachable
  #|  out!
  #|
