  #|  let raw = store_assoc(s.value, item, 0 as i31)
  #|  if raw == s.value:
  #|    return s
  #|  ordered_set_value{kind: kind_ordered_set, value: raw}
  #|
  #|pub fn ordered_set_remove(s :: ordered_set_value, item :: value) -> ordered_set_value:
  #|  let raw = store_dissoc(s.value, item)
  #|  if raw == s.value:
  #|    return s
  #|  ordered_set_value{kind: kind_ordered_set, value: raw}
  #|
  #|pub fn ordered_set_each(s :: ordered_set_value, context :: eq?, seen :: set_visit):
  #|  var cursor = 0
  #|  while cursor < persistent_vector.count(s.value.entries):
  #|    let (next, e) = store_next(s.value, cursor)
  #|    cursor = next
  #|    if e != null:
  #|      seen(context, e!.key as value)
  #|
  #|type ordered_set_union_context = { out :: mut ordered_set_value }
  #|
  #|fn ordered_set_union_add(context :: eq?, item :: value):
  #|  let state = context! as ordered_set_union_context
  #|  state.out = ordered_set_add(state.out, item)
  #|
  #|pub fn ordered_set_union(
  #|  left :: ordered_set_value,
  #|  right :: ordered_set_value,
  #|) -> ordered_set_value:
  #|  let state = ordered_set_union_context{out: left}
  #|  ordered_set_each(right, state, ordered_set_union_add)
  #|  state.out
  #|
  #|type ordered_set_filter_context = {
  #|  other :: ordered_set_value,
  #|  out :: mut ordered_set_value,
  #|  keep_present :: bool,
  #|}
  #|
  #|fn ordered_set_filter_add(context :: eq?, item :: value):
  #|  let state = context! as ordered_set_filter_context
  #|  if ordered_set_contains(state.other, item) == state.keep_present:
  #|    state.out = ordered_set_add(state.out, item)
  #|
  #|pub fn ordered_set_intersection(
  #|  left :: ordered_set_value,
  #|  right :: ordered_set_value,
  #|) -> ordered_set_value:
  #|  let state = ordered_set_filter_context{
  #|    other: right,
  #|    out: ordered_set_empty(),
  #|    keep_present: true,
  #|  }
  #|  ordered_set_each(left, state, ordered_set_filter_add)
  #|  state.out
  #|
  #|pub fn ordered_set_difference(
  #|  left :: ordered_set_value,
  #|  right :: ordered_set_value,
  #|) -> ordered_set_value:
  #|  let state = ordered_set_filter_context{
  #|    other: right,
  #|    out: ordered_set_empty(),
  #|    keep_present: false,
  #|  }
  #|  ordered_set_each(left, state, ordered_set_filter_add)
  #|  state.out
  #|
  #|pub fn ordered_set_as_transient(s :: ordered_set_value) -> transient_ordered_set:
  #|  transient_ordered_set{value: store_as_transient(s.value)}
  #|
  #|pub fn t_ordered_set_count(s :: transient_ordered_set) -> i32:
  #|  t_store_count(s.value)
  #|
  #|pub fn t_ordered_set_contains(s :: transient_ordered_set, item :: value) -> bool:
  #|  t_store_contains(s.value, item)
  #|
  #|pub fn t_ordered_set_add(s :: transient_ordered_set, item :: value):
  #|  t_store_assoc(s.value, item, 0 as i31)
  #|
  #|pub fn t_ordered_set_remove(s :: transient_ordered_set, item :: value):
  #|  t_store_dissoc(s.value, item)
  #|
  #|pub fn t_ordered_set_persistent(s :: transient_ordered_set) -> ordered_set_value:
  #|  ordered_set_value{kind: kind_ordered_set, value: t_store_persistent(s.value)}
  #|
  #|// ----------------------------------------------------------------- equality
  #|
  #|type map_equal_context = {
  #|  right :: map_value,
  #|  equal :: mut bool,
  #|}
  #|
  #|fn map_equal_entry(context :: eq?, key :: utf8.string, item :: value):
  #|  let state = context! as map_equal_context
  #|  if !state.equal:
  #|    return
  #|  let (found, other) = map_get(state.right, key)
  #|  if !found:
  #|    state.equal = false
  #|    return
  #|  if !equal(item, other!):
  #|    state.equal = false
  #|
  #|type set_equal_context = {
  #|  right :: set_value,
  #|  equal :: mut bool,
  #|}
  #|
  #|fn set_equal_entry(context :: eq?, item :: value):
  #|  let state = context! as set_equal_context
  #|  if !state.equal:
  #|    return
  #|  if !set_contains(state.right, item):
  #|    state.equal = false
  #|
  #|// Ordered collections compare in encounter order, which is what makes them
  #|// distinct from their unordered counterparts rather than a view of them.
  #|fn ordered_map_equal(left :: ordered_map_value, right :: ordered_map_value) -> bool:
  #|  if ordered_map_count(left) != ordered_map_count(right):
  #|    return false
  #|  var left_cursor = 0
  #|  var right_cursor = 0
  #|  var matched = 0
  #|  while matched < ordered_map_count(left):
  #|    let (left_next, left_entry) = store_next(left.value, left_cursor)
  #|    let (right_next, right_entry) = store_next(right.value, right_cursor)
  #|    left_cursor = left_next
  #|    right_cursor = right_next
  #|    if left_entry == null:
  #|      return false
  #|    if right_entry == null:
  #|      return false
  #|    if !utf8.equal(left_entry!.key as utf8.string, right_entry!.key as utf8.string):
  #|      return false
  #|    if !equal(left_entry!.value! as value, right_entry!.value! as value):
  #|      return false
  #|    matched += 1
  #|  true
  #|
  #|fn ordered_set_equal(left :: ordered_set_value, right :: ordered_set_value) -> bool:
  #|  if ordered_set_count(left) != ordered_set_count(right):
  #|    return false
  #|  var left_cursor = 0
  #|  var right_cursor = 0
  #|  var matched = 0
  #|  while matched < ordered_set_count(left):
  #|    let (left_next, left_entry) = store_next(left.value, left_cursor)
  #|    let (right_next, right_entry) = store_next(right.value, right_cursor)
  #|    left_cursor = left_next
  #|    right_cursor = right_next
  #|    if left_entry == null:
  #|      return false
  #|    if right_entry == null:
  #|      return false
  #|    if !equal(left_entry!.key as value, right_entry!.key as value):
  #|      return false
  #|    matched += 1
  #|  true
  #|
  #|// Structural. Numeric kinds stay distinct, and floats compare bit patterns, so
  #|// NaN equals itself and 0.0 does not equal -0.0.
  #|pub fn equal(left :: value, right :: value) -> bool:
  #|  if left == right:
  #|    return true
  #|  if left.kind != right.kind:
  #|    return false
  #|  match left
  #|  | _ :: null_value: return true
  #|  | a :: bool_value: return a.value == (right as bool_value).value
  #|  | a :: string_value: return utf8.equal(a.value, (right as string_value).value)
  #|  | a :: i32_value: return a.value == (right as i32_value).value
  #|  | a :: i64_value: return a.value == (right as i64_value).value
  #|  | a :: f32_value:
  #|      return a.value.to_bits() == (right as f32_value).value.to_bits()
  #|  | a :: f64_value:
  #|      return a.value.to_bits() == (right as f64_value).value.to_bits()
  #|  | a :: vector_value:
  #|      let b = right as vector_value
  #|      if vector_count(a) != vector_count(b):
  #|        return false
  #|      for i in 0 ..< vector_count(a):
  #|        if !equal(vector_at(a, i), vector_at(b, i)):
  #|          return false
  #|      return true
  #|  | a :: map_value:
  #|      let b = right as map_value
  #|      if map_count(a) != map_count(b):
  #|        return false
  #|      let state = map_equal_context{right: b, equal: true}
  #|      map_each(a, state, map_equal_entry)
  #|      return state.equal
  #|  | a :: any_value: return any_equal(a.value, (right as any_value).value)
  #|  | a :: set_value:
  #|      let b = right as set_value
  #|      if set_count(a) != set_count(b):
  #|        return false
  #|      let state = set_equal_context{right: b, equal: true}
  #|      set_each(a, state, set_equal_entry)
  #|      return state.equal
  #|  | a :: ordered_map_value:
  #|      return ordered_map_equal(a, right as ordered_map_value)
  #|  | a :: ordered_set_value:
  #|      return ordered_set_equal(a, right as ordered_set_value)
  #|  | a :: record_value: return record_equal(a, right as record_value)
  #|  | _: unreachable
  #|  unreachable
  #|
  #|// ------------------------------------------------------------------ hashing
  #|
  #|fn hash_tag(k :: i32) -> u32:
  #|  hashing.i32_seeded(k, 0x4a56414c)
  #|
  #|type hash_unordered_context = {
  #|  sum :: mut u32,
  #|  xor :: mut u32,
  #|}
  #|
  #|// Map and set hashing has to be order independent, so the per-entry hashes are
  #|// combined with operations that commute.
  #|fn hash_unordered_add(state :: hash_unordered_context, h :: u32):
  #|  state.sum = state.sum + h * 0x9e3779b1
  #|  state.xor = state.xor ^ h.rotl(h & 31)
  #|
  #|fn hash_map_entry(context :: eq?, key :: utf8.string, item :: value):
  #|  let state = context! as hash_unordered_context
  #|  let combined = hashing.add_i32(utf8.hash(key), hash(item))
  #|  hash_unordered_add(state, hashing.finalize(combined, 8))
  #|
  #|fn hash_set_entry(context :: eq?, item :: value):
  #|  hash_unordered_add(context! as hash_unordered_context, hash(item))
  #|
  #|fn hash_ordered_map(v :: ordered_map_value) -> u32:
  #|  var state = hash_tag(kind_ordered_map)
  #|  var cursor = 0
  #|  while cursor < persistent_vector.count(v.value.entries):
  #|    let (next, e) = store_next(v.value, cursor)
  #|    cursor = next
  #|    if e != null:
  #|      state = hashing.add_i32(state, utf8.hash(e!.key as utf8.string))
  #|      state = hashing.add_i32(state, hash(e!.value! as value))
  #|  hashing.finalize(state, ordered_map_count(v) * 8)
  #|
  #|fn hash_ordered_set(v :: ordered_set_value) -> u32:
  #|  var state = hash_tag(kind_ordered_set)
  #|  var cursor = 0
  #|  while cursor < persistent_vector.count(v.value.entries):
  #|    let (next, e) = store_next(v.value, cursor)
  #|    cursor = next
  #|    if e != null:
  #|      state = hashing.add_i32(state, hash(e!.key as value))
  #|  hashing.finalize(state, ordered_set_count(v) * 4)
  #|
  #|pub fn hash(v :: value) -> u32:
  #|  match v
  #|  | _ :: null_value: return hash_tag(kind_null)
  #|  | found :: bool_value:
  #|      let bit = if found.value | 1 | 0
  #|      return hashing.i32_seeded(bit, hash_tag(kind_bool))
  #|  | found :: string_value:
  #|      return hashing.i32_seeded(utf8.hash(found.value), hash_tag(kind_string))
  #|  | found :: i32_value:
  #|      return hashing.i32_seeded(found.value, hash_tag(kind_i32))
  #|  | found :: i64_value:
  #|      let bits = found.value
  #|      let state = hashing.add_i32(hash_tag(kind_i64), bits as i32)
  #|      return hashing.finalize(hashing.add_i32(state, (bits as u64 >> 32) as i32), 8)
  #|  | found :: f32_value:
  #|      return hashing.i32_seeded(found.value.to_bits(), hash_tag(kind_f32))
  #|  | found :: f64_value:
  #|      let bits = found.value.to_bits()
  #|      let state = hashing.add_i32(hash_tag(kind_f64), bits as i32)
  #|      return hashing.finalize(hashing.add_i32(state, (bits as u64 >> 32) as i32), 8)
  #|  | found :: vector_value:
  #|      var state = hash_tag(kind_vector)
  #|      for i in 0 ..< vector_count(found):
  #|        state = hashing.add_i32(state, hash(vector_at(found, i)))
  #|      return hashing.finalize(state, vector_count(found) * 4)
  #|  | found :: map_value:
  #|      let state = hash_unordered_context{sum: 0, xor: 0}
  #|      map_each(found, state, hash_map_entry)
  #|      let combined = hashing.add_i32(hash_tag(kind_map), state.sum)
  #|      return hashing.finalize(
  #|        hashing.add_i32(combined, state.xor),
  #|        map_count(found) * 8,
  #|      )
  #|  | _ :: any_value:
  #|      // WebAssembly exposes reference equality but no stable identity hash. A
  #|      // constant preserves equal-implies-same-hash; many opaque values collide.
  #|      return hash_tag(kind_any)
  #|  | found :: set_value:
  #|      let state = hash_unordered_context{sum: 0, xor: 0}
  #|      set_each(found, state, hash_set_entry)
  #|      let combined = hashing.add_i32(hash_tag(kind_set), state.sum)
  #|      return hashing.finalize(
  #|        hashing.add_i32(combined, state.xor),
  #|        set_count(found) * 4,
  #|      )
  #|  | found :: ordered_map_value: return hash_ordered_map(found)
  #|  | found :: ordered_set_value: return hash_ordered_set(found)
  #|  | found :: record_value: return record_hash(found)
  #|  | _: unreachable
  #|  unreachable
  #|
  #|// ------------------------------------------------------- records, the parts
  #|// that close the loop with `data/record.wap`.
  #|
  #|pub fn record_to_map(r :: record_value) -> map_value:
  #|  map_value{kind: kind_map, value: r.values}
  #|
  #|pub fn record_equal(left :: record_value, right :: record_value) -> bool:
  #|  if left.definition != right.definition:
  #|    return false
  #|  equal(record_to_map(left), record_to_map(right))
  #|
  #|pub fn record_hash(r :: record_value) -> u32:
  #|  let state = hashing.add_i32(hash_tag(kind_record), utf8.hash(r.definition.name))
  #|  hashing.add_i32(state, hash(record_to_map(r)))

///|
let text_utf8_wap : String =
  #|// Owned UTF-8 strings, ported from `stdlib/text/utf8.wax`.
  #|//
  #|// Construction validates and copies. The copy is not a policy choice: a
  #|// WebAssembly GC array cannot be filled dynamically once it is declared
  #|// immutable, so the type owns a mutable byte array and never lets it out. The
  #|// .wax file says to treat `storage_internal` as opaque after vendoring; here
  #|// the module says it, because a field of a `pub type` is still only reachable
  #|// through this module's own functions.
  #|//
  #|// One shape from the original could not be carried over. Wax has labelled
  #|// blocks, and the validator uses one as a `switch`:
  #|//
  #|//     'unit: do {
  #|//       if first <=u 0x7f { i += 1; br 'unit; }
  #|//       ...
  #|//     }
  #|//
  #|// wap has labelled `break` and `continue` but no labelled block, so each of
  #|// those becomes an arm of a multi-arm `if`, which is what the block was
  #|// standing in for. The arms are in the same order and the bounds are the same
  #|// ones -- Unicode Table 3-7's well-formed byte ranges.
  #|
  #|module utf8
  #|
  #|import collections.hashing
  #|
  #|type visit = fn(eq?, i32, i32, u32)
  #|
  #|pub type string = {
  #|  storage_internal :: hashing.bytes,
  #|  byte_length :: i32,
  #|  codepoint_length :: i32,
  #|  hash :: u32,
  #|}
  #|
  #|fn continuation(byte :: u32) -> bool:
  #|  if byte < 0x80:
  #|    return false
  #|  if byte > 0xbf:
  #|    return false
  #|  true
  #|
  #|// The answer is `(well_formed, codepoints)`: one pass decides both, and a
  #|// caller that has already validated does not pay for a second walk.
  #|fn validate(data :: hashing.bytes) -> (bool, i32):
  #|  var i = 0
  #|  var count = 0
  #|  let length = data.len()
  #|  while i < length:
  #|    let first :: u32 = data[i]
  #|    if
  #|    | first <= 0x7f:
  #|        i += 1
  #|    | first <= 0xc1:
  #|        return (false, 0)
  #|    | first <= 0xdf:
  #|        if i + 1 >= length:
  #|          return (false, 0)
  #|        if !continuation(data[i + 1]):
  #|          return (false, 0)
  #|        i += 2
  #|    | first <= 0xef:
  #|        if i + 2 >= length:
  #|          return (false, 0)
  #|        let second :: u32 = data[i + 1]
  #|        if !continuation(second):
  #|          return (false, 0)
  #|        if !continuation(data[i + 2]):
  #|          return (false, 0)
  #|        if first == 0xe0:
  #|          if second < 0xa0:
  #|            return (false, 0)
  #|        if first == 0xed:
  #|          if second > 0x9f:
  #|            return (false, 0)
  #|        i += 3
  #|    | first <= 0xf4:
  #|        if i + 3 >= length:
  #|          return (false, 0)
  #|        let second :: u32 = data[i + 1]
  #|        if !continuation(second):
  #|          return (false, 0)
  #|        if !continuation(data[i + 2]):
  #|          return (false, 0)
  #|        if !continuation(data[i + 3]):
  #|          return (false, 0)
  #|        if first == 0xf0:
  #|          if second < 0x90:
  #|            return (false, 0)
  #|        if first == 0xf4:
  #|          if second > 0x8f:
  #|            return (false, 0)
  #|        i += 4
  #|    | _:
  #|        return (false, 0)
  #|    count += 1
  #|  (true, count)
  #|
  #|fn copy_storage(data :: hashing.bytes, start :: i32, length :: i32) -> hashing.bytes:
  #|  let out = hashing.bytes_new(length)
  #|  if length != 0:
  #|    out.copy(0, data, start, length)
  #|  out
  #|
  #|fn new_valid(data :: hashing.bytes, codepoints :: i32) -> string:
  #|  let owned = copy_storage(data, 0, data.len())
  #|  string{
  #|    storage_internal: owned,
  #|    byte_length: owned.len(),
  #|    codepoint_length: codepoints,
  #|    hash: hashing.bytes_value(owned),
  #|  }
  #|
  #|export "utf8_try_from_bytes" pub fn try_from_bytes(data :: hashing.bytes) -> (bool, string?):
  #|  let (valid, codepoints) = validate(data)
  #|  if !valid:
  #|    return (false, null)
  #|  (true, new_valid(data, codepoints))
  #|
  #|export "utf8_from_bytes" pub fn from_bytes(data :: hashing.bytes) -> string:
  #|  let (valid, value) = try_from_bytes(data)
  #|  if !valid:
  #|    unreachable
  #|  value!
  #|
  #|export "utf8_empty" pub fn empty() -> string:
  #|  new_valid(hashing.bytes_new(0), 0)
  #|
  #|export "utf8_copy_bytes" pub fn copy_bytes(value :: string) -> hashing.bytes:
  #|  copy_storage(value.storage_internal, 0, value.byte_length)
  #|
  #|export "utf8_byte_length" pub fn byte_length(value :: string) -> i32:
  #|  value.byte_length
  #|
  #|export "utf8_codepoint_length" pub fn codepoint_length(value :: string) -> i32:
  #|  value.codepoint_length
  #|
  #|export "utf8_is_empty" pub fn is_empty(value :: string) -> bool:
  #|  value.byte_length == 0
  #|
  #|export "utf8_get_byte" pub fn get_byte(value :: string, index :: i32) -> (bool, u32):
  #|  if index < 0:
  #|    return (false, 0)
  #|  if index >= value.byte_length:
  #|    return (false, 0)
  #|  (true, value.storage_internal[index])
  #|
  #|export "utf8_at_byte" pub fn at_byte(value :: string, index :: i32) -> u32:
  #|  let (found, byte) = get_byte(value, index)
  #|  if !found:
  #|    unreachable
  #|  byte
  #|
  #|// The hash is cached, so an inequality is usually one comparison. It is
  #|// MurmurHash3 and not cryptographic.
  #|export "utf8_equal" pub fn equal(left :: string, right :: string) -> bool:
  #|  if left == right:
  #|    return true
  #|  if left.hash != right.hash:
  #|    return false
  #|  if left.byte_length != right.byte_length:
  #|    return false
  #|  for i in 0 ..< left.byte_length:
  #|    if left.storage_internal[i] != right.storage_internal[i]:
  #|      return false
  #|  true
  #|
  #|export "utf8_compare" pub fn compare(left :: string, right :: string) -> i32:
  #|  let length = if left.byte_length < right.byte_length
  #|  | left.byte_length
  #|  | right.byte_length
  #|  for i in 0 ..< length:
  #|    let a :: u32 = left.storage_internal[i]
  #|    let b :: u32 = right.storage_internal[i]
  #|    if a < b:
  #|      return -1
  #|    if a > b:
  #|      return 1
  #|  if left.byte_length < right.byte_length:
  #|    return -1
  #|  if left.byte_length > right.byte_length:
  #|    return 1
  #|  0
  #|
  #|export "utf8_hash" pub fn hash(value :: string) -> u32:
  #|  value.hash
  #|
  #|pub fn hash_key(key :: eq) -> u32:
  #|  hash(key as string)
  #|
  #|pub fn equal_key(left :: eq, right :: eq) -> bool:
  #|  equal(left as string, right as string)
  #|
  #|export "utf8_concat" pub fn concat(left :: string, right :: string) -> string:
  #|  if left.byte_length == 0:
  #|    return right
  #|  if right.byte_length == 0:
  #|    return left
  #|  if left.byte_length > 0x7fffffff - right.byte_length:
  #|    unreachable
  #|  let length = left.byte_length + right.byte_length
  #|  let storage = hashing.bytes_new(length)
  #|  storage.copy(0, left.storage_internal, 0, left.byte_length)
  #|  storage.copy(left.byte_length, right.storage_internal, 0, right.byte_length)
  #|  string{
  #|    storage_internal: storage,
  #|    byte_length: length,
  #|    codepoint_length: left.codepoint_length + right.codepoint_length,
  #|    hash: hashing.bytes_value(storage),
  #|  }
  #|
  #|// A slice is taken in bytes but refuses to cut a code point in half, so an
  #|// offset has to land on a boundary at both ends.
  #|export "utf8_is_boundary" pub fn is_boundary(value :: string, offset :: i32) -> bool:
  #|  if offset < 0:
  #|    return false
  #|  if offset > value.byte_length:
  #|    return false
  #|  if offset == 0:
  #|    return true
  #|  if offset == value.byte_length:
  #|    return true
  #|  !continuation(value.storage_internal[offset])
  #|
  #|export "utf8_try_slice_bytes" pub fn try_slice_bytes(
  #|  value :: string,
  #|  start :: i32,
  #|  length :: i32,
  #|) -> (bool, string?):
  #|  if start < 0:
  #|    return (false, null)
  #|  if length < 0:
  #|    return (false, null)
  #|  if start > value.byte_length:
  #|    return (false, null)
  #|  if length > value.byte_length - start:
  #|    return (false, null)
  #|  let end = start + length
  #|  if !is_boundary(value, start):
  #|    return (false, null)
  #|  if !is_boundary(value, end):
  #|    return (false, null)
  #|  if start == 0:
  #|    if length == value.byte_length:
  #|      return (true, value)
  #|  let storage = copy_storage(value.storage_internal, start, length)
  #|  let (_, codepoints) = validate(storage)
  #|  (true, new_valid(storage, codepoints))
  #|
  #|export "utf8_slice_bytes" pub fn slice_bytes(
  #|  value :: string,
  #|  start :: i32,
  #|  length :: i32,
  #|) -> string:
  #|  let (valid, slice) = try_slice_bytes(value, start, length)
  #|  if !valid:
  #|    unreachable
  #|  slice!
  #|
  #|export "utf8_each_codepoint" pub fn each_codepoint(
  #|  value :: string,
  #|  context :: eq?,
  #|  seen :: visit,
  #|):
  #|  var offset = 0
  #|  var index = 0
  #|  while offset < value.byte_length:
  #|    let first :: u32 = value.storage_internal[offset]
  #|    var scalar :: u32 = 0
  #|    var width = 0
  #|    if
  #|    | first <= 0x7f:
  #|        scalar = first
  #|        width = 1
  #|    | first <= 0xdf:
  #|        scalar = (first & 0x1f) << 6 || (value.storage_internal[offset + 1] & 0x3f)
  #|        width = 2
  #|    | first <= 0xef:
  #|        scalar = (first & 0x0f) << 12
  #|          || (value.storage_internal[offset + 1] & 0x3f) << 6
  #|          || (value.storage_internal[offset + 2] & 0x3f)
  #|        width = 3
  #|    | _:
  #|        scalar = (first & 0x07) << 18
  #|          || (value.storage_internal[offset + 1] & 0x3f) << 12
  #|          || (value.storage_internal[offset + 2] & 0x3f) << 6
  #|          || (value.storage_internal[offset + 3] & 0x3f)
  #|        width = 4
  #|    seen(context, index, offset, scalar)
  #|    offset += width
  #|    index += 1

///|
/// Every ported module, under the path its importers name it by.
fn stdlib_loader() -> @resolve.MapLoader {
  @resolve.MapLoader::new(entries=[
    ("collections.example", collections_example_wap),
    ("collections.hashing", collections_hashing_wap),
    ("collections.persistent_hash_map", collections_persistent_hash_map_wap),
    ("collections.persistent_hash_set", collections_persistent_hash_set_wap),
    ("collections.persistent_vector", collections_persistent_vector_wap),
    ("data.immutable_value", data_immutable_value_wap),
    ("text.utf8", text_utf8_wap),
  ])
}

///|
/// Compile one module, and everything it imports, to wat.
fn stdlib_wat(path : String, src : String) -> String raise @compile.CompileError {
  match @wap.compile_program_to_wat(path, src, stdlib_loader()) {
    Ok(w) => w
    Err(d) => {
      let sb = StringBuilder()
      for r in d.wap {
        sb.write_string("wap: " + r.message + "\n")
      }
      let sink = @diagnostic.buffer_sink(sb)
      let theme = @diagnostic.get_theme(is_tty=false)
      for r in d.wax {
        @diagnostic.output_error(sink, theme, Human, Some(src), r)
      }
      "FAILED\n" + sb.to_string()
    }
  }
}

///|
test "the collections.example stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.example", collections_example_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.example did not compile")
  }
  assert_true(w.contains("\"collections_example\""))
}

///|
test "the collections.hashing stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.hashing", collections_hashing_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.hashing did not compile")
  }
  // The module supplies the prefix the .wax file writes by hand.
  assert_true(w.contains("$hashing__mix_i32"))
  // `u32` chose the logical shift with no `>>u` in the source.
  assert_true(w.contains("i32.shr_u"))
  assert_true(w.contains("i32.rotl"))
  assert_true(w.contains("array.get_u"))
}

///|
test "the collections.persistent_hash_map stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.persistent_hash_map", collections_persistent_hash_map_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.persistent_hash_map did not compile")
  }
  assert_true(w.contains("$persistent_hash_map__node_assoc"))
  assert_true(w.contains("i32.popcnt"))
  // A callback reaches `each` without a cast; see the rec-group tests.
  assert_true(!w.contains("ref.cast (ref $persistent_hash_map__visit)"))
}

///|
test "the collections.persistent_hash_set stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.persistent_hash_set", collections_persistent_hash_set_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.persistent_hash_set did not compile")
  }
  // The set reaches the map by name rather than by concatenation.
  assert_true(w.contains("$persistent_hash_set__union"))
  assert_true(w.contains("$persistent_hash_map__assoc"))
}

///|
test "the collections.persistent_vector stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("collections.persistent_vector", collections_persistent_vector_wap)
  if w.contains("FAILED") {
    println(w)
    fail("collections.persistent_vector did not compile")
  }
  assert_true(w.contains("$persistent_vector__push"))
  // The wasm export name is an ABI and is left alone.
  assert_true(w.contains("\"pv_empty\""))
}

///|
test "the data.immutable_value stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("data.immutable_value", data_immutable_value_wap)
  if w.contains("FAILED") {
    println(w)
    fail("data.immutable_value did not compile")
  }
  // The module is called `jv`, not the file it lives in.
  assert_true(w.contains("$jv__equal"))
  // The three functions that close the loop with `data/record` live here.
  assert_true(w.contains("$jv__record_equal"))
  assert_true(w.contains("$persistent_hash_map__assoc"))
}

///|
test "the text.utf8 stdlib module, ported to wap, compiles" {
  let w = stdlib_wat("text.utf8", text_utf8_wap)
  if w.contains("FAILED") {
    println(w)
    fail("text.utf8 did not compile")
  }
  assert_true(w.contains("$utf8__validate"))
  // The hash is the one from `collections.hashing`, not a copy of it.
  assert_true(w.contains("$hashing__bytes_value"))
}
