// A persistent hash map: the HAMT, ported from
// `stdlib/collections/persistent_hash_map.wax`.
//
// The .wax original opens by explaining its own name:
//
//   This file is deliberately standalone and uses a phm_/phmt_ prefix because
//   Wax modules do not have source namespaces.
//
// Here the module supplies the prefix and the names are `empty`, `assoc`,
// `get`. The wasm export names keep the `phm_` spelling, because those are an
// ABI rather than an identifier and a consumer already linking against them
// should not have to change.
//
// Three other things read differently from the original, and all three are the
// type saying what the operator had to say in Wax:
//
//   * A hash is `u32`, so `>>` is the logical shift and `<` is the unsigned
//     comparison. The .wax file writes `>>u` and `<u` on an `i32`.
//   * `||` is bitwise or on those, not logical: shrubbery's `|` introduces
//     alternatives, so `||` carries both meanings and the operand type decides.
//   * A predicate returns `bool`. Wax has no `bool`, so the original returns
//     `i32` and compares it against 0 at every call site.
//
// The transient half is here too. It is the same HAMT with the copying turned
// off: a builder owns an `edit` token, a node that already carries that token
// is written in place rather than copied, and `persistent` clears the token so
// that a builder used after freezing traps instead of writing into the value it
// handed out.

module persistent_hash_map

type hash_fn = fn(eq) -> u32
type equal_fn = fn(eq, eq) -> bool
type visit = fn(eq?, eq?, eq?)

type edit = { active :: mut i32 }
type slots = [eq?]

type node = { edit :: mut edit? }

type bitmap_node :: node = {
  bitmap :: mut u32,
  slots :: mut slots,
}

type node_slots = [node?]

type array_node :: node = {
  count :: mut i32,
  children :: mut node_slots,
}

type collision_node :: node = {
  hash :: u32,
  count :: mut i32,
  slots :: mut slots,
}

pub type map = {
  count :: i32,
  root :: node?,
  has_null :: bool,
  null_value :: eq?,
  hash :: hash_fn,
  equal :: equal_fn,
}

fn bitpos(hash :: u32, shift :: u32) -> u32:
  1 << ((hash >> shift) & 31)

fn bitmap_index(bitmap :: u32, bit :: u32) -> i32:
  (bitmap && (bit - 1)).popcnt()

fn copy_slots(src :: slots, length :: i32) -> slots:
  let dst = slots[null ** length]
  let n = if src.len() < length | src.len() | length
  if n != 0:
    dst.copy(0, src, 0, n)
  dst

fn insert_pair(src :: slots, at :: i32, key :: eq?, value :: eq?) -> slots:
  let n = src.len()
  let dst = slots[null ** (n + 2)]
  if at != 0:
    dst.copy(0, src, 0, at)
  dst[at] = key
  dst[at + 1] = value
  if at != n:
    dst.copy(at + 2, src, at, n - at)
  dst

fn remove_pair(src :: slots, at :: i32) -> slots:
  let n = src.len()
  let dst = slots[null ** (n - 2)]
  if at != 0:
    dst.copy(0, src, 0, at)
  if at + 2 != n:
    dst.copy(at, src, at + 2, n - at - 2)
  dst

fn bitmap(owner :: edit?, bits :: u32, entries :: slots) -> node:
  bitmap_node{edit: owner, bitmap: bits, slots: entries}

fn array(owner :: edit?, count :: i32, children :: node_slots) -> node:
  array_node{edit: owner, count: count, children: children}

fn collision(owner :: edit?, hash :: u32, count :: i32, entries :: slots) -> node:
  collision_node{edit: owner, hash: hash, count: count, slots: entries}

fn singleton_at(shift :: u32, hash :: u32, key :: eq, value :: eq?) -> node:
  bitmap(null, bitpos(hash, shift), slots[key, value])

fn merge_two(
  shift :: u32,
  hash1 :: u32,
  key1 :: eq,
  value1 :: eq?,
  hash2 :: u32,
  key2 :: eq,
  value2 :: eq?,
) -> node:
  if hash1 == hash2:
    return collision(null, hash1, 2, slots[key1, value1, key2, value2])
  let bit1 = bitpos(hash1, shift)
  let bit2 = bitpos(hash2, shift)
  if bit1 == bit2:
    let child = merge_two(shift + 5, hash1, key1, value1, hash2, key2, value2)
    return bitmap(null, bit1, slots[null, child])
  if bit1 < bit2
  | bitmap(null, bit1 || bit2, slots[key1, value1, key2, value2])
  | bitmap(null, bit1 || bit2, slots[key2, value2, key1, value1])

fn node_get(
  n :: node,
  shift :: u32,
  hash :: u32,
  key :: eq,
  equal :: equal_fn,
) -> (bool, eq?):
  match n
  | b :: bitmap_node:
      let bit = bitpos(hash, shift)
      if (b.bitmap && bit) == 0:
        return (false, null)
      let at = bitmap_index(b.bitmap, bit) * 2
      let found_key = b.slots[at]
      if found_key == null:
        return node_get(b.slots[at + 1] as node, shift + 5, hash, key, equal)
      if equal(found_key!, key):
        return (true, b.slots[at + 1])
      return (false, null)
  | a :: array_node:
      let child = a.children[(hash >> shift) & 31]
      if child == null:
        return (false, null)
      return node_get(child!, shift + 5, hash, key, equal)
  | c :: collision_node:
      if c.hash != hash:
        return (false, null)
      for i in 0 ..< c.count:
        let at = i * 2
        if equal(c.slots[at]!, key):
          return (true, c.slots[at + 1])
      return (false, null)
  | _: unreachable
  unreachable

// A bitmap node with sixteen entries becomes an array node: past that, the
// packed representation costs more to copy than the sparse one costs to hold.
fn promote(
  n :: bitmap_node,
  shift :: u32,
  hash :: u32,
  key :: eq,
  value :: eq?,
  hash_of :: hash_fn,
) -> node:
  let children = node_slots[null ** 32]
  var slot = 0
  for branch in 0 ..< 32:
    let bit :: u32 = 1 << branch
    if (n.bitmap && bit) != 0:
      let old_key = n.slots[slot]
      if old_key == null
      | children[branch] = n.slots[slot + 1] as node
      | children[branch] = singleton_at(
          shift + 5,
          hash_of(old_key!),
          old_key!,
          n.slots[slot + 1],
        )
      slot += 2
  let index = (hash >> shift) & 31
  children[index] = singleton_at(shift + 5, hash, key, value)
  array(null, 17, children)

fn node_assoc(
  n :: node?,
  shift :: u32,
  hash :: u32,
  key :: eq,
  value :: eq?,
  hash_of :: hash_fn,
  equal :: equal_fn,
) -> (node, i32):
  if n == null:
    return (singleton_at(shift, hash, key, value), 1)
  match n!
  | b :: bitmap_node:
      let bit = bitpos(hash, shift)
      let at = bitmap_index(b.bitmap, bit) * 2
      if (b.bitmap && bit) == 0:
        if b.bitmap.popcnt() >= 16:
          return (promote(b, shift, hash, key, value, hash_of), 1)
        return (bitmap(null, b.bitmap || bit, insert_pair(b.slots, at, key, value)), 1)
      let old_key = b.slots[at]
      if old_key == null:
        let (child, added) = node_assoc(
          b.slots[at + 1] as node,
          shift + 5,
          hash,
          key,
          value,
          hash_of,
          equal,
        )
        if child == b.slots[at + 1]:
          return (b, added)
        let entries = copy_slots(b.slots, b.slots.len())
        entries[at + 1] = child
        return (bitmap(null, b.bitmap, entries), added)
      if equal(old_key!, key):
        if b.slots[at + 1] == value:
          return (b, 0)
        let entries = copy_slots(b.slots, b.slots.len())
        entries[at + 1] = value
        return (bitmap(null, b.bitmap, entries), 0)
      let child = merge_two(
        shift + 5,
        hash_of(old_key!),
        old_key!,
        b.slots[at + 1],
        hash,
        key,
        value,
      )
      let entries = copy_slots(b.slots, b.slots.len())
      entries[at] = null
      entries[at + 1] = child
      return (bitmap(null, b.bitmap, entries), 1)
  | a :: array_node:
      let index = (hash >> shift) & 31
      let old = a.children[index]
      let (child, added) = node_assoc(old, shift + 5, hash, key, value, hash_of, equal)
      if old == child:
        return (a, added)
      let children = node_slots[null ** 32]
      children.copy(0, a.children, 0, 32)
      children[index] = child
      let child_delta = if old == null | 1 | 0
      return (array(null, a.count + child_delta, children), added)
  | c :: collision_node:
      if c.hash != hash:
        let bit1 = bitpos(c.hash, shift)
        let bit2 = bitpos(hash, shift)
        if bit1 == bit2:
          let (child, _) = node_assoc(c, shift + 5, hash, key, value, hash_of, equal)
          return (bitmap(null, bit1, slots[null, child]), 1)
        if bit1 < bit2:
          return (bitmap(null, bit1 || bit2, slots[null, c, key, value]), 1)
        return (bitmap(null, bit1 || bit2, slots[key, value, null, c]), 1)
      for i in 0 ..< c.count:
        let at = i * 2
        if equal(c.slots[at]!, key):
          if c.slots[at + 1] == value:
            return (c, 0)
          let entries = copy_slots(c.slots, c.slots.len())
          entries[at + 1] = value
          return (collision(null, hash, c.count, entries), 0)
      return (
        collision(null, hash, c.count + 1, insert_pair(c.slots, c.slots.len(), key, value)),
        1,
      )
  | _: unreachable
  unreachable

// An array node that has shrunk back below nine children becomes a bitmap node
// again, so a map that grew and shrank does not keep paying for the wide one.
fn pack_array(n :: array_node, removed_index :: i32) -> node?:
  var bits :: u32 = 0
  let entries = slots[null ** ((n.count - 1) * 2)]
  var out = 0
  for i in 0 ..< 32:
    let child = n.children[i]
    if i != removed_index:
      if child != null:
        bits ||= 1 << i
        entries[out] = null
        entries[out + 1] = child
        out += 2
  if bits == 0:
    return null
  bitmap(null, bits, entries)

fn node_dissoc(
  n :: node,
  shift :: u32,
  hash :: u32,
  key :: eq,
  equal :: equal_fn,
) -> (node?, bool):
  match n
  | b :: bitmap_node:
      let bit = bitpos(hash, shift)
      if (b.bitmap && bit) == 0:
        return (b, false)
      let at = bitmap_index(b.bitmap, bit) * 2
      let old_key = b.slots[at]
      if old_key == null:
        let (child, removed) = node_dissoc(
          b.slots[at + 1] as node,
          shift + 5,
          hash,
          key,
          equal,
        )
        if !removed:
          return (b, false)
        if child == null:
          if b.bitmap == bit:
            return (null, true)
          return (bitmap(null, b.bitmap ^ bit, remove_pair(b.slots, at)), true)
        let entries = copy_slots(b.slots, b.slots.len())
        entries[at + 1] = child
        return (bitmap(null, b.bitmap, entries), true)
      if !equal(old_key!, key):
        return (b, false)
      if b.bitmap == bit:
        return (null, true)
      return (bitmap(null, b.bitmap ^ bit, remove_pair(b.slots, at)), true)
  | a :: array_node:
      let index = (hash >> shift) & 31
      let old = a.children[index]
      if old == null:
        return (a, false)
      let (child, removed) = node_dissoc(old!, shift + 5, hash, key, equal)
      if !removed:
        return (a, false)
      if child == null:
        if a.count <= 9:
          return (pack_array(a, index), true)
      let children = node_slots[null ** 32]
      children.copy(0, a.children, 0, 32)
      children[index] = child
      let delta = if child == null | 1 | 0
      return (array(null, a.count - delta, children), true)
  | c :: collision_node:
      if c.hash != hash:
        return (c, false)
      for i in 0 ..< c.count:
        let at = i * 2
        if equal(c.slots[at]!, key):
          if c.count == 1:
            return (null, true)
          if c.count == 2:
            let keep = if at == 0 | 2 | 0
            return (singleton_at(shift, hash, c.slots[keep]!, c.slots[keep + 1]), true)
          return (collision(null, hash, c.count - 1, remove_pair(c.slots, at)), true)
      return (c, false)
  | _: unreachable
  unreachable

fn node_each(n :: node, context :: eq?, seen :: visit):
  match n
  | b :: bitmap_node:
      var i = 0
      while i < b.slots.len() by 2:
        let key = b.slots[i]
        if key == null
        | node_each(b.slots[i + 1] as node, context, seen)
        | seen(context, key, b.slots[i + 1])
      return
  | a :: array_node:
      for i in 0 ..< 32:
        if a.children[i] != null:
          node_each(a.children[i]!, context, seen)
      return
  | c :: collision_node:
      for i in 0 ..< c.count:
        seen(context, c.slots[i * 2], c.slots[i * 2 + 1])
      return
  | _: unreachable

export "phm_empty" pub fn empty(hash :: hash_fn, equal :: equal_fn) -> map:
  map{count: 0, root: null, has_null: false, null_value: null, hash: hash, equal: equal}

export "phm_count" pub fn count(m :: map) -> i32:
  m.count

export "phm_get" pub fn get(m :: map, key :: eq?) -> (bool, eq?):
  if key == null:
    return (m.has_null, m.null_value)
  if m.root == null:
    return (false, null)
  node_get(m.root!, 0, m.hash(key!), key!, m.equal)

export "phm_contains" pub fn contains(m :: map, key :: eq?) -> bool:
  let (found, _) = get(m, key)
  found

export "phm_assoc" pub fn assoc(m :: map, key :: eq?, value :: eq?) -> map:
  if key == null:
    if m.has_null:
      if m.null_value == value:
        return m
    let grew = if m.has_null | 0 | 1
    return map{
      count: m.count + grew,
      root: m.root,
      has_null: true,
      null_value: value,
      hash: m.hash,
      equal: m.equal,
    }
  if m.count == 0x7fffffff:
    unreachable
  let (root, added) = node_assoc(m.root, 0, m.hash(key!), key!, value, m.hash, m.equal)
  if root == m.root:
    return m
  map{
    count: m.count + added,
    root: root,
    has_null: m.has_null,
    null_value: m.null_value,
    hash: m.hash,
    equal: m.equal,
  }

export "phm_dissoc" pub fn dissoc(m :: map, key :: eq?) -> map:
  if key == null:
    if !m.has_null:
      return m
    return map{
      count: m.count - 1,
      root: m.root,
      has_null: false,
      null_value: null,
      hash: m.hash,
      equal: m.equal,
    }
  if m.root == null:
    return m
  let (root, removed) = node_dissoc(m.root!, 0, m.hash(key!), key!, m.equal)
  if !removed:
    return m
  map{
    count: m.count - 1,
    root: root,
    has_null: m.has_null,
    null_value: m.null_value,
    hash: m.hash,
    equal: m.equal,
  }

export "phm_each" pub fn each(m :: map, context :: eq?, seen :: visit):
  if m.has_null:
    seen(context, null, m.null_value)
  if m.root != null:
    node_each(m.root!, context, seen)

// ---------------------------------------------------------------- transient

pub type transient = {
  edit :: edit,
  count :: mut i32,
  root :: mut node?,
  has_null :: mut bool,
  null_value :: mut eq?,
  hash :: hash_fn,
  equal :: equal_fn,
}

// Every transient operation starts here. A builder that has been frozen is a
// programming mistake rather than a value, so it traps.
fn require_active(t :: transient):
  if t.edit.active == 0:
    unreachable

// The node this builder is allowed to write into: itself when it already owns
// it, a copy carrying the token otherwise. Ownership is what makes the whole
// structure safe to mutate -- a node the persistent value still points at was
// made by someone else and is never touched.
fn ensure_node(n :: node, owner :: edit) -> node:
  match n
  | b :: bitmap_node:
      if b.edit == owner:
        return b
      return bitmap(owner, b.bitmap, copy_slots(b.slots, b.slots.len()))
  | a :: array_node:
      if a.edit == owner:
        return a
      let children = node_slots[null ** 32]
      children.copy(0, a.children, 0, 32)
      return array(owner, a.count, children)
  | c :: collision_node:
      if c.edit == owner:
        return c
      return collision(owner, c.hash, c.count, copy_slots(c.slots, c.slots.len()))
  | _: unreachable
  unreachable

fn t_node_assoc(
  n :: node?,
  shift :: u32,
  hash :: u32,
  key :: eq,
  value :: eq?,
  hash_of :: hash_fn,
  equal :: equal_fn,
  owner :: edit,
) -> (node, i32):
  if n == null:
    let out = singleton_at(shift, hash, key, value)
    out.edit = owner
    return (out, 1)
  let owned = ensure_node(n!, owner)
  match owned
  | b :: bitmap_node:
      let bit = bitpos(hash, shift)
      let at = bitmap_index(b.bitmap, bit) * 2
      if (b.bitmap && bit) == 0:
        if b.bitmap.popcnt() >= 16:
          let promoted = promote(b, shift, hash, key, value, hash_of)
          promoted.edit = owner
          return (promoted, 1)
        b.bitmap = b.bitmap || bit
        b.slots = insert_pair(b.slots, at, key, value)
        return (b, 1)
      let old_key = b.slots[at]
      if old_key == null:
        let (child, added) = t_node_assoc(
          b.slots[at + 1] as node,
          shift + 5,
          hash,
          key,
          value,
          hash_of,
          equal,
          owner,
        )
        b.slots[at + 1] = child
        return (b, added)
      if equal(old_key!, key):
        b.slots[at + 1] = value
        return (b, 0)
      let child = merge_two(
        shift + 5,
        hash_of(old_key!),
        old_key!,
        b.slots[at + 1],
        hash,
        key,
        value,
      )
      b.slots[at] = null
      b.slots[at + 1] = child
      return (b, 1)
  | a :: array_node:
      let index = (hash >> shift) & 31
      let (child, added) = t_node_assoc(
        a.children[index],
        shift + 5,
        hash,
        key,
        value,
        hash_of,
        equal,
        owner,
      )
      if a.children[index] == null:
        a.count = a.count + 1
      a.children[index] = child
      return (a, added)
  | c :: collision_node:
      if c.hash != hash:
        let (out, added) = node_assoc(c, shift, hash, key, value, hash_of, equal)
        out.edit = owner
        return (out, added)
      for i in 0 ..< c.count:
        let at = i * 2
        if equal(c.slots[at]!, key):
          c.slots[at + 1] = value
          return (c, 0)
      c.slots = insert_pair(c.slots, c.slots.len(), key, value)
      c.count = c.count + 1
      return (c, 1)
  | _: unreachable
  unreachable

fn t_node_dissoc(
  n :: node,
  shift :: u32,
  hash :: u32,
  key :: eq,
  equal :: equal_fn,
  owner :: edit,
) -> (node?, bool):
  let owned = ensure_node(n, owner)
  match owned
  | b :: bitmap_node:
      let bit = bitpos(hash, shift)
      if (b.bitmap && bit) == 0:
        return (b, false)
      let at = bitmap_index(b.bitmap, bit) * 2
      let old_key = b.slots[at]
      if old_key == null:
        let (child, removed) = t_node_dissoc(
          b.slots[at + 1] as node,
          shift + 5,
          hash,
          key,
          equal,
          owner,
        )
        if !removed:
          return (b, false)
        if child == null
        | if b.bitmap == bit:
            return (null, true)
          b.bitmap = b.bitmap ^ bit
          b.slots = remove_pair(b.slots, at)
        | b.slots[at + 1] = child
        return (b, true)
      if !equal(old_key!, key):
        return (b, false)
      if b.bitmap == bit:
        return (null, true)
      b.bitmap = b.bitmap ^ bit
      b.slots = remove_pair(b.slots, at)
      return (b, true)
  | a :: array_node:
      let index = (hash >> shift) & 31
      let old = a.children[index]
      if old == null:
        return (a, false)
      let (child, removed) = t_node_dissoc(old!, shift + 5, hash, key, equal, owner)
      if !removed:
        return (a, false)
      if child == null:
        if a.count <= 9:
          let packed = pack_array(a, index)
          if packed != null:
            packed!.edit = owner
          return (packed, true)
        a.count = a.count - 1
      a.children[index] = child
      return (a, true)
  | c :: collision_node:
      if c.hash != hash:
        return (c, false)
      for i in 0 ..< c.count:
        let at = i * 2
        if equal(c.slots[at]!, key):
          if c.count == 1:
            return (null, true)
          if c.count == 2:
            let keep = if at == 0 | 2 | 0
            let out = singleton_at(shift, hash, c.slots[keep]!, c.slots[keep + 1])
            out.edit = owner
            return (out, true)
          c.slots = remove_pair(c.slots, at)
          c.count = c.count - 1
          return (c, true)
      return (c, false)
  | _: unreachable
  unreachable

export "phm_as_transient" pub fn as_transient(m :: map) -> transient:
  transient{
    edit: edit{active: 1},
    count: m.count,
    root: m.root,
    has_null: m.has_null,
    null_value: m.null_value,
    hash: m.hash,
    equal: m.equal,
  }

export "phmt_count" pub fn t_count(t :: transient) -> i32:
  require_active(t)
  t.count

export "phmt_get" pub fn t_get(t :: transient, key :: eq?) -> (bool, eq?):
  require_active(t)
  if key == null:
    return (t.has_null, t.null_value)
  if t.root == null:
    return (false, null)
  node_get(t.root!, 0, t.hash(key!), key!, t.equal)

export "phmt_contains" pub fn t_contains(t :: transient, key :: eq?) -> bool:
  let (found, _) = t_get(t, key)
  found

export "phmt_assoc" pub fn t_assoc(t :: transient, key :: eq?, value :: eq?):
  require_active(t)
  if key == null:
    if !t.has_null:
      t.count = t.count + 1
    t.has_null = true
    t.null_value = value
    return
  if t.count == 0x7fffffff:
    unreachable
  let (root, added) = t_node_assoc(
    t.root,
    0,
    t.hash(key!),
    key!,
    value,
    t.hash,
    t.equal,
    t.edit,
  )
  t.root = root
  t.count = t.count + added

export "phmt_dissoc" pub fn t_dissoc(t :: transient, key :: eq?):
  require_active(t)
  if key == null:
    if t.has_null:
      t.has_null = false
      t.null_value = null
      t.count = t.count - 1
    return
  if t.root == null:
    return
  let (root, removed) = t_node_dissoc(t.root!, 0, t.hash(key!), key!, t.equal, t.edit)
  t.root = root
  if removed:
    t.count = t.count - 1

export "phmt_persistent" pub fn t_persistent(t :: transient) -> map:
  require_active(t)
  t.edit.active = 0
  map{
    count: t.count,
    root: t.root,
    has_null: t.has_null,
    null_value: t.null_value,
    hash: t.hash,
    equal: t.equal,
  }
