// A persistent vector: the bit-partitioned trie, ported from
// `stdlib/collections/persistent_vector.wax`.
//
// The .wax original opens with this comment:
//
//   All names use pv_/pvt_ prefixes because Wax has no source namespaces.
//
// That is the whole difference. Here the names are `node`, `empty`, `push`;
// the module supplies the prefix, and the emitted wasm calls them
// `persistent_vector__node`, `persistent_vector__empty` and so on. Nothing
// else about the data structure changed.
//
// The transient half is here too. It is the same trie with the copying turned
// off: a builder owns an `edit` token, every node it made carries that token,
// and a node that already carries it is written in place instead of being
// copied. `persistent` clears the token, so a builder used after freezing
// traps rather than corrupting the value it handed out.

module persistent_vector

const branching = 32
const shift_bits = 5
const mask = 31

type visit = fn(eq?, i32, eq?)
type edit = { active :: mut i32 }
type slots = [eq?]

type node = {
  edit :: mut edit?,
  slots :: mut slots,
}

pub type vector = {
  count :: i32,
  shift :: i32,
  root :: node,
  tail :: slots,
}

fn node_new(owner :: edit?) -> node:
  node{edit: owner, slots: slots[null ** branching]}

fn copy_slots(src :: slots, length :: i32) -> slots:
  let dst = slots[null ** length]
  let n = if src.len() < length | src.len() | length
  if n != 0:
    dst.copy(0, src, 0, n)
  dst

fn node_copy(n :: node) -> node:
  node{edit: null, slots: copy_slots(n.slots, branching)}

fn tail_offset(count :: i32) -> i32:
  if count < branching:
    return 0
  ((count - 1) >> shift_bits) << shift_bits

fn new_path(level :: i32, n :: node) -> node:
  if level == 0:
    return n
  let parent = node_new(null)
  parent.slots[0] = new_path(level - shift_bits, n)
  parent

fn push_tail(level :: i32, parent :: node, tail_node :: node, index :: i32) -> node:
  let out = node_copy(parent)
  let subidx = (index >> level) & mask
  if level == shift_bits:
    out.slots[subidx] = tail_node
    return out
  let child = parent.slots[subidx]
  if child == null
  | out.slots[subidx] = new_path(level - shift_bits, tail_node)
  | out.slots[subidx] = push_tail(level - shift_bits, child as node, tail_node, index)
  out

fn do_assoc(level :: i32, n :: node, index :: i32, value :: eq?) -> node:
  let out = node_copy(n)
  if level == 0:
    out.slots[index & mask] = value
    return out
  let subidx = (index >> level) & mask
  out.slots[subidx] = do_assoc(level - shift_bits, n.slots[subidx] as node, index, value)
  out

fn array_for(v :: vector, index :: i32) -> slots:
  if index < 0:
    unreachable
  if index >= v.count:
    unreachable
  if index >= tail_offset(v.count):
    return v.tail
  var n = v.root
  var level = v.shift
  while level > 0:
    n = n.slots[(index >> level) & mask] as node
    level -= shift_bits
  n.slots

fn pop_tail(level :: i32, n :: node, index :: i32) -> node?:
  let subidx = (index >> level) & mask
  if level > shift_bits:
    let child = pop_tail(level - shift_bits, n.slots[subidx] as node, index)
    if child == null:
      if subidx == 0:
        return null
    let out = node_copy(n)
    out.slots[subidx] = child
    return out
  if subidx == 0:
    return null
  let out = node_copy(n)
  out.slots[subidx] = null
  out

export "pv_empty" pub fn empty() -> vector:
  vector{count: 0, shift: shift_bits, root: node_new(null), tail: slots[null ** 0]}

export "pv_count" pub fn count(v :: vector) -> i32:
  v.count

pub fn get(v :: vector, index :: i32) -> (bool, eq?):
  if index < 0:
    return (false, null)
  if index >= v.count:
    return (false, null)
  let found = array_for(v, index)
  (true, found[index & mask])

export "pv_at" pub fn at(v :: vector, index :: i32) -> eq?:
  let (ok, value) = get(v, index)
  if !ok:
    unreachable
  value

export "pv_push" pub fn push(v :: vector, value :: eq?) -> vector:
  if v.count == 0x7fffffff:
    unreachable
  if v.tail.len() < branching:
    let grown_tail = copy_slots(v.tail, v.tail.len() + 1)
    grown_tail[v.tail.len()] = value
    return vector{
      count: v.count + 1,
      shift: v.shift,
      root: v.root,
      tail: grown_tail,
    }
  let tail_node = node{edit: null, slots: v.tail}
  var shift = v.shift
  var root = v.root
  if (v.count >> shift_bits) > (1 << shift)
  | let grown = node_new(null)
    grown.slots[0] = v.root
    grown.slots[1] = new_path(shift, tail_node)
    shift += shift_bits
    root = grown
  | root = push_tail(shift, v.root, tail_node, v.count - 1)
  vector{count: v.count + 1, shift: shift, root: root, tail: slots[value]}

export "pv_assoc" pub fn assoc(v :: vector, index :: i32, value :: eq?) -> vector:
  if index == v.count:
    return push(v, value)
  if index < 0:
    unreachable
  if index >= v.count:
    unreachable
  let offset = tail_offset(v.count)
  if index >= offset:
    if v.tail[index & mask] == value:
      return v
    let updated = copy_slots(v.tail, v.tail.len())
    updated[index & mask] = value
    return vector{
      count: v.count,
      shift: v.shift,
      root: v.root,
      tail: updated,
    }
  vector{
    count: v.count,
    shift: v.shift,
    root: do_assoc(v.shift, v.root, index, value),
    tail: v.tail,
  }

pub fn peek(v :: vector) -> (bool, eq?):
  if v.count == 0:
    return (false, null)
  (true, v.tail[v.tail.len() - 1])

export "pv_pop" pub fn pop(v :: vector) -> vector:
  if v.count == 0:
    unreachable
  if v.count == 1:
    return empty()
  if v.tail.len() > 1:
    return vector{
      count: v.count - 1,
      shift: v.shift,
      root: v.root,
      tail: copy_slots(v.tail, v.tail.len() - 1),
    }
  let new_tail = array_for(v, v.count - 2)
  let shrunk = pop_tail(v.shift, v.root, v.count - 2)
  var root = if shrunk == null | node_new(null) | shrunk!
  var shift = v.shift
  if shift > shift_bits:
    if root.slots[1] == null:
      root = root.slots[0] as node
      shift -= shift_bits
  vector{count: v.count - 1, shift: shift, root: root, tail: new_tail}

export "pv_each" pub fn each(v :: vector, context :: eq?, seen :: visit):
  for i in 0 ..< v.count:
    seen(context, i, at(v, i))

// ---------------------------------------------------------------- transient

pub type transient = {
  edit :: edit,
  count :: mut i32,
  shift :: mut i32,
  root :: mut node,
  tail :: mut slots,
  // The tail array is always full width; this is how much of it is live. The
  // persistent side has no such field because its tail is exactly as long as
  // it is full.
  tail_count :: mut i32,
}

fn ensure_node(n :: node, owner :: edit) -> node:
  if n.edit == owner:
    return n
  node{edit: owner, slots: copy_slots(n.slots, branching)}

fn t_new_path(level :: i32, n :: node, owner :: edit) -> node:
  if level == 0:
    return n
  let parent = node_new(owner)
  parent.slots[0] = t_new_path(level - shift_bits, n, owner)
  parent

fn t_push_tail(
  level :: i32,
  parent :: node,
  tail_node :: node,
  index :: i32,
  owner :: edit,
) -> node:
  let out = ensure_node(parent, owner)
  let subidx = (index >> level) & mask
  if level == shift_bits:
    out.slots[subidx] = tail_node
    return out
  let child = out.slots[subidx]
  if child == null
  | out.slots[subidx] = t_new_path(level - shift_bits, tail_node, owner)
  | out.slots[subidx] = t_push_tail(level - shift_bits, child as node, tail_node, index, owner)
  out

fn t_do_assoc(
  level :: i32,
  n :: node,
  index :: i32,
  value :: eq?,
  owner :: edit,
) -> node:
  let out = ensure_node(n, owner)
  if level == 0:
    out.slots[index & mask] = value
    return out
  let subidx = (index >> level) & mask
  out.slots[subidx] = t_do_assoc(
    level - shift_bits,
    out.slots[subidx] as node,
    index,
    value,
    owner,
  )
  out

fn t_pop_tail(level :: i32, n :: node, index :: i32, owner :: edit) -> node?:
  let out = ensure_node(n, owner)
  let subidx = (index >> level) & mask
  if level > shift_bits:
    let child = t_pop_tail(level - shift_bits, out.slots[subidx] as node, index, owner)
    if child == null:
      if subidx == 0:
        return null
    out.slots[subidx] = child
    return out
  if subidx == 0:
    return null
  out.slots[subidx] = null
  out

// Every transient operation starts here. A builder that has been frozen is a
// programming mistake rather than a value, so it traps.
fn require_active(t :: transient):
  if t.edit.active == 0:
    unreachable

fn snapshot(t :: transient) -> vector:
  vector{
    count: t.count,
    shift: t.shift,
    root: t.root,
    tail: copy_slots(t.tail, t.tail_count),
  }

export "pv_as_transient" pub fn as_transient(v :: vector) -> transient:
  let owner = edit{active: 1}
  transient{
    edit: owner,
    count: v.count,
    shift: v.shift,
    root: ensure_node(v.root, owner),
    tail: copy_slots(v.tail, branching),
    tail_count: v.tail.len(),
  }

export "pvt_count" pub fn t_count(t :: transient) -> i32:
  require_active(t)
  t.count

export "pvt_get" pub fn t_get(t :: transient, index :: i32) -> (bool, eq?):
  require_active(t)
  if index < 0:
    return (false, null)
  if index >= t.count:
    return (false, null)
  if index >= tail_offset(t.count):
    return (true, t.tail[index & mask])
  var n = t.root
  var level = t.shift
  while level > 0:
    n = n.slots[(index >> level) & mask] as node
    level -= shift_bits
  (true, n.slots[index & mask])

export "pvt_at" pub fn t_at(t :: transient, index :: i32) -> eq?:
  require_active(t)
  let (found, value) = t_get(t, index)
  if !found:
    unreachable
  value

export "pvt_push" pub fn t_push(t :: transient, value :: eq?):
  require_active(t)
  if t.count == 0x7fffffff:
    unreachable
  if t.tail_count < branching:
    t.tail[t.tail_count] = value
    t.tail_count = t.tail_count + 1
    t.count = t.count + 1
    return
  let tail_node = node{edit: t.edit, slots: t.tail}
  if (t.count >> shift_bits) > (1 << t.shift)
  | let grown = node_new(t.edit)
    grown.slots[0] = t.root
    grown.slots[1] = t_new_path(t.shift, tail_node, t.edit)
    t.root = grown
    t.shift = t.shift + shift_bits
  | t.root = t_push_tail(t.shift, t.root, tail_node, t.count - 1, t.edit)
  t.tail = slots[null ** branching]
  t.tail[0] = value
  t.tail_count = 1
  t.count = t.count + 1

export "pvt_assoc" pub fn t_assoc(t :: transient, index :: i32, value :: eq?):
  require_active(t)
  if index == t.count:
    t_push(t, value)
    return
  if index < 0:
    unreachable
  if index >= t.count:
    unreachable
  if index >= tail_offset(t.count):
    t.tail[index & mask] = value
    return
  t.root = t_do_assoc(t.shift, t.root, index, value, t.edit)

export "pvt_pop" pub fn t_pop(t :: transient):
  require_active(t)
  if t.count == 0:
    unreachable
  if t.count == 1:
    t.count = 0
    t.tail[0] = null
    t.tail_count = 0
    return
  if t.tail_count > 1:
    t.tail_count = t.tail_count - 1
    t.tail[t.tail_count] = null
    t.count = t.count - 1
    return
  var leaf = t.root
  var level = t.shift
  let index = t.count - 2
  while level > 0:
    leaf = leaf.slots[(index >> level) & mask] as node
    level -= shift_bits
  t.tail = copy_slots(leaf.slots, branching)
  t.tail_count = branching
  let shrunk = t_pop_tail(t.shift, t.root, t.count - 2, t.edit)
  t.root = if shrunk == null | node_new(t.edit) | shrunk!
  if t.shift > shift_bits:
    if t.root.slots[1] == null:
      t.root = t.root.slots[0] as node
      t.shift = t.shift - shift_bits
  t.count = t.count - 1

export "pvt_persistent" pub fn t_persistent(t :: transient) -> vector:
  require_active(t)
  t.edit.active = 0
  snapshot(t)
