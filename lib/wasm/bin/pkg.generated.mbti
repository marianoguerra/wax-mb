} derive(Eq, @debug.Debug)

pub(all) struct TagType {
  type_idx : Int32
} derive(Eq, @debug.Debug)

pub(all) struct TextView {
  field_order : Array[FieldRef]
  field_locs : Array[@basic.Location]
  decl_param_names : Map[ParamOwner, Map[Int32, Bytes]]
  decl_typeuse : Map[ParamOwner, TypeUse]
  standalone_exports : Map[Int32, Bool]
  named_types : Map[Int32, Bool]
  conditionals : Array[CondGroup]
  type_aliases : Array[(Bytes, @types.ValType[Int32])]
  alias_uses : Map[AliasSite, Bytes]
  field_spans : Map[(Int32, Int32), (@basic.Location, @basic.Location)]
  export_locs : Map[Int32, @basic.Location]
  type_name_locs : Map[Int32, @basic.Location]
} derive(@debug.Debug)
pub fn TextView::empty() -> Self

pub(all) struct TypeUse {
  named : Bool
  spelled : Bool
} derive(Eq, @debug.Debug)

// Type aliases
pub type FieldType = @types.MutType[@types.StorageType[Int32]]

pub type GlobalType = @types.MutType[@types.ValType[Int32]]

pub type HeapType = @types.HeapType[Int32]

pub using @types {type Limits}

pub type RefType = @types.RefType[Int32]

pub type StorageType = @types.StorageType[Int32]

pub type ValType = @types.ValType[Int32]

// Traits
