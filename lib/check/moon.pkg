import {
  "marianoguerra/wax/basic",
  "marianoguerra/wax/ast",
  "marianoguerra/wax/wasm/types" @wasm_types,
  "marianoguerra/wax/check/store" @type_store,
  "marianoguerra/wax/check/env" @typing_env,
  "marianoguerra/wax/feature",
  "marianoguerra/wax/diagnostic",
  "marianoguerra/wax/message",
  "marianoguerra/wax/check/infer",
  "marianoguerra/wax/internal/number",
  "marianoguerra/wax/internal/spell",
  "marianoguerra/wax/cond",
  "marianoguerra/wax/internal/cond_explore",
  "marianoguerra/wax/wasm/atomics",
  "marianoguerra/wax/wasm/simd",
  "marianoguerra/wax/unicode",
  "marianoguerra/wax/fmt" @output,
  "moonbitlang/core/double",
  "moonbitlang/core/math",
  "moonbitlang/core/ref",
  "moonbitlang/core/string",
}

import {
  // The package under test, under the name every other package knows it by.
  // A black-box test package would otherwise see it as `@check`, which is
  // the directory name rather than the name this codebase reads it as.
  "marianoguerra/wax/check" @typing,
  "moonbitlang/core/test",
  "marianoguerra/wax/cond",
  "marianoguerra/wax/unicode",
} for "test"
