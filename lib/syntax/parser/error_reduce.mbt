///|
/// Whether Menhir reduces to `symbol` when an error is detected. See
/// `error_reduction`.
fn on_error_reduce(symbol : Int32) -> Bool {
  match symbol {
    145 => true // attribute_expression
    181 => true // structure_field
    188 => true // blockinstr
    191 => true // parenthesized_expression
    193 => true // index_expression
    194 => true // then_branch
    195 => true // condition_expression
    196 => true // length_expression
    198 => true // argument
    200 => true // plaininstr
    209 => true // statement
    212 => true // raw_statement_list
    216 => true // constant_expression
    250 => true // separated_nonempty_list_trailing(",",value_type)
    281 => true // list(attribute)
    282 => true // semi_list(import_item)
    283 => true // semi_list(module_field)
    285 => true // separated_nonempty_list_trailing(",",structure_type_field)
    287 => true // separated_nonempty_list_trailing(",",function_parameter)
    288 => true // separated_nonempty_list_trailing(",",block_param_type)
    290 => true // separated_nonempty_list_trailing(",",structure_field)
    292 => true // separated_nonempty_list_trailing(",",expression)
    293 => true // separated_nonempty_list_trailing(",",argument)
    294 => true // separated_nonempty_list_trailing(",",let_pattern)
    _ => false
  }
}
