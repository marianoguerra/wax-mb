import {
  "marianoguerra/wax/basic",
  "marianoguerra/wax/syntax/tokens",
  "marianoguerra/wax/syntax/trivia",
  "marianoguerra/wax/syntax/lexer",
  "marianoguerra/wax/ast",
  "marianoguerra/wax/wasm/types" @wasm_types,
  "moonbitlang/core/list",
  "moonbitlang/core/string",
  "moonbitlang/core/math",
  "moonbitlang/core/cmp",
}

// parser.mbt is generated by moonyacc from parser.mbty.
//
// --table selects the TABLE engine over the default direct-style one (a
// function per state). The two parse identically; what differs is that the
// table engine represents a state as an Int, which is what makes the error
// state observable -- see state.mbt. Without it a state is an anonymous
// closure with no identity, and the reference's per-state messages have
// nothing to key on.

// The suppressions this package used to carry for the generated file are gone:
// -27 (deprecated_syntax) because the generator writes current syntax, and -87
// (guard_inexhaustive) because it emits `guard!` where the panic is intended.
// Both suppressed the warning for the hand-written files too, which is why
// they are worth not having.

warnings = "-6-text_segment_excceed"

formatter(ignore: [ "parser.mbt" ])

rule(
  name: "moonyacc",
  command: "moonx moonbitlang/yacc@0.7.25 --no-comments --external-tokens --table $input -o $output",
)

dev_build(rule: "moonyacc", input: "parser.mbty", output: "parser.mbt")
