// Smart constructors for the AST, for callers that generate Wax rather than
// parse it. Every function returns a plain `@ast` value, and a generator that
// outgrows one of them writes the constructor out by hand and mixes the two
// freely. `Spans` is the one type here, and it holds a counter rather than any
// part of a tree.
import {
  "marianoguerra/wax/ast",
  "marianoguerra/wax/basic",
  "marianoguerra/wax/wasm/types" @wasm_types,
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/test",
  "marianoguerra/wax/ast/build",
  "marianoguerra/wax/basic",
  "marianoguerra/wax/compile",
  "marianoguerra/wax/emit/wasm",
} for "test"
