  #|    return seq(c, 7, out)
  #|  if name == 12:
  #|    arity(c, args, 2)
  #|    let v = args[0]
  #|    let k = kind(v)
  #|    if k == 0: return bool(c, false)
  #|    if k == 13:
  #|      let r = v as record_value
  #|      for i in 0 ..< r.keys.len():
  #|        if equal(c, r.keys[i], args[1]): return bool(c, true)
  #|      return bool(c, false)
  #|    if k == 8 || k == 12: return bool(c, find(c, v, args[1]) >= 0)
  #|    let i = int_value(c, args[1])
  #|    return bool(c, i >= 0 && i < (count(c, v) as i64_u))
  #|  if name == 13:
  #|    arity(c, args, 2)
  #|    let src = elements(c, args[1])
  #|    var out = args[0]
  #|    for i in 0 ..< src.len(): out = conj(c, out, src[i])
  #|    return out
  #|  if name == 14:
  #|    arity(c, args, 1)
  #|    let n = int_value(c, args[0])
  #|    let x = n as f64_s
  #|    if x >= 9223372036854775808.0 || (x as i64_s) != n: die(c, 9)
  #|    return float(c, x)
  #|  if name == 15:
  #|    arity(c, args, 1)
  #|    let x = float_value(c, args[0])
  #|    if x != x || x < -9223372036854775808.0 || x >= 9223372036854775808.0: die(c, 9)
  #|    let n = x as i64_s
  #|    if (n as f64_s) != x: die(c, 9)
  #|    return int(c, n)
  #|  if name == 16:
  #|    arity(c, args, 2)
  #|    let tag = kind(args[0])
  #|    if tag != 8 && tag != 12: die(c, 4)
  #|    return map_dissoc(c, args[0], args[1])
  #|  if name == 17:
  #|    arity(c, args, 1)
  #|    return int(c, hash(c, args[0]) as i64_u)
  #|  die(c, 4)
  #|  unreachable
  #|
  #|fn key_hash(v :: eq) -> u32:
  #|  let k = v as key_box
  #|  hash(k.context, k.value)
  #|
  #|fn key_equal(a :: eq, b :: eq) -> bool:
  #|  let x = a as key_box
  #|  let y = b as key_box
  #|  equal(x.context, x.value, y.value)
  #|
  #|fn reserve_map(c :: context, count :: i32):
  #|  // At most seven trie levels plus one linear collision array copy. Equality
  #|  // callbacks and hashing meter their own traversal separately.
  #|  let bytes :: i64 = (count as i64_u) * 32 + 16384
  #|  if c.allocation < bytes: die(c, 2)
  #|  c.allocation -= bytes
  #|  tick(c, (count as i64_u) + 512)
  #|
  #|fn map_assoc(c :: context, v :: eq?, k :: eq?, item :: eq?) -> eq:
  #|  let m = v as map_value
  #|  key(c, k)
  #|  let slot = find(c, v, k)
  #|  let length = persistent_hash_map.count(m.index)
  #|  let width = if kind(v) == 8 | 2 | 1
  #|  if slot < 0 && length >= c.max_size / width: die(c, 2)
  #|  if slot >= 0 && kind(v) == 12: return v!
  #|  if slot < 0 && persistent_vector.count(m.entries) > length * 2 + 32:
  #|    let compacted = seq(c, kind(v), seq_values(c, v))
  #|    return map_assoc(c, compacted, k, item)
  #|  reserve_map(c, length)
  #|  reserve_vector(c)
  #|  if slot >= 0:
  #|    let old = persistent_vector.at(m.entries, slot) as map_entry
  #|    let entry = map_entry{key: old.key, item: item}
  #|    return map_value{kind: kind(v), index: m.index, entries: persistent_vector.assoc(m.entries, slot, entry)}
  #|  let entry = map_entry{key: k, item: item}
  #|  let at = persistent_vector.count(m.entries)
  #|  if at >= c.max_size: die(c, 2)
  #|  let probe = key_box{context: c, value: k}
  #|  let index = persistent_hash_map.assoc(m.index, probe, int(c, at as i64_u))
  #|  map_value{kind: kind(v), index: index, entries: persistent_vector.push(m.entries, entry)}
  #|
  #|fn map_dissoc(c :: context, v :: eq?, k :: eq?) -> eq:
  #|  let m = v as map_value
  #|  let slot = find(c, v, k)
  #|  if slot < 0: return v!
  #|  reserve_map(c, persistent_hash_map.count(m.index))
  #|  reserve_vector(c)
  #|  let index = persistent_hash_map.dissoc(m.index, key_box{context: c, value: k})
  #|  map_value{kind: kind(v), index: index, entries: persistent_vector.assoc(m.entries, slot, null)}
  #|
  #|fn replace_field(c :: context, v :: eq?, k :: eq?, item :: eq?) -> values:
  #|  let r = v as record_value
  #|  let out = values_new(c, r.data.len())
  #|  var found = false
  #|  for i in 0 ..< out.len():
  #|    out[i] = r.data[i]
  #|    if equal(c, r.keys[i], k):
  #|      found = true
  #|      out[i] = item
  #|  if !found: die(c, 8)
  #|  out
  #|
  #|fn string_at(c :: context, v :: eq?, index :: i64, default :: eq?) -> eq?:
  #|  if index < 0: return default
  #|  let data = (v as text).data
  #|  var point :: i64 = 0
  #|  var start = 0
  #|  while start < data.len():
  #|    tick(c, 1)
  #|    var end = start + 1
  #|    while end < data.len() && (data[end] && 192) == 128:
  #|      tick(c, 1)
  #|      end += 1
  #|    if point == index:
  #|      let out = bytes_new(c, end - start)
  #|      for j in 0 ..< out.len(): out[j] = data[start + j]
  #|      return string(c, out, false)
  #|    point += 1
  #|    start = end
  #|  default
  #|
  #|fn hash(c :: context, v :: eq?) -> u32:
  #|  enter(c)
  #|  let h = hash_inner(c, v)
  #|  leave(c)
  #|  h
  #|
  #|fn elements(c :: context, v :: eq?) -> values:
  #|  let tag = kind(v)
  #|  if tag == 0: return values_new(c, 0)
  #|  if tag == 4:
  #|    let n = count(c, v)
  #|    let out = values_new(c, n)
  #|    for i in 0 ..< n: out[i] = string_at(c, v, i as i64_u, null)
  #|    return out
  #|  if tag == 13:
  #|    let r = v as record_value
  #|    let out = values_new(c, r.keys.len())
  #|    for i in 0 ..< out.len():
  #|      let pair = values_new(c, 2)
  #|      pair[0] = r.keys[i]
  #|      pair[1] = r.data[i]
  #|      out[i] = seq(c, 6, pair)
  #|    return out
  #|  let data = seq_values(c, v)
  #|  if tag != 8: return data
  #|  let out = values_new(c, data.len() / 2)
  #|  for i in 0 ..< out.len():
  #|    let pair = values_new(c, 2)
  #|    pair[0] = data[i * 2]
  #|    pair[1] = data[i * 2 + 1]
  #|    out[i] = seq(c, 6, pair)
  #|  out
  #|
  #|fn hash_inner(c :: context, v :: eq?) -> u32:
  #|  let tag = kind(v)
  #|  if tag == 0: return 0
  #|  if tag == 9 || tag == 10 || tag == 11: die(c, 7)
  #|  if tag == 1:
  #|    let bits = (v as integer).n as u64
  #|    return (bits ^ (bits >> 32)) as u32
  #|  if tag == 2:
  #|    let x = (v as floating).n
  #|    if x == 0.0: return 23
  #|    if x != x: return 2143289344
  #|    let bits = x.to_bits() as u64
  #|    return ((bits ^ (bits >> 32)) as u32) + 23
  #|  if tag == 3:
  #|    if (v as boolean).n: return 1231
  #|    return 1237
  #|  if tag == 4 || tag == 5:
  #|    var h :: u32 = tag as u32
  #|    let data_bytes = (v as text).data
  #|    for i in 0 ..< data_bytes.len():
  #|      tick(c, 1)
  #|      h = h * 31 + data_bytes[i]
  #|    return h
  #|  if tag == 13:
  #|    let r = v as record_value
  #|    var h :: u32 = 13
  #|    for i in 0 ..< r.name.len():
  #|      tick(c, 1)
  #|      h = h * 31 + r.name[i]
  #|    for i in 0 ..< r.data.len(): h = h * 31 + hash(c, r.data[i])
  #|    return h
  #|  let data = seq_values(c, v)
  #|  var h :: u32 = 1
  #|  if tag == 8 || tag == 12:
  #|    h = tag as u32
  #|    var i = 0
  #|    while i < data.len():
  #|      let kh = hash(c, data[i])
  #|      if tag == 8
  #|      | h += kh ^ hash(c, data[i + 1])
  #|      | h += kh
  #|      let step = if tag == 8 | 2 | 1
  #|      i += step
  #|    return h
  #|  for i in 0 ..< data.len(): h = h * 31 + hash(c, data[i])
  #|  h

///|
let vector_source : String =
  #|// A persistent vector: the bit-partitioned trie, ported from
  #|// `stdlib/collections/persistent_vector.wax`.
  #|//
  #|// The .wax original opens with this comment:
  #|//
  #|//   All names use pv_/pvt_ prefixes because Wax has no source namespaces.
  #|//
  #|// That is the whole difference. Here the names are `node`, `empty`, `push`;
  #|// the module supplies the prefix, and the emitted wasm calls them
  #|// `persistent_vector__node`, `persistent_vector__empty` and so on. Nothing
  #|// else about the data structure changed.
  #|//
  #|// The transient half is here too. It is the same trie with the copying turned
  #|// off: a builder owns an `edit` token, every node it made carries that token,
  #|// and a node that already carries it is written in place instead of being
  #|// copied. `persistent` clears the token, so a builder used after freezing
  #|// traps rather than corrupting the value it handed out.
  #|
  #|module persistent_vector
  #|
  #|
  #|type visit = fn(eq?, i32, eq?)
  #|type edit = { active :: mut i32 }
  #|type slots = [eq?]
  #|
  #|type node = {
  #|  edit :: mut edit?,
  #|  slots :: mut slots,
  #|}
  #|
  #|pub type vector = {
  #|  count :: i32,
  #|  shift :: i32,
  #|  root :: node,
  #|  tail :: slots,
  #|}
  #|
  #|fn node_new(owner :: edit?) -> node:
  #|  node{edit: owner, slots: slots[null ** 32]}
  #|
  #|fn copy_slots(src :: slots, length :: i32) -> slots:
  #|  let dst = slots[null ** length]
  #|  let n = if src.len() < length | src.len() | length
  #|  if n != 0:
  #|    dst.copy(0, src, 0, n)
  #|  dst
  #|
  #|fn node_copy(n :: node) -> node:
  #|  node{edit: null, slots: copy_slots(n.slots, 32)}
  #|
  #|fn tail_offset(count :: i32) -> i32:
  #|  if count < 32:
  #|    return 0
  #|  ((count - 1) >> 5) << 5
  #|
  #|fn new_path(level :: i32, n :: node) -> node:
  #|  if level == 0:
  #|    return n
  #|  let parent = node_new(null)
  #|  parent.slots[0] = new_path(level - 5, n)
  #|  parent
  #|
  #|fn push_tail(level :: i32, parent :: node, tail_node :: node, index :: i32) -> node:
  #|  let out = node_copy(parent)
  #|  let subidx = (index >> level) & 31
  #|  if level == 5:
  #|    out.slots[subidx] = tail_node
  #|    return out
  #|  let child = parent.slots[subidx]
  #|  if child == null
  #|  | out.slots[subidx] = new_path(level - 5, tail_node)
  #|  | out.slots[subidx] = push_tail(level - 5, child as node, tail_node, index)
  #|  out
  #|
  #|fn do_assoc(level :: i32, n :: node, index :: i32, value :: eq?) -> node:
  #|  let out = node_copy(n)
  #|  if level == 0:
  #|    out.slots[index & 31] = value
  #|    return out
  #|  let subidx = (index >> level) & 31
  #|  out.slots[subidx] = do_assoc(level - 5, n.slots[subidx] as node, index, value)
  #|  out
  #|
  #|fn array_for(v :: vector, index :: i32) -> slots:
  #|  if index < 0:
  #|    unreachable
  #|  if index >= v.count:
  #|    unreachable
  #|  if index >= tail_offset(v.count):
  #|    return v.tail
  #|  var n = v.root
  #|  var level = v.shift
  #|  while level > 0:
  #|    n = n.slots[(index >> level) & 31] as node
  #|    level -= 5
  #|  n.slots
  #|
  #|fn pop_tail(level :: i32, n :: node, index :: i32) -> node?:
  #|  let subidx = (index >> level) & 31
  #|  if level > 5:
  #|    let child = pop_tail(level - 5, n.slots[subidx] as node, index)
  #|    if child == null:
  #|      if subidx == 0:
  #|        return null
  #|    let out = node_copy(n)
  #|    out.slots[subidx] = child
  #|    return out
  #|  if subidx == 0:
  #|    return null
  #|  let out = node_copy(n)
  #|  out.slots[subidx] = null
  #|  out
  #|
  #|pub fn empty() -> vector:
  #|  vector{count: 0, shift: 5, root: node_new(null), tail: slots[null ** 0]}
  #|
  #|pub fn count(v :: vector) -> i32:
  #|  v.count
  #|
  #|pub fn get(v :: vector, index :: i32) -> (bool, eq?):
  #|  if index < 0:
  #|    return (false, null)
  #|  if index >= v.count:
  #|    return (false, null)
  #|  let found = array_for(v, index)
  #|  (true, found[index & 31])
  #|
  #|pub fn at(v :: vector, index :: i32) -> eq?:
  #|  let (ok, value) = get(v, index)
  #|  if !ok:
  #|    unreachable
  #|  value
  #|
  #|pub fn push(v :: vector, value :: eq?) -> vector:
  #|  if v.count == 0x7fffffff:
  #|    unreachable
  #|  if v.tail.len() < 32:
  #|    let grown_tail = copy_slots(v.tail, v.tail.len() + 1)
  #|    grown_tail[v.tail.len()] = value
  #|    return vector{
  #|      count: v.count + 1,
  #|      shift: v.shift,
  #|      root: v.root,
  #|      tail: grown_tail,
  #|    }
  #|  let tail_node = node{edit: null, slots: v.tail}
  #|  var shift = v.shift
  #|  var root = v.root
  #|  if (v.count >> 5) > (1 << shift)
  #|  | let grown = node_new(null)
  #|    grown.slots[0] = v.root
  #|    grown.slots[1] = new_path(shift, tail_node)
  #|    shift += 5
  #|    root = grown
  #|  | root = push_tail(shift, v.root, tail_node, v.count - 1)
  #|  vector{count: v.count + 1, shift: shift, root: root, tail: slots[value]}
  #|
  #|pub fn assoc(v :: vector, index :: i32, value :: eq?) -> vector:
  #|  if index == v.count:
  #|    return push(v, value)
  #|  if index < 0:
  #|    unreachable
  #|  if index >= v.count:
  #|    unreachable
  #|  let offset = tail_offset(v.count)
  #|  if index >= offset:
  #|    if v.tail[index & 31] == value:
  #|      return v
  #|    let updated = copy_slots(v.tail, v.tail.len())
  #|    updated[index & 31] = value
  #|    return vector{
  #|      count: v.count,
  #|      shift: v.shift,
  #|      root: v.root,
  #|      tail: updated,
  #|    }
  #|  vector{
  #|    count: v.count,
  #|    shift: v.shift,
  #|    root: do_assoc(v.shift, v.root, index, value),
  #|    tail: v.tail,
  #|  }
  #|
  #|pub fn peek(v :: vector) -> (bool, eq?):
  #|  if v.count == 0:
  #|    return (false, null)
  #|  (true, v.tail[v.tail.len() - 1])
  #|
  #|pub fn pop(v :: vector) -> vector:
  #|  if v.count == 0:
  #|    unreachable
  #|  if v.count == 1:
  #|    return empty()
  #|  if v.tail.len() > 1:
  #|    return vector{
  #|      count: v.count - 1,
  #|      shift: v.shift,
  #|      root: v.root,
  #|      tail: copy_slots(v.tail, v.tail.len() - 1),
  #|    }
  #|  let new_tail = array_for(v, v.count - 2)
  #|  let shrunk = pop_tail(v.shift, v.root, v.count - 2)
  #|  var root = if shrunk == null | node_new(null) | shrunk!
  #|  var shift = v.shift
  #|  if shift > 5:
  #|    if root.slots[1] == null:
  #|      root = root.slots[0] as node
  #|      shift -= 5
  #|  vector{count: v.count - 1, shift: shift, root: root, tail: new_tail}
  #|
  #|pub fn each(v :: vector, context :: eq?, seen :: visit):
  #|  for i in 0 ..< v.count:
  #|    seen(context, i, at(v, i))
  #|
  #|// ---------------------------------------------------------------- transient
  #|

///|
let map_source : String =
  #|// A persistent hash map: the HAMT, ported from
  #|// `stdlib/collections/persistent_hash_map.wax`.
  #|//
  #|// The .wax original opens by explaining its own name:
  #|//
  #|//   This file is deliberately standalone and uses a phm_/phmt_ prefix because
  #|//   Wax modules do not have source namespaces.
  #|//
  #|// Here the module supplies the prefix and the names are `empty`, `assoc`,
  #|// `get`. The wasm export names keep the `phm_` spelling, because those are an
  #|// ABI rather than an identifier and a consumer already linking against them
  #|// should not have to change.
  #|//
  #|// Three other things read differently from the original, and all three are the
  #|// type saying what the operator had to say in Wax:
  #|//
  #|//   * A hash is `u32`, so `>>` is the logical shift and `<` is the unsigned
  #|//     comparison. The .wax file writes `>>u` and `<u` on an `i32`.
  #|//   * `||` is bitwise or on those, not logical: shrubbery's `|` introduces
  #|//     alternatives, so `||` carries both meanings and the operand type decides.
  #|//   * A predicate returns `bool`. Wax has no `bool`, so the original returns
  #|//     `i32` and compares it against 0 at every call site.
  #|//
  #|// The transient half is here too. It is the same HAMT with the copying turned
  #|// off: a builder owns an `edit` token, a node that already carries that token
  #|// is written in place rather than copied, and `persistent` clears the token so
  #|// that a builder used after freezing traps instead of writing into the value it
  #|// handed out.
  #|
  #|module persistent_hash_map
  #|
  #|type hash_fn = fn(eq) -> u32
  #|type equal_fn = fn(eq, eq) -> bool
  #|type visit = fn(eq?, eq?, eq?)
  #|
  #|type edit = { active :: mut i32 }
  #|type slots = [eq?]
  #|
  #|type node = { edit :: mut edit? }
  #|
  #|type bitmap_node :: node = {
  #|  bitmap :: mut u32,
  #|  slots :: mut slots,
  #|}
  #|
  #|type node_slots = [node?]
  #|
  #|type array_node :: node = {
  #|  count :: mut i32,
  #|  children :: mut node_slots,
  #|}
  #|
  #|type collision_node :: node = {
  #|  hash :: u32,
  #|  count :: mut i32,
  #|  slots :: mut slots,
  #|}
  #|
  #|pub type map = {
  #|  count :: i32,
  #|  root :: node?,
  #|  has_null :: bool,
  #|  null_value :: eq?,
  #|  hash :: hash_fn,
  #|  equal :: equal_fn,
  #|}
  #|
  #|fn bitpos(hash :: u32, shift :: u32) -> u32:
  #|  1 << ((hash >> shift) & 31)
  #|
  #|fn bitmap_index(bitmap :: u32, bit :: u32) -> i32:
  #|  (bitmap && (bit - 1)).popcnt()
  #|
  #|fn copy_slots(src :: slots, length :: i32) -> slots:
  #|  let dst = slots[null ** length]
  #|  let n = if src.len() < length | src.len() | length
  #|  if n != 0:
  #|    dst.copy(0, src, 0, n)
  #|  dst
  #|
  #|fn insert_pair(src :: slots, at :: i32, key :: eq?, value :: eq?) -> slots:
  #|  let n = src.len()
  #|  let dst = slots[null ** (n + 2)]
  #|  if at != 0:
  #|    dst.copy(0, src, 0, at)
  #|  dst[at] = key
  #|  dst[at + 1] = value
  #|  if at != n:
  #|    dst.copy(at + 2, src, at, n - at)
  #|  dst
  #|
  #|fn remove_pair(src :: slots, at :: i32) -> slots:
  #|  let n = src.len()
  #|  let dst = slots[null ** (n - 2)]
  #|  if at != 0:
  #|    dst.copy(0, src, 0, at)
  #|  if at + 2 != n:
  #|    dst.copy(at, src, at + 2, n - at - 2)
  #|  dst
  #|
  #|fn bitmap(owner :: edit?, bits :: u32, entries :: slots) -> node:
  #|  bitmap_node{edit: owner, bitmap: bits, slots: entries}
  #|
  #|fn array(owner :: edit?, count :: i32, children :: node_slots) -> node:
  #|  array_node{edit: owner, count: count, children: children}
  #|
  #|fn collision(owner :: edit?, hash :: u32, count :: i32, entries :: slots) -> node:
  #|  collision_node{edit: owner, hash: hash, count: count, slots: entries}
  #|
  #|fn singleton_at(shift :: u32, hash :: u32, key :: eq, value :: eq?) -> node:
  #|  bitmap(null, bitpos(hash, shift), slots[key, value])
  #|
  #|fn merge_two(
  #|  shift :: u32,
  #|  hash1 :: u32,
  #|  key1 :: eq,
  #|  value1 :: eq?,
  #|  hash2 :: u32,
  #|  key2 :: eq,
  #|  value2 :: eq?,
  #|) -> node:
  #|  if hash1 == hash2:
  #|    return collision(null, hash1, 2, slots[key1, value1, key2, value2])
  #|  let bit1 = bitpos(hash1, shift)
  #|  let bit2 = bitpos(hash2, shift)
  #|  if bit1 == bit2:
  #|    let child = merge_two(shift + 5, hash1, key1, value1, hash2, key2, value2)
  #|    return bitmap(null, bit1, slots[null, child])
