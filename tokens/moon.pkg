import {
  "waxmb/wax/basic",
}

// tokens.mbt is generated by moonyacc from the ONE grammar file that also
// defines the parser, so a terminal cannot be declared in one place and missing
// in the other. Mirrors moonbitlang/parser's lexer/tokens/moon.pkg.
formatter(ignore: [ "tokens.mbt" ])

rule(
  name: "moonyacc",
  command: "moon runwasm moonbitlang/yacc@0.7.18 --mode only-tokens $input -o $output",
)

dev_build(
  rule: "moonyacc",
  input: "../grammar/parser.mbty",
  output: "tokens.mbt",
)
