root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Corpus and golden files are byte-exact fixtures compared against the reference
# implementation. Trimming or reflowing them would silently change what is under
# test.
[test/{corpus,golden}/**]
insert_final_newline = false
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
