#[export = "stdlib_invalid_jv_record_transient"]
fn st_invalid_jv_record_transient() -> i32 {
    let schema = jv_record_schema_add(
        jv_record_schema_add(jv_record_schema_empty(), st_key(1), jv_type_i32(), jv_i32(0)),
        st_key(2),
        jv_type_i32(),
        jv_i32(10),
    );
    let definition = jv_record_type_create_validated(
        utf8_from_bytes("Range"),
        schema,
        null,
        st_ordered_record,
    );
    let value = jv_record_as_transient(jv_record_default(definition));
    jvt_record_set(value, st_key(1), jv_i32(20));
    let (status, _) = jvt_record_try_persistent(value);
    st_assert(if status == jv_record_value_invalid { 1 } else { 0 });
    jvt_record_count(value)
}

#[export = "stdlib_bench_utf8"]
fn st_bench_utf8(size: i32, rounds: i32) -> i32 {
    let bytes = [wax_hash_bytes| 0x61; size];
    let i: i32 = 0;
    while i <s size {
        bytes[i] = 0x61 + i %s 26;
        i += 1;
    }
    let checksum: i32 = 0;
    let round: i32 = 0;
    while round <s rounds {
        let text = utf8_from_bytes(bytes);
        checksum ^= utf8_hash(text);
        checksum += utf8_codepoint_length(text);
        round += 1;
    }
    checksum
}

#[export = "stdlib_bench_persistent"]
fn st_bench_persistent(size: i32, rounds: i32) -> i32 {
    let checksum: i32 = 0;
    let round: i32 = 0;
    while round <s rounds {
        let vector = jv_vector_empty();
        let map = jv_map_empty();
        let set = jv_set_empty();
        let i: i32 = 0;
        while i <s size {
            let value = jv_i32(i);
            vector = jv_vector_push(vector, value);
            map = jv_map_assoc(map, st_bench_key(i), value);
            set = jv_set_add(set, value);
            i += 1;
        }
        checksum += jv_vector_count(vector) + jv_map_count(map) + jv_set_count(set);
        round += 1;
    }
    checksum
}

#[export = "stdlib_bench_transient"]
fn st_bench_transient(size: i32, rounds: i32) -> i32 {
    let checksum: i32 = 0;
    let round: i32 = 0;
    while round <s rounds {
        let vector = jv_vector_as_transient(jv_vector_empty());
        let map = jv_map_as_transient(jv_map_empty());
        let set = jv_set_as_transient(jv_set_empty());
        let i: i32 = 0;
        while i <s size {
            let value = jv_i32(i);
            jvt_vector_push(vector, value);
            jvt_map_assoc(map, st_bench_key(i), value);
            jvt_set_add(set, value);
            i += 1;
        }
        let frozen_vector = jvt_vector_persistent(vector);
        let frozen_map = jvt_map_persistent(map);
        let frozen_set = jvt_set_persistent(set);
        checksum +=
            jv_vector_count(frozen_vector)
            + jv_map_count(frozen_map)
            + jv_set_count(frozen_set);
        round += 1;
    }
    checksum
}

#[export = "stdlib_bench_ordered_persistent"]
fn st_bench_ordered_persistent(size: i32, rounds: i32) -> i32 {
    let checksum: i32 = 0;
    let round: i32 = 0;
    while round <s rounds {
        let map = jv_ordered_map_empty();
        let set = jv_ordered_set_empty();
        let i: i32 = 0;
        while i <s size {
            let value = jv_i32(i);
            map = jv_ordered_map_assoc(map, st_bench_key(i), value);
            set = jv_ordered_set_add(set, value);
            i += 1;
        }
        checksum += jv_ordered_map_count(map) + jv_ordered_set_count(set);
        round += 1;
    }
    checksum
}

#[export = "stdlib_bench_ordered_transient"]
fn st_bench_ordered_transient(size: i32, rounds: i32) -> i32 {
    let checksum: i32 = 0;
    let round: i32 = 0;
    while round <s rounds {
        let map = jv_ordered_map_as_transient(jv_ordered_map_empty());
        let set = jv_ordered_set_as_transient(jv_ordered_set_empty());
        let i: i32 = 0;
        while i <s size {
            let value = jv_i32(i);
            jvt_ordered_map_assoc(map, st_bench_key(i), value);
            jvt_ordered_set_add(set, value);
            i += 1;
        }
        let frozen_map = jvt_ordered_map_persistent(map);
        let frozen_set = jvt_ordered_set_persistent(set);
        checksum +=
            jv_ordered_map_count(frozen_map)
            + jv_ordered_set_count(frozen_set);
        round += 1;
    }
    checksum
}

#[export = "stdlib_bench_record_persistent"]
fn st_bench_record_persistent(size: i32, rounds: i32) -> i32 {
    let definition = st_property_record_type();
    let checksum: i32 = 0;
    let round: i32 = 0;
    while round <s rounds {
        let record = jv_record_default(definition);
        let i: i32 = 0;
        while i <s size {
            record = jv_record_set(record, st_key(i %s 3 + 1), jv_i32(i));
            i += 1;
        }
        checksum += jv_require_i32(jv_record_at(record, st_key((size - 1) %s 3 + 1)));
        round += 1;
    }
    checksum
}

#[export = "stdlib_bench_record_transient"]
fn st_bench_record_transient(size: i32, rounds: i32) -> i32 {
    let definition = st_property_record_type();
    let checksum: i32 = 0;
    let round: i32 = 0;
    while round <s rounds {
        let record = jv_record_as_transient(jv_record_default(definition));
        let i: i32 = 0;
        while i <s size {
            jvt_record_set(record, st_key(i %s 3 + 1), jv_i32(i));
            i += 1;
        }
        let frozen = jvt_record_persistent(record);
        checksum += jv_require_i32(jv_record_at(frozen, st_key((size - 1) %s 3 + 1)));
        round += 1;
    }
    checksum
}
