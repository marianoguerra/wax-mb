// Test adapter for the vendorable Wax standard-library sources.

fn st_assert(condition: i32) {
    if condition == 0 { unreachable; }
}

fn st_assert_utf8(bytes: &wax_hash_bytes, expected: i32) {
    let (valid, _) = utf8_try_from_bytes(bytes);
    st_assert(if valid == expected { 1 } else { 0 });
}

let st_stage: i32 = 0;

#[export = "stdlib_stage"]
fn st_get_stage() -> i32 { st_stage }

fn st_key(value: i32) -> &utf8_string {
    utf8_from_bytes(
        [wax_hash_bytes|
            65 + (value /s 26) %s 26,
            65 + value %s 26,
        ],
    )
}

fn st_bench_key(value: i32) -> &utf8_string {
    utf8_from_bytes(
        [wax_hash_bytes|
            65 + (value /s 17576) %s 26,
            65 + (value /s 676) %s 26,
            65 + (value /s 26) %s 26,
            65 + value %s 26,
        ],
    )
}

fn st_assert_jv_i32(value: &jv_value, expected: i32) {
    let (found, actual) = jv_get_i32(value);
    st_assert(found);
    st_assert(if actual == expected { 1 } else { 0 });
}

fn st_assert_vector(vector: &jv_vector_value, index: i32, expected: i32) {
    let (found, value) = jv_vector_get(vector, index);
    st_assert(found);
    st_assert_jv_i32(value!, expected);
}

fn st_assert_map(map: &jv_map_value, key: i32, present: i32, expected: i32) {
    let (found, value) = jv_map_get(map, st_key(key));
    st_assert(if found == present { 1 } else { 0 });
    if found != 0 { st_assert_jv_i32(value!, expected); }
}

fn st_assert_set(set: &jv_set_value, value: i32, present: i32) {
    st_assert(if jv_set_contains(set, jv_i32(value)) == present { 1 } else { 0 });
}

type st_order = { count: mut i32, code: mut i32, last: mut i32 };
type st_expected_i32 = [i32];

type st_expected_map_order = {
    keys: &st_expected_i32,
    values: &st_expected_i32,
    index: mut i32,
};

type st_expected_set_order = {
    values: &st_expected_i32,
    index: mut i32,
};

fn st_ordered_map_visit(context: &?eq, _key: &utf8_string, value: &jv_value) {
    let state = context! as &st_order;
    let actual = jv_require_i32(value);
    state.count = state.count + 1;
    state.code = state.code * 10 + actual;
    state.last = actual;
}

fn st_ordered_set_visit(context: &?eq, value: &jv_value) {
    let state = context! as &st_order;
    let actual = jv_require_i32(value);
    state.count = state.count + 1;
    state.code = state.code * 10 + actual;
    state.last = actual;
}

fn st_assert_ordered_map_visit(
    context: &?eq,
    key: &utf8_string,
    value: &jv_value,
) {
    let state = context! as &st_expected_map_order;
    st_assert(if state.index <s state.keys.length() { 1 } else { 0 });
    st_assert(utf8_equal(key, st_key(state.keys[state.index])));
    st_assert_jv_i32(value, state.values[state.index]);
    state.index = state.index + 1;
}

fn st_assert_ordered_set_visit(context: &?eq, value: &jv_value) {
    let state = context! as &st_expected_set_order;
    st_assert(if state.index <s state.values.length() { 1 } else { 0 });
    st_assert_jv_i32(value, state.values[state.index]);
    state.index = state.index + 1;
}

fn st_assert_ordered_map(
    map: &jv_ordered_map_value,
    keys: &st_expected_i32,
    values: &st_expected_i32,
) {
    st_assert(if keys.length() == values.length() { 1 } else { 0 });
    let state: &st_expected_map_order = { keys, values, index: 0 };
    jv_ordered_map_each(map, state, st_assert_ordered_map_visit);
    st_assert(if state.index == keys.length() { 1 } else { 0 });
    st_assert(if state.index == jv_ordered_map_count(map) { 1 } else { 0 });
}

fn st_assert_ordered_set(set: &jv_ordered_set_value, values: &st_expected_i32) {
    let state: &st_expected_set_order = { values, index: 0 };
    jv_ordered_set_each(set, state, st_assert_ordered_set_visit);
    st_assert(if state.index == values.length() { 1 } else { 0 });
    st_assert(if state.index == jv_ordered_set_count(set) { 1 } else { 0 });
}

fn st_ordered_map_code(map: &jv_ordered_map_value) -> i32 {
    let state: &st_order = { count: 0, code: 0, last: -1 };
    jv_ordered_map_each(map, state, st_ordered_map_visit);
    st_assert(if state.count == jv_ordered_map_count(map) { 1 } else { 0 });
    state.code
}

fn st_ordered_set_code(set: &jv_ordered_set_value) -> i32 {
    let state: &st_order = { count: 0, code: 0, last: -1 };
    jv_ordered_set_each(set, state, st_ordered_set_visit);
    st_assert(if state.count == jv_ordered_set_count(set) { 1 } else { 0 });
    state.code
}

fn st_assert_record(record: &jv_record_value, field: i32, expected: i32) {
    let (found, value) = jv_record_get(record, st_key(field));
    st_assert(found);
    st_assert_jv_i32(value!, expected);
}

fn st_nonnegative_field(_context: &?eq, value: &jv_value) -> i32 {
    let (found, actual) = jv_get_i32(value);
    if found == 0 { return 0; }
    if actual <s (0 as i32) { return 0; }
    1
}

fn st_ordered_record(_context: &?eq, record: &jv_record_value) -> i32 {
    let left = jv_require_i32(jv_record_at(record, st_key(1)));
    let right = jv_require_i32(jv_record_at(record, st_key(2)));
    if left <=s right { 1 } else { 0 }
}

fn st_property_record_type() -> &jv_record_type {
    let schema = jv_record_schema_add(
        jv_record_schema_add(
            jv_record_schema_add(jv_record_schema_empty(), st_key(1), jv_type_i32(), jv_i32(0)),
            st_key(2),
            jv_type_i32(),
            jv_i32(0),
        ),
        st_key(3),
        jv_type_i32(),
        jv_i32(0),
    );
    jv_record_type_create(utf8_from_bytes("PropertyRecord"), schema)
}

fn st_oracle_record_type() -> &jv_record_type {
    let schema = jv_record_schema_add(
        jv_record_schema_add(jv_record_schema_empty(), st_key(1), jv_type_i32(), jv_i32(0)),
        st_key(2),
        jv_type_i32(),
        jv_i32(0),
    );
    jv_record_type_create(utf8_from_bytes("Point"), schema)
}

type st_codepoints = {
    count: mut i32,
    sum: mut i32,
    offsets: mut i32,
};

fn st_visit_codepoint(context: &?eq, index: i32, offset: i32, scalar: i32) {
    let out = context! as &st_codepoints;
    out.count = out.count + 1;
    out.sum = out.sum + scalar;
    out.offsets = out.offsets + index + offset;
}

type st_payload = { id: i32 };

#[export = "stdlib_boundaries"]
fn st_boundaries() -> i32 {
    st_stage = 1;
    let source = [wax_hash_bytes| 0x41, 0xc3, 0xa9, 0xf0, 0x9f, 0x98, 0x80];
    let text = utf8_from_bytes(source);
    let literal = utf8_from_bytes("Wax");
    st_assert(utf8_equal(literal, utf8_from_bytes([wax_hash_bytes| 0x57, 0x61, 0x78])));
    st_assert(if utf8_byte_length(text) == 7 { 1 } else { 0 });
    st_assert(if utf8_codepoint_length(text) == 3 { 1 } else { 0 });
    source[0] = 0x42;
    st_assert(if utf8_at_byte(text, 0) == 0x41 { 1 } else { 0 });
    let copied = utf8_copy_bytes(text);
    copied[0] = 0x43;
    st_assert(if utf8_at_byte(text, 0) == 0x41 { 1 } else { 0 });
    let same = utf8_from_bytes([wax_hash_bytes| 0x41, 0xc3, 0xa9, 0xf0, 0x9f, 0x98, 0x80]);
    st_assert(utf8_equal(text, same));
    st_assert(if utf8_hash(text) == utf8_hash(same) { 1 } else { 0 });
    st_assert(if utf8_compare(utf8_from_bytes([wax_hash_bytes| 0x61]), utf8_from_bytes([wax_hash_bytes| 0x62])) <s (0 as i32) { 1 } else { 0 });
    let (bad_boundary, _) = utf8_try_slice_bytes(text, 2, 1);
    st_assert(if bad_boundary == 0 { 1 } else { 0 });
    let slice = utf8_slice_bytes(text, 1, 2);
    st_assert(utf8_equal(slice, utf8_from_bytes([wax_hash_bytes| 0xc3, 0xa9])));
    let joined = utf8_concat(slice, utf8_from_bytes([wax_hash_bytes| 0x21]));
    st_assert(utf8_equal(joined, utf8_from_bytes([wax_hash_bytes| 0xc3, 0xa9, 0x21])));
    let points: &st_codepoints = { count: 0, sum: 0, offsets: 0 };
    utf8_each_codepoint(text, points, st_visit_codepoint);
    st_assert(if points.count == 3 { 1 } else { 0 });
    st_assert(if points.sum == 0x1f72a { 1 } else { 0 });
    st_assert(if points.offsets == 7 { 1 } else { 0 });
    let (overlong, _) = utf8_try_from_bytes([wax_hash_bytes| 0xc0, 0x80]);
    let (surrogate, _) = utf8_try_from_bytes([wax_hash_bytes| 0xed, 0xa0, 0x80]);
    let (too_large, _) = utf8_try_from_bytes([wax_hash_bytes| 0xf4, 0x90, 0x80, 0x80]);
    st_assert(if overlong + surrogate + too_large == 0 { 1 } else { 0 });
    st_assert_utf8([wax_hash_bytes|], 1);
    st_assert_utf8([wax_hash_bytes| 0x00, 0x7f], 1);
    st_assert_utf8([wax_hash_bytes| 0xc2, 0x80, 0xdf, 0xbf], 1);
    st_assert_utf8([wax_hash_bytes| 0xe0, 0xa0, 0x80, 0xed, 0x9f, 0xbf], 1);
    st_assert_utf8([wax_hash_bytes| 0xee, 0x80, 0x80, 0xef, 0xbf, 0xbf], 1);
    st_assert_utf8([wax_hash_bytes| 0xf0, 0x90, 0x80, 0x80], 1);
    st_assert_utf8([wax_hash_bytes| 0xf4, 0x8f, 0xbf, 0xbf], 1);
    st_assert_utf8([wax_hash_bytes| 0x80], 0);
    st_assert_utf8([wax_hash_bytes| 0xc2], 0);
    st_assert_utf8([wax_hash_bytes| 0xe0, 0xa0], 0);
    st_assert_utf8([wax_hash_bytes| 0xf0, 0x90, 0x80], 0);
    st_assert_utf8([wax_hash_bytes| 0xc2, 0x41], 0);
    st_assert_utf8([wax_hash_bytes| 0xe0, 0x80, 0x80], 0);
    st_assert_utf8([wax_hash_bytes| 0xf0, 0x80, 0x80, 0x80], 0);
    st_assert_utf8([wax_hash_bytes| 0xf5, 0x80, 0x80, 0x80], 0);
    st_assert_utf8([wax_hash_bytes| 0xff], 0);

    st_stage = 2;
    let base_set = phs_empty(wax_hash_i31_key, wax_equal_i31_key);
    let set_a = phs_add(phs_add(phs_add(base_set, 1 as &i31), 2 as &i31), null);
    let set_b = phs_add(phs_add(phs_empty(wax_hash_i31_key, wax_equal_i31_key), 2 as &i31), 3 as &i31);
    st_assert(if phs_count(set_a) == 3 { 1 } else { 0 });
    st_assert(phs_contains(set_a, null));
    st_assert(if phs_count(phs_union(set_a, set_b)) == 4 { 1 } else { 0 });
    st_assert(if phs_count(phs_intersection(set_a, set_b)) == 1 { 1 } else { 0 });
    st_assert(if phs_count(phs_difference(set_a, set_b)) == 2 { 1 } else { 0 });
    st_assert(if phs_add(set_a, 1 as &i31) == set_a { 1 } else { 0 });
    st_assert(if phs_remove(set_a, 9 as &i31) == set_a { 1 } else { 0 });
    let transient_set = phs_as_transient(set_a);
    phst_add(transient_set, 4 as &i31);
    phst_remove(transient_set, null);
    let frozen_set = phst_persistent(transient_set);
    st_assert(if phs_count(frozen_set) == 3 { 1 } else { 0 });
    st_assert(if phs_count(set_a) == 3 { 1 } else { 0 });

    st_stage = 3;
    st_assert(if jv_kind(jv_null()) == jv_kind_null { 1 } else { 0 });
    st_assert(if jv_require_bool(jv_bool(99)) == 1 { 1 } else { 0 });
    st_assert_jv_i32(jv_i32(-2147483647), -2147483647);
    st_assert(if jv_require_i64(jv_i64(0x123456789abcdef0)) == 0x123456789abcdef0 { 1 } else { 0 });
    let nan32: f32 = (0x7fc01234).from_bits();
    let nan64: f64 = (0x7ff8000000001234).from_bits();
    st_assert(jv_equal(jv_f32(nan32), jv_f32(nan32)));
    st_assert(jv_equal(jv_f64(nan64), jv_f64(nan64)));
    st_assert(if jv_equal(jv_f32(0.0), jv_f32((-2147483648).from_bits())) == 0 { 1 } else { 0 });
    st_assert(if jv_equal(jv_i32(1), jv_i64(1)) == 0 { 1 } else { 0 });
    let payload: &st_payload = { id: 7 };
    let payload2: &st_payload = { id: 7 };
    st_assert(jv_equal(jv_any(payload), jv_any(payload)));
    st_assert(if jv_equal(jv_any(payload), jv_any(payload2)) == 0 { 1 } else { 0 });
    st_assert(if jv_hash(jv_any(payload)) == jv_hash(jv_any(payload2)) { 1 } else { 0 });
    let (any_found, any_null) = jv_get_any(jv_any(null));
    st_assert(if any_found == 1 { jv_any_equal(any_null, null) } else { 0 });
    let opaque_set = jv_set_add(jv_set_add(jv_set_empty(), jv_any(payload)), jv_any(payload2));
    st_assert(if jv_set_count(opaque_set) == 2 { 1 } else { 0 });

    st_stage = 4;
    let vector0 = jv_vector_empty();
    let vector1 = jv_vector_push(jv_vector_push(vector0, jv_i32(10)), jv_string(st_key(1)));
    st_assert(if jv_vector_count(vector0) == 0 { 1 } else { 0 });
    st_assert_vector(vector1, 0, 10);
    let vector2 = jv_vector_assoc(vector1, 0, jv_i32(20));
    st_assert_vector(vector1, 0, 10);
    st_assert_vector(vector2, 0, 20);
    let tv = jv_vector_as_transient(vector2);
    jvt_vector_push(tv, jv_null());
    let vector3 = jvt_vector_persistent(tv);
    st_assert(if jv_vector_count(vector3) == 3 { 1 } else { 0 });

    let map0 = jv_map_empty();
    let map1 = jv_map_assoc(map0, st_key(1), jv_i32(11));
    let map2 = jv_map_assoc(map1, st_key(2), vector3);
    st_assert_map(map1, 1, 1, 11);
    st_assert_map(map0, 1, 0, 0);
    st_assert(if jv_map_contains(map2, st_key(2)) == 1 { 1 } else { 0 });
    let map_reverse = jv_map_assoc(jv_map_assoc(jv_map_empty(), st_key(2), vector3), st_key(1), jv_i32(11));
    st_assert(jv_equal(map2, map_reverse));
    st_assert(if jv_hash(map2) == jv_hash(map_reverse) { 1 } else { 0 });
    let tm = jv_map_as_transient(map2);
    jvt_map_assoc(tm, st_key(3), jv_bool(1));
    jvt_map_dissoc(tm, st_key(1));
    let map3 = jvt_map_persistent(tm);
    st_assert(if jv_map_count(map3) == 2 { 1 } else { 0 });
    st_assert(if jv_map_count(map2) == 2 { 1 } else { 0 });

    st_stage = 5;
    let values1 = jv_set_add(jv_set_add(jv_set_empty(), jv_i32(1)), jv_i32(2));
    let values2 = jv_set_add(jv_set_add(jv_set_empty(), jv_i32(2)), jv_i32(1));
    st_assert(jv_equal(values1, values2));
    st_assert(if jv_hash(values1) == jv_hash(values2) { 1 } else { 0 });
    st_assert_set(values1, 1, 1);
    st_assert_set(jv_set_remove(values1, jv_i32(1)), 1, 0);
    let nested1 = jv_set_add(values1, map2);
    let nested2 = jv_set_add(values2, map_reverse);
    st_assert(jv_equal(nested1, nested2));
    let ts = jv_set_as_transient(nested1);
    jvt_set_add(ts, jv_string(st_key(9)));
    let values3 = jvt_set_persistent(ts);
    st_assert(if jv_set_count(values3) == 4 { 1 } else { 0 });
    st_assert(if jv_set_count(nested1) == 3 { 1 } else { 0 });

    st_stage = 6;
    let one = jv_i32(1);
    let ordered_map0 = jv_ordered_map_empty();
    let ordered_map1 = jv_ordered_map_assoc(ordered_map0, st_key(1), one);
    let ordered_map2 = jv_ordered_map_assoc(ordered_map1, st_key(2), jv_i32(2));
    let ordered_map3 = jv_ordered_map_assoc(ordered_map2, st_key(3), jv_i32(3));
    st_assert(if jv_kind(ordered_map3) == jv_kind_ordered_map { 1 } else { 0 });
    st_assert(if st_ordered_map_code(ordered_map3) == 123 { 1 } else { 0 });
    st_assert(if jv_ordered_map_assoc(ordered_map1, st_key(1), one) == ordered_map1 { 1 } else { 0 });
    let ordered_map4 = jv_ordered_map_assoc(ordered_map3, st_key(2), jv_i32(8));
    st_assert(if st_ordered_map_code(ordered_map4) == 183 { 1 } else { 0 });
    st_assert(if st_ordered_map_code(ordered_map3) == 123 { 1 } else { 0 });
    let ordered_map5 = jv_ordered_map_assoc(
        jv_ordered_map_dissoc(ordered_map4, st_key(2)),
        st_key(2),
        jv_i32(2),
    );
    st_assert(if st_ordered_map_code(ordered_map5) == 132 { 1 } else { 0 });
    let (ordered_found, ordered_value) = jv_ordered_map_get(ordered_map5, st_key(2));
    st_assert(ordered_found);
    st_assert_jv_i32(ordered_value!, 2);
    st_assert(if jv_ordered_map_contains(ordered_map5, st_key(9)) == 0 { 1 } else { 0 });
    let (wrong_ordered_map, _) = jv_get_ordered_map(map2);
    st_assert(if wrong_ordered_map == 0 { 1 } else { 0 });
    let ordered_map_copy = jv_ordered_map_assoc(
        jv_ordered_map_assoc(
            jv_ordered_map_assoc(jv_ordered_map_empty(), st_key(1), jv_i32(1)),
            st_key(3),
            jv_i32(3),
        ),
        st_key(2),
        jv_i32(2),
    );
    st_assert(jv_equal(ordered_map5, ordered_map_copy));
    st_assert(if jv_hash(ordered_map5) == jv_hash(ordered_map_copy) { 1 } else { 0 });
    let ordered_map_values = jv_set_add(
        jv_set_add(jv_set_empty(), ordered_map5),
        ordered_map_copy,
    );
    st_assert(if jv_set_count(ordered_map_values) == 1 { 1 } else { 0 });
    st_assert(if jv_equal(ordered_map3, ordered_map5) == 0 { 1 } else { 0 });
    st_assert(if jv_hash(ordered_map3) != jv_hash(ordered_map5) { 1 } else { 0 });
    st_assert(if jv_equal(ordered_map3, map2) == 0 { 1 } else { 0 });
    let transient_ordered_map = jv_ordered_map_as_transient(ordered_map3);
    jvt_ordered_map_assoc(transient_ordered_map, st_key(2), jv_i32(8));
    jvt_ordered_map_dissoc(transient_ordered_map, st_key(1));
    jvt_ordered_map_assoc(transient_ordered_map, st_key(1), jv_i32(1));
    let frozen_ordered_map = jvt_ordered_map_persistent(transient_ordered_map);
    st_assert(if st_ordered_map_code(frozen_ordered_map) == 831 { 1 } else { 0 });
    st_assert(if st_ordered_map_code(ordered_map3) == 123 { 1 } else { 0 });

    let ordered_set1 = jv_ordered_set_add(
        jv_ordered_set_add(jv_ordered_set_add(jv_ordered_set_empty(), jv_i32(1)), jv_i32(2)),
        jv_i32(3),
    );
    st_assert(if jv_kind(ordered_set1) == jv_kind_ordered_set { 1 } else { 0 });
    st_assert(if st_ordered_set_code(ordered_set1) == 123 { 1 } else { 0 });
    st_assert(if jv_ordered_set_add(ordered_set1, jv_i32(2)) == ordered_set1 { 1 } else { 0 });
    let ordered_set2 = jv_ordered_set_add(
        jv_ordered_set_remove(ordered_set1, jv_i32(2)),
        jv_i32(2),
    );
    st_assert(if st_ordered_set_code(ordered_set2) == 132 { 1 } else { 0 });
    st_assert(if jv_equal(ordered_set1, ordered_set2) == 0 { 1 } else { 0 });
    st_assert(if jv_hash(ordered_set1) != jv_hash(ordered_set2) { 1 } else { 0 });
    let ordered_set_values = jv_set_add(
        jv_set_add(jv_set_empty(), ordered_set1),
        ordered_set2,
    );
    st_assert(if jv_set_count(ordered_set_values) == 2 { 1 } else { 0 });
    let ordered_set3 = jv_ordered_set_add(
        jv_ordered_set_add(jv_ordered_set_empty(), jv_i32(3)),
        jv_i32(4),
    );
    st_assert(if st_ordered_set_code(jv_ordered_set_union(ordered_set1, ordered_set3)) == 1234 { 1 } else { 0 });
    st_assert(if st_ordered_set_code(jv_ordered_set_intersection(ordered_set1, ordered_set3)) == 3 { 1 } else { 0 });
    st_assert(if st_ordered_set_code(jv_ordered_set_difference(ordered_set1, ordered_set3)) == 12 { 1 } else { 0 });
    let transient_ordered_set = jv_ordered_set_as_transient(ordered_set1);
    jvt_ordered_set_remove(transient_ordered_set, jv_i32(2));
    jvt_ordered_set_add(transient_ordered_set, jv_i32(4));
    jvt_ordered_set_add(transient_ordered_set, jv_i32(2));
    let frozen_ordered_set = jvt_ordered_set_persistent(transient_ordered_set);
    st_assert(if st_ordered_set_code(frozen_ordered_set) == 1342 { 1 } else { 0 });
    st_assert(if st_ordered_set_code(ordered_set1) == 123 { 1 } else { 0 });

    let compacted = jv_ordered_map_empty();
    let compact_index: i32 = 0;
    while compact_index <s (40 as i32) {
        compacted = jv_ordered_map_assoc(
            compacted,
            st_bench_key(compact_index),
            jv_i32(compact_index),
        );
        compact_index += 1;
    }
    compact_index = 0;
    while compact_index <s (20 as i32) {
        compacted = jv_ordered_map_dissoc(compacted, st_bench_key(compact_index));
        compact_index += 1;
    }
    st_assert(if jv_ordered_map_count(compacted) == 20 { 1 } else { 0 });
    st_assert(if pv_count(compacted.value.entries) == 20 { 1 } else { 0 });

    st_stage = 7;
    let (bad_default_status, _) = jv_record_schema_try_add(
        jv_record_schema_empty(),
        st_key(1),
        jv_type_i32(),
        jv_string(st_key(1)),
    );
    st_assert(if bad_default_status == jv_record_type_mismatch { 1 } else { 0 });
    let (invalid_default_status, _) = jv_record_schema_try_add_validated(
        jv_record_schema_empty(),
        st_key(1),
        jv_type_i32(),
        jv_i32(-1),
        null,
        st_nonnegative_field,
    );
    st_assert(if invalid_default_status == jv_record_field_invalid { 1 } else { 0 });
    let schema1 = jv_record_schema_add_validated(
        jv_record_schema_empty(),
        st_key(1),
        jv_type_i32(),
        jv_i32(0),
        null,
        st_nonnegative_field,
    );
    let (duplicate_status, _) = jv_record_schema_try_add(
        schema1,
        st_key(1),
        jv_type_i32(),
        jv_i32(0),
    );
    st_assert(if duplicate_status == jv_record_duplicate_field { 1 } else { 0 });
    let schema2 = jv_record_schema_add(schema1, st_key(2), jv_type_i32(), jv_i32(10));
    let definition = jv_record_type_create_validated(
        utf8_from_bytes("Range"),
        schema2,
        null,
        st_ordered_record,
    );
    st_assert(utf8_equal(jv_record_type_name(definition), utf8_from_bytes("Range")));
    st_assert(if jv_record_schema_count(jv_record_type_schema(definition)) == 2 { 1 } else { 0 });
    let record0 = jv_record_default(definition);
    st_assert(if jv_kind(record0) == jv_kind_record { 1 } else { 0 });
    st_assert(if jv_record_count(record0) == 2 { 1 } else { 0 });
    st_assert_record(record0, 1, 0);
    st_assert_record(record0, 2, 10);
    st_assert(if jv_record_has_field(record0, st_key(9)) == 0 { 1 } else { 0 });
    let (unknown_status, _) = jv_record_try_set(record0, st_key(9), jv_i32(1));
    st_assert(if unknown_status == jv_record_unknown_field { 1 } else { 0 });
    let (mismatch_status, _) = jv_record_try_set(record0, st_key(1), jv_bool(1));
    st_assert(if mismatch_status == jv_record_type_mismatch { 1 } else { 0 });
    let (field_status, _) = jv_record_try_set(record0, st_key(1), jv_i32(-1));
    st_assert(if field_status == jv_record_field_invalid { 1 } else { 0 });
    let record1 = jv_record_set(record0, st_key(1), jv_i32(5));
    st_assert_record(record0, 1, 0);
    st_assert_record(record1, 1, 5);
    st_assert(if jv_record_set(record1, st_key(1), jv_i32(5)) == record1 { 1 } else { 0 });
    let (record_status, _) = jv_record_try_set(record1, st_key(1), jv_i32(20));
    st_assert(if record_status == jv_record_value_invalid { 1 } else { 0 });
    let coordinated = jv_map_assoc(
        jv_map_assoc(jv_map_empty(), st_key(1), jv_i32(20)),
        st_key(2),
        jv_i32(30),
    );
    let record2 = jv_record_merge(record1, coordinated);
    st_assert_record(record2, 1, 20);
    st_assert_record(record2, 2, 30);
    st_assert(if jv_record_merge(record2, jv_record_to_map(record2)) == record2 { 1 } else { 0 });
    let record3 = jv_record_reset(record2, st_key(1));
    st_assert_record(record3, 1, 0);
    let record4 = jv_record_clear(record2);
    st_assert_record(record4, 1, 0);
    st_assert_record(record4, 2, 10);
    let unknown_overrides = jv_map_assoc(jv_map_empty(), st_key(9), jv_i32(99));
    let (strict_status, strict_field, _) = jv_record_try_from_map(definition, unknown_overrides);
    st_assert(if strict_status == jv_record_unknown_field { 1 } else { 0 });
    st_assert(utf8_equal(strict_field!, st_key(9)));
    let lenient = jv_record_from_map_lenient(definition, unknown_overrides);
    st_assert(jv_equal(lenient, record0));
    let record_copy = jv_record_from_map(definition, jv_record_to_map(record2));
    st_assert(jv_equal(record2, record_copy));
    st_assert(if jv_hash(record2) == jv_hash(record_copy) { 1 } else { 0 });
    let record_set = jv_set_add(jv_set_add(jv_set_empty(), record2), record_copy);
    st_assert(if jv_set_count(record_set) == 1 { 1 } else { 0 });
    st_assert(jv_set_contains(record_set, record_copy));
    let record_map1 = jv_map_assoc(jv_map_empty(), st_key(1), record2);
    let record_map2 = jv_map_assoc(jv_map_empty(), st_key(1), record_copy);
    st_assert(jv_equal(record_map1, record_map2));
    let other_definition = jv_record_type_create(utf8_from_bytes("Range"), schema2);
    st_assert(if jv_equal(record0, jv_record_default(other_definition)) == 0 { 1 } else { 0 });

    st_stage = 8;
    let integer_vector = jv_vector_push(jv_vector_empty(), jv_i32(1));
    let mixed_vector = jv_vector_push(integer_vector, jv_string(st_key(1)));
    st_assert(jv_type_accepts(jv_type_vector(jv_type_i32()), integer_vector));
    st_assert(if jv_type_accepts(jv_type_vector(jv_type_i32()), mixed_vector) == 0 { 1 } else { 0 });
    let integer_map = jv_map_assoc(jv_map_empty(), st_key(1), jv_i32(1));
    let mixed_map = jv_map_assoc(integer_map, st_key(2), jv_bool(1));
    st_assert(jv_type_accepts(jv_type_map(jv_type_i32()), integer_map));
    st_assert(if jv_type_accepts(jv_type_map(jv_type_i32()), mixed_map) == 0 { 1 } else { 0 });
    let integer_set = jv_set_add(jv_set_empty(), jv_i32(1));
    let mixed_set = jv_set_add(integer_set, jv_bool(1));
    st_assert(jv_type_accepts(jv_type_set(jv_type_i32()), integer_set));
    st_assert(if jv_type_accepts(jv_type_set(jv_type_i32()), mixed_set) == 0 { 1 } else { 0 });
    st_assert(jv_type_accepts(jv_type_ordered_map(jv_type_i32()), ordered_map3));
    st_assert(if jv_type_accepts(jv_type_ordered_map(jv_type_i32()), ordered_map4) == 1 { 1 } else { 0 });
    st_assert(if jv_type_accepts(jv_type_ordered_map(jv_type_i32()), map2) == 0 { 1 } else { 0 });
    let mixed_ordered_map = jv_ordered_map_assoc(ordered_map3, st_key(4), jv_bool(1));
    st_assert(if jv_type_accepts(jv_type_ordered_map(jv_type_i32()), mixed_ordered_map) == 0 { 1 } else { 0 });
    st_assert(jv_type_accepts(jv_type_ordered_set(jv_type_i32()), ordered_set1));
    st_assert(if jv_type_accepts(jv_type_ordered_set(jv_type_i32()), values1) == 0 { 1 } else { 0 });
    let mixed_ordered_set = jv_ordered_set_add(ordered_set1, jv_bool(1));
    st_assert(if jv_type_accepts(jv_type_ordered_set(jv_type_i32()), mixed_ordered_set) == 0 { 1 } else { 0 });
    st_assert(jv_type_accepts(jv_type_optional(jv_type_string()), jv_null()));
    st_assert(jv_type_accepts(jv_type_optional(jv_type_string()), jv_string(st_key(1))));
    st_assert(jv_type_accepts(jv_type_any(), record2));
    st_assert(jv_type_accepts(jv_type_opaque(), jv_any(payload)));
    st_assert(if jv_type_accepts(jv_type_opaque(), record2) == 0 { 1 } else { 0 });
    st_assert(jv_type_accepts(jv_type_record(definition), record2));
    st_assert(if jv_type_accepts(jv_type_record(other_definition), record2) == 0 { 1 } else { 0 });
    let transient_record = jv_record_as_transient(record1);
    jvt_record_set(transient_record, st_key(1), jv_i32(8));
    jvt_record_set(transient_record, st_key(2), jv_i32(12));
    let record5 = jvt_record_persistent(transient_record);
    st_assert_record(record5, 1, 8);
    st_assert_record(record5, 2, 12);
    st_stage = 9;
    1
}

#[export = "record_oracle_default"]
fn st_record_oracle_default() -> i32 {
    jv_require_i32(jv_record_at(jv_record_default(st_oracle_record_type()), st_key(1)))
}

#[export = "record_oracle_override"]
fn st_record_oracle_override() -> i32 {
    let definition = st_oracle_record_type();
    let record = jv_record_from_map(
        definition,
        jv_map_assoc(jv_map_empty(), st_key(1), jv_i32(7)),
    );
    jv_require_i32(jv_record_at(record, st_key(1)))
}

#[export = "record_oracle_reset"]
fn st_record_oracle_reset() -> i32 {
    let definition = st_oracle_record_type();
    let record = jv_record_set(jv_record_default(definition), st_key(1), jv_i32(7));
    jv_require_i32(jv_record_at(jv_record_reset(record, st_key(1)), st_key(1)))
}

#[export = "record_oracle_clear"]
fn st_record_oracle_clear() -> i32 {
    let definition = st_oracle_record_type();
    let record = jv_record_set(jv_record_default(definition), st_key(1), jv_i32(7));
    jv_require_i32(jv_record_at(jv_record_clear(record), st_key(1)))
}

#[export = "record_oracle_value_equal"]
fn st_record_oracle_value_equal() -> i32 {
    let definition = st_oracle_record_type();
    jv_equal(
        jv_record_set(jv_record_default(definition), st_key(1), jv_i32(7)),
        jv_record_from_map(definition, jv_map_assoc(jv_map_empty(), st_key(1), jv_i32(7))),
    )
}

#[export = "record_oracle_lenient_unknown"]
fn st_record_oracle_lenient_unknown() -> i32 {
    let definition = st_oracle_record_type();
    let record = jv_record_from_map_lenient(
        definition,
        jv_map_assoc(jv_map_empty(), st_key(9), jv_i32(9)),
    );
    jv_require_i32(jv_record_at(record, st_key(1)))
}

#[export = "ordered_map_oracle_update"]
fn st_ordered_map_oracle_update() -> i32 {
    let map = jv_ordered_map_assoc(
        jv_ordered_map_assoc(
            jv_ordered_map_assoc(jv_ordered_map_empty(), st_key(1), jv_i32(1)),
            st_key(2),
            jv_i32(2),
        ),
        st_key(3),
        jv_i32(3),
    );
    st_ordered_map_code(jv_ordered_map_assoc(map, st_key(2), jv_i32(8)))
}

#[export = "ordered_map_oracle_reinsert"]
fn st_ordered_map_oracle_reinsert() -> i32 {
    let map = jv_ordered_map_assoc(
        jv_ordered_map_assoc(
            jv_ordered_map_assoc(jv_ordered_map_empty(), st_key(1), jv_i32(1)),
            st_key(2),
            jv_i32(2),
        ),
        st_key(3),
        jv_i32(3),
    );
    st_ordered_map_code(
        jv_ordered_map_assoc(jv_ordered_map_dissoc(map, st_key(2)), st_key(2), jv_i32(2)),
    )
}

#[export = "ordered_set_oracle_duplicate"]
fn st_ordered_set_oracle_duplicate() -> i32 {
    let set = jv_ordered_set_add(
        jv_ordered_set_add(jv_ordered_set_add(jv_ordered_set_empty(), jv_i32(1)), jv_i32(2)),
        jv_i32(3),
    );
    st_ordered_set_code(jv_ordered_set_add(set, jv_i32(2)))
}

#[export = "ordered_set_oracle_reinsert"]
fn st_ordered_set_oracle_reinsert() -> i32 {
    let set = jv_ordered_set_add(
        jv_ordered_set_add(jv_ordered_set_add(jv_ordered_set_empty(), jv_i32(1)), jv_i32(2)),
        jv_i32(3),
    );
    st_ordered_set_code(
        jv_ordered_set_add(jv_ordered_set_remove(set, jv_i32(2)), jv_i32(2)),
    )
}

#[export = "stdlib_invalid_set_transient"]
fn st_invalid_set_transient() -> i32 {
    let value = phs_as_transient(phs_empty(wax_hash_i31_key, wax_equal_i31_key));
    let _ = phst_persistent(value);
    phst_count(value)
}

