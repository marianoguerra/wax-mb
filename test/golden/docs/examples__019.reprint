type chars = [i8];
type wide = [i16];

#[export = "newline"]
fn newline() -> i32 {
    '\n'; // 10
}

#[export = "greeting"]
fn greeting() -> &chars {
    chars#"hi!"; // the bytes 'h', 'i', '!'
}

#[export = "wide_greeting"]
fn wide_greeting() -> &wide {
    wide#"café"; // the UTF-16 units 'c', 'a', 'f', 'é'
}
