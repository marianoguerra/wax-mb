type t = fn(v128, v128, v128) -> v128;
type t_2 = fn(v128, v128) -> v128;
#[export = "add-sub"]
fn f(x: v128, x_2: v128, x_3: v128) -> v128 {
    x.sub_i32x4(x_2).add_i32x4(x_3);
}
#[export = "mul-add"]
fn f_2(x: v128, x_2: v128, x_3: v128) -> v128 {
    x.add_i32x4(x_2).mul_i32x4(x_3);
}
#[export = "mul-sub"]
fn f_3(x: v128, x_2: v128, x_3: v128) -> v128 {
    x.sub_i32x4(x_2).mul_i32x4(x_3);
}
#[export = "sub-add"]
fn f_4(x: v128, x_2: v128, x_3: v128) -> v128 {
    x.add_i32x4(x_2).sub_i32x4(x_3);
}
#[export = "add-neg"]
fn f_5(x: v128, x_2: v128) -> v128 {
    x.neg_i32x4().add_i32x4(x_2);
}
#[export = "mul-neg"]
fn f_6(x: v128, x_2: v128) -> v128 {
    x.neg_i32x4().mul_i32x4(x_2);
}
#[export = "sub-neg"]
fn f_7(x: v128, x_2: v128) -> v128 {
    x.neg_i32x4().sub_i32x4(x_2);
}
