type t = fn(i32) -> i32;
type t_2 = fn(i64) -> i64;
#[export = "i32.div_s_3"]
fn f(x: i32) -> i32 {
    x /s 3;
}
#[export = "i32.div_u_3"]
fn f_2(x: i32) -> i32 {
    x /u 3;
}
#[export = "i64.div_s_3"]
fn f_3(x: i64) -> i64 {
    x /s 3;
}
#[export = "i64.div_u_3"]
fn f_4(x: i64) -> i64 {
    x /u 3;
}
