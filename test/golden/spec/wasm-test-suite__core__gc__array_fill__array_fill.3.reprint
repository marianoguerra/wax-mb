type arr8 = [i8];
type arr8_mut = [mut i8];
type t = fn(i32) -> i32;
type t_2 = fn();
type t_3 = fn(i32, i32, i32);
#[export]
fn array_get_nth(x: i32) -> i32 {
    g_arr8_mut[x] as i32_u;
}
#[export = "array_fill-null"]
fn f() {
    (null as &?arr8_mut).fill(0, 0, 0);
}
#[export]
fn array_fill(x: i32, x_2: i32, x_3: i32) {
    g_arr8_mut.fill(x, x_2, x_3);
}
const g_arr8: &arr8 = [10; 12];
let g_arr8_mut: &arr8_mut = [..; 12];
