fn i16_store_little(address: i64, value: i32) {
    m.store8(address, value);
    m.store8(address + 1, value >>u 8);
}
fn i32_store_little(address: i64, value: i32) {
    i16_store_little(address, value);
    i16_store_little(address + 2, value >>u 16);
}
fn i64_store_little(address: i64, value: i64) {
    i32_store_little(address, value as i32);
    i32_store_little(address + 4, (value >>u 32) as i32);
}
fn i16_load_little(address: i64) -> i32 {
    m.load8(address) as i32_u | m.load8(address + 1) as i32_u << 8;
}
fn i32_load_little(address: i64) -> i32 {
    i16_load_little(address) | i16_load_little(address + 2) << 16;
}
fn i64_load_little(address: i64) -> i64 {
    i32_load_little(address) as i64_u | i32_load_little(address + 4) as i64_u << 32;
}
#[export]
fn i32_load16_s(value: i32) -> i32 {
    i16_store_little(0, value);
    m.load16(0) as i32_s;
