#[import = "mem"]
memory mem1: i32 [2];
#[export]
fn read1(x: i32) -> i32 {
    mem1.load8(x) as i32_u;
}
#[export]
fn read2(x: i32) -> i32 {
    mem2.load8(x) as i32_u;
