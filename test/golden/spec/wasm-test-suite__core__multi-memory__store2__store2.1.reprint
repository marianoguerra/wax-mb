#[export = "copy-1-to-2"]
fn f() 'l: {
    let i = 20;
    'cont: loop {
        br_if 'l i == 23;
        mem2.store8(i, mem1.load8(i) as i32_u);
        i += 1;
        br 'cont;
    }
}
#[export = "copy-2-to-1"]
fn f_2() 'l: {
    let i = 50;
