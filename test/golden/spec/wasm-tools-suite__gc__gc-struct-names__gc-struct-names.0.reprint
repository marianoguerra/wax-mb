type named = { x: i32, y: i32 };
type partially_named = { x: i32, f: i32 };
type unnamed = { f: i32, f_2: i32 };
type t = fn(&named, &partially_named, &unnamed);
fn f(x: &named, x_2: &partially_named, x_3: &unnamed) {
    (x := { x: 1, y: 2 }).x;
    _ = x.y;
    _ = _;
    (x_2 := { x: 1, f: 2 }).x;
    _ = x_2.f;
    _ = _;
    (x_3 := { f: 1, f_2: 2 }).f;
    _ = x_3.f_2;
    _ = _;
}
