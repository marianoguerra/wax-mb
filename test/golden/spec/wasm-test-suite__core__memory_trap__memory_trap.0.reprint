type t = fn() -> i32;
type t_2 = fn(i32, i32);
type t_3 = fn(i32) -> i32;
fn addr_limit() -> i32 {
    m.size() * 65536;
}
#[export]
fn store(i: i32, v: i32) {
    m.store32(addr_limit() + i, v);
}
#[export]
fn load(i: i32) -> i32 {
    m.load32(addr_limit() + i);
}
#[export = "memory.grow"]
fn f(x: i32) -> i32 {
    m.grow(x);
}
memory m: i32 [1];
