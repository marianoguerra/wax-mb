type t = fn(i32) -> i32;
type t_2 = fn(i32, i32) -> i32;
#[export]
fn grow(x: i32) -> i32 {
    m.grow(x);
}
#[export = "check-memory-zero"]
fn f(x: i32, x_2: i32) -> i32 {
    let x_3 = 1;
    'l: do {
        'l_2: loop {
            x_3 = m.load8(x) as i32_u;
            br_if 'l x_3 != 0;
            br_if 'l x >=u x_2;
            x += 1;
            br_if 'l_2 x <=u x_2;
        }
    }
    x_3;
}
memory m: i32 [1];
