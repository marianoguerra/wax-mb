type t = fn(v128, v128, v128) -> v128;
#[export = "test-consistent-nondeterminism"]
fn f(x: v128, x_2: v128, x_3: v128) -> v128 {
    v128::i8x16(
        255,
        255,
        127,
        127,
        255,
        255,
        127,
        127,
        255,
        255,
        127,
        127,
        255,
        255,
        127,
        127,
    ).relaxed_madd_f32x4(
        v128::i8x16(0, 0, 0, 64, 0, 0, 0, 64, 0, 0, 0, 64, 0, 0, 0, 64),
        v128::i8x16(255, 255, 127, 255, 255, 255, 127, 255, 255, 255, 127, 255, 255, 255, 127, 255),
    ).eq_f32x4(
        x.relaxed_madd_f32x4(x_2, x_3),
    );
}
