type t = fn() -> v128;
#[export]
fn f32x4_sqrt_arith() -> v128 {
    v128::i8x16(0, 0, 160, 127, 0, 0, 160, 255, 0, 0, 128, 65, 0, 0, 200, 65).sqrt_f32x4();
}
#[export]
fn f32x4_sqrt_canon() -> v128 {
    v128::i8x16(0, 0, 128, 191, 0, 0, 192, 127, 0, 0, 128, 64, 0, 0, 16, 65).sqrt_f32x4();
}
#[export]
fn f32x4_sqrt_mixed() -> v128 {
    v128::i8x16(0, 0, 128, 255, 0, 0, 160, 127, 0, 0, 16, 66, 0, 0, 68, 66).sqrt_f32x4();
}
