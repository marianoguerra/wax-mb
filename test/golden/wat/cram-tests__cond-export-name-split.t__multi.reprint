import "x" fn getuid() -> i32;
#[if(wasi)]
{
    #[export]
    #[export = "caml_unix_getuid"]
    #[export = "unix_geteuid"]
    #[export = "caml_unix_geteuid"]
    fn unix_getuid(&eq) -> &eq {
        1 as &i31;
    }
}
#[else]
{
    #[export]
    #[export = "caml_unix_getuid"]
    fn unix_getuid(&eq) -> &eq {
        getuid() as &i31;
    }
    #[export]
    #[export = "caml_unix_geteuid"]
    fn unix_geteuid(&eq) -> &eq {
        getuid() as &i31;
    }
}
