type t = fn() -> i64;
type t_2 = fn(i64, i32);
type t_3 = fn(i64) -> i32;
type t_4 = fn(i64) -> i64;
fn addr_limit() -> i64 {
    m.size() * 65536;
}
#[export]
fn store(i: i64, v: i32) {
    m.store32(addr_limit() + i, v);
}
#[export]
fn load(i: i64) -> i32 {
    m.load32(addr_limit() + i);
}
#[export = "memory.grow"]
fn f(x: i64) -> i64 {
    m.grow(x);
}
memory m: i64 [1];
