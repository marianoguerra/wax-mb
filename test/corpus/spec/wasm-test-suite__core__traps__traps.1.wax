type t = fn(i32, i32);
type t_2 = fn(i64, i64);
#[export = "no_dce.i32.rem_s"]
fn f(x: i32, y: i32) {
    _ = x %s y;
}
#[export = "no_dce.i32.rem_u"]
fn f_2(x: i32, y: i32) {
    _ = x %u y;
}
#[export = "no_dce.i64.rem_s"]
fn f_3(x: i64, y: i64) {
    _ = x %s y;
}
#[export = "no_dce.i64.rem_u"]
fn f_4(x: i64, y: i64) {
    _ = x %u y;
}
