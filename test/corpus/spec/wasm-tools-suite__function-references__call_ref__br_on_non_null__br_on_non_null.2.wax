type t = fn(i32) -> i32;
type t_2 = fn(i32, &?t) -> i32;
type t_3 = fn() -> (i32, &t);
fn f(x: i32) -> i32 {
    x * x;
}
fn a(n: i32, r: &?t) -> i32 {
    'l: do () -> (i32, &t) {
        return br_on_non_null 'l (n, r);
    }
    _(_);
}
#[export = "args-null"]
fn f_2(n: i32) -> i32 {
    a(n, null);
}
#[export = "args-f"]
fn f_3(n: i32) -> i32 {
    a(n, f);
}
elem e: &func = [f];
