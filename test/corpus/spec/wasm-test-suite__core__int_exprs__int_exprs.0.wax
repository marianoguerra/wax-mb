type t = fn(i32, i32) -> i32;
type t_2 = fn(i64, i64) -> i32;
#[export = "i32.no_fold_cmp_s_offset"]
fn f(x: i32, y: i32) -> i32 {
    x + 1 <s y + 1;
}
#[export = "i32.no_fold_cmp_u_offset"]
fn f_2(x: i32, y: i32) -> i32 {
    x + 1 <u y + 1;
}
#[export = "i64.no_fold_cmp_s_offset"]
fn f_3(x: i64, y: i64) -> i32 {
    x + 1 <s y + 1;
}
#[export = "i64.no_fold_cmp_u_offset"]
fn f_4(x: i64, y: i64) -> i32 {
    x + 1 <u y + 1;
}
