type t = fn(i64, i64, i32) -> i64;
type t_2 = fn();
#[export]
fn checkRange(from: i64, to: i64, expected: i32) -> i64 {
    'cont: loop {
        if from == to {
            return -1;
        }
        if m.load8(from) as i32_u == expected {
            from += 1;
            br 'cont;
        }
    }
    return from;
}
#[export]
fn test() {
    m.fill(18, 85, 0);
}
memory m: i64 [1, 1];
