#![module = "scheduler"]
type func_2 = fn();
type cont_2 = cont func_2;
type t = fn(&cont_2);
type t_2 = fn() -> i32;
type t_3 = fn() -> &?cont_2;
type t_4 = fn(&?cont_2);
type t_5 = fn() -> (&cont_2, &cont_2);
import "lwt" {
    tag yield: func_2 ;
    tag fork: t ;
}
import "queue" {
    #[import = "queue-empty"]
    fn f() -> i32;
    fn dequeue() -> &?cont_2;
    fn enqueue(&cont_2);
}
#[export]
fn sync(nextk: &?cont_2) {
    if !nextk {
        return;
    }
    become sync(
        'on_yield: do &cont_2 {
            'on_fork: do () -> (&cont_2, &cont_2) {
                nextk.resume() on [yield -> 'on_yield, fork -> 'on_fork];
                become sync(dequeue());
            }
            nextk = _;
            enqueue(_);
            become sync(nextk);
        },
    );
}
#[export]
fn kt(nextk: &?cont_2) {
    if !nextk {
        return;
    }
    enqueue(
        'on_yield: do {
            'on_fork: do () -> (&cont_2, &cont_2) {
                nextk.resume() on [yield -> 'on_yield, fork -> 'on_fork];
                become tk(dequeue());
            }
            nextk = _;
            enqueue(_);
            become tk(nextk);
        },
    );
    become tk(dequeue());
}
