#[export]
fn ytk(nextk: &?cont_2) {
    if !nextk {
        return;
    }
    enqueue(
        'on_yield: do {
            'on_fork: do () -> (&cont_2, &cont_2) {
                nextk.resume() on [yield -> 'on_yield, fork -> 'on_fork];
                become ytk(dequeue());
            }
            let k = _;
            enqueue(_);
            enqueue(k);
            become ytk(dequeue());
        },
    );
    become ytk(dequeue());
}
