#![module = "scheduler"]
type func_2 = fn();
type cont_2 = cont func_2;
type t = fn(&cont_2);
type t_2 = fn() -> i32;
type t_3 = fn() -> &?cont_2;
type t_4 = fn() -> (&cont_2, &cont_2);
import "lwt" {
    tag yield: func_2 ;
    tag fork: t ;
}
import "queue" {
    #[import = "queue-empty"]
    fn f() -> i32;
    fn dequeue() -> &?cont_2;
    fn enqueue(&cont_2);
}
#[export]
fn run(main: &cont_2) {
    enqueue(main);
    'l: loop {
        if f() {
            return;
        }
        enqueue(
            'on_yield: do {
                'on_fork: do () -> (&cont_2, &cont_2) {
                    dequeue().resume() on [yield -> 'on_yield, fork -> 'on_fork];
                    br 'l;
                }
                enqueue(_);
                enqueue(_);
                br 'l;
            },
        );
        br 'l;
    }
}
