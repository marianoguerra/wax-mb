type t = fn(i64) -> i64;
type t_2 = fn(i64) -> (i64, i64);
type t_3 = fn(i64, i64) -> (i64, i64, i64);
type t_4 = fn(i64, i64) -> i64;
#[export = "fac-rec"]
fn f(x: i64) -> i64 {
    if x == 0 {
        1;
    } else {
        x * f(x - 1);
    }
}
#[export = "fac-rec-named"]
fn f_2(n: i64) -> i64 {
    if n == 0 {
        1;
    } else {
        n * f_2(n - 1);
    }
}
#[export = "fac-iter"]
fn f_3(x: i64) -> i64 {
    let x_2 = x;
    let x_3: i64 = 1;
    'l: do {
        'l_2: loop {
            if x_2 == 0 {
                br 'l;
            } else {
                x_3 = x_2 * x_3;
                x_2 -= 1;
            }
            br 'l_2;
        }
    }
    x_3;
}
#[export = "fac-iter-named"]
fn f_4(n: i64) -> i64 {
    let i = n;
    let res: i64 = 1;
    'done: do {
        'loop: loop {
            if i == 0 {
                br 'done;
            } else {
                res = i * res;
                i -= 1;
            }
            br 'loop;
        }
    }
    res;
}
#[export = "fac-opt"]
fn f_5(x: i64) -> i64 {
    let x_2: i64 = 1;
    'l: do {
        br_if 'l x <s 2;
        'l_2: loop {
            x_2 *= x;
            x += -1;
            br_if 'l_2 x >s 1;
        }
    }
    x_2;
}
fn pick0(x: i64) -> (i64, i64) {
    x;
    x;
}
fn pick1(x: i64, x_2: i64) -> (i64, i64, i64) {
    x;
    x_2;
    x;
}
#[export = "fac-ssa"]
fn f_6(x: i64) -> i64 {
    1;
    x;
    'l: loop (i64, i64) -> i64 {
        pick1(_, _);
        pick1(_, _);
        pick1(_, _ * _);
        pick0(_ - 1);
        br_if 'l (_, _, _ >u 0);
        _ = _;
        return _;
    }
}
