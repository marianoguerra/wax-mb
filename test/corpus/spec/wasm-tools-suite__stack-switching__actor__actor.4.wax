#![module = "scheduler"]
type func_2 = fn();
type cont_2 = cont func_2;
type t = fn(i32);
type t_2 = cont t;
type t_3 = fn(&t_2);
type t_4 = cont t_3;
type t_5 = fn(i32) -> i32;
type t_6 = fn() -> i32;
type t_7 = fn(i32, i32);
type t_8 = fn() -> &?cont_2;
type t_9 = fn(&cont_2);
type t_10 = fn(&cont_2) -> i32;
type t_11 = fn(&t_2) -> &cont_2;
type t_12 = fn(&?cont_2);
type t_13 = fn() -> (&cont_2, &t_2);
type t_14 = fn() -> (i32, i32, &cont_2);
import "spectest"
#[import = "print_i32"]
fn log(i32);
import "mailboxes" {
    fn init();
    #[import = "empty-mb"]
    fn f(i32) -> i32;
    #[import = "new-mb"]
    fn f_2() -> i32;
    #[import = "send-to-mb"]
    fn f_3(i32, i32);
    #[import = "recv-from-mb"]
    fn f_4(i32) -> i32;
}
import "queue" {
    #[import = "dequeue-mb"]
    fn f_5() -> i32;
    #[import = "enqueue-mb"]
    fn f_6(i32);
    #[import = "dequeue-k"]
    fn f_7() -> &?cont_2;
    #[import = "enqueue-k"]
    fn f_8(&cont_2);
}
import "actor" {
    tag self: t_6 ;
    tag spawn: t_10 ;
    tag send: t_7 ;
    tag recv: t_6 ;
}
fn f_9(ik: &t_2) {
    let res = suspend recv();
    ik.resume(res);
}
fn f_10(ik: &t_2) -> &cont_2 {
    cont_2::bind(ik, t_4::new(f_9));
}
#[export]
fn run(nextk: &?cont_2) {
    init();
    let mine = f_2();
    'l: loop {
        if !nextk {
            return;
        }
        let ik: &t_2;
        ik =
            'on_self: do {
                'on_spawn: do () -> (&cont_2, &t_2) {
                    'on_send: do () -> (i32, i32, &cont_2) {
                        ik =
                            'on_recv: do {
                                nextk.resume() on
                                    [self -> 'on_self, spawn -> 'on_spawn, send -> 'on_send, recv ->
                                     'on_recv];
                                mine = f_5();
                                nextk = f_7();
                                br 'l;
                            };
                        if f(mine) {
                            f_6(mine);
                            f_8(f_10(ik));
                            mine = f_5();
                            nextk = f_7();
                            br 'l;
                        }
                        nextk = cont_2::bind(f_4(mine), ik);
                        br 'l;
                    }
                    let k = _;
                    f_3(_, _);
                    nextk = k;
                    br 'l;
                }
                ik = _;
                let you = _;
                let yours = f_2();
                f_6(yours);
                f_8(you);
                nextk = cont_2::bind(yours, ik);
                br 'l;
            };
        nextk = cont_2::bind(mine, ik);
        br 'l;
    }
}
