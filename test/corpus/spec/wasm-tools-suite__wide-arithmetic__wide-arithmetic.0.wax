type t = fn(i64, i64, i64, i64) -> (i64, i64);
type t_2 = fn(i64, i64) -> (i64, i64);
fn f(x: i64, x_2: i64, x_3: i64, x_4: i64) -> (i64, i64) {
    i64::add128(x, x_2, x_3, x_4);
}
fn f_2(x: i64, x_2: i64, x_3: i64, x_4: i64) -> (i64, i64) {
    i64::sub128(x, x_2, x_3, x_4);
}
fn f_3(x: i64, x_2: i64) -> (i64, i64) {
    i64::mul_wide_s(x, x_2);
}
fn f_4(x: i64, x_2: i64) -> (i64, i64) {
    i64::mul_wide_u(x, x_2);
}
