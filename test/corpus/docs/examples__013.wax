tag divide_by_zero();
tag overflow();

#[export = "safe_divide"]
fn safe_divide(a: i32, b: i32) -> i32 {
    if b == 0 {
        throw divide_by_zero();
    }
    a /s b;
}

#[export = "try_divide"]
fn try_divide(a: i32, b: i32) -> i32 {
    try i32 {
        safe_divide(a, b);
    } catch {
        divide_by_zero => { 0; }   // return 0 on division by zero
    }
}
