fn lookup(k: i32) -> i32 {
    't: try i32 {
        find(k);                     // may throw `overflow` or `timeout`
    } catch {
        overflow => { br 't _; }     // `_` is the thrown i32 payload
        timeout & => { _ = _; br 't (0 - 1); }  // drop the &exn, escape
        _ => { 0; }                  // catch-all supplies the value
    }
}
