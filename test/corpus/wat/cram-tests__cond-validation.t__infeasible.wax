// The inner then-branch requires $ver < 1.0.0 while the outer branch already
// assumes $ver >= 5.0.0, so the ill-typed (f32.const 1) is unreachable.
fn f() -> i32 {
    #[if(ver >= (5, 0, 0))]
    {
        #[if(ver < (1, 0, 0))]
        {
            1;
        }
        #[else]
        {
            2;
        }
    }
    #[else]
    {
        3;
    }
}
