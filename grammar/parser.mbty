// The Wax grammar, translated from wax/src/lib-wax/parser.mly (Menhir).
//
// This file is the single source of truth for BOTH the parser and the token
// definitions: tokens/ generates its Token / TokenKind enums from this same
// file with `moonyacc --mode only-tokens`, exactly as moonbitlang/parser
// generates lexer/tokens/tokens.mbt from yacc_parser/parser.mbty. Keeping one
// grammar file means a token can never be declared here and missing there.
//
// MoonYacc is ocamlyacc-compatible and, like Menhir, is built on Pager's LR(1)
// algorithm, so most of the translation is mechanical: $loc, $loc($n), $sloc,
// %prec, %inline, %left/%right/%nonassoc and `%token X "alias"` all carry over
// unchanged. Three things do not:
//
//   * %parameter<Context> -- Menhir functorises the grammar over the trivia
//     context so every semantic action can register its span. MoonBit has no
//     functors; the context becomes a package-level Ref set at parse entry.
//     (Consequence: parsing is not reentrant. Documented, and fine for a CLI.)
//
//   * %on_error_reduce -- no MoonYacc equivalent. It only shapes WHICH state an
//     error is reported from, so dropping it costs message quality, not
//     correctness, and message wording is explicitly not gated yet.
//
//   * Every rule must state its result type (`nonterm -> Type`), which Menhir
//     infers from the OCaml actions.
//
// MoonYacc also has no error recovery, so `--all-errors` / panic-mode recovery
// is out of scope. That matches the reference's DEFAULT behaviour, which stops
// at the first syntax error.

%position<Position>

// TokenKind is given Debug by MoonYacc itself; asking for it again is a
// duplicate-method error.
%derive<Debug> Token
%derive<Eq> TokenKind
%derive<Hash> TokenKind
%derive<Compare> TokenKind

// ---------------------------------------------------------------------------
// Terminals
// ---------------------------------------------------------------------------

// Numeric literals stay RAW STRINGS through the whole front end -- they are
// never converted to numbers here. That is what makes byte-exact round-tripping
// possible (0x1_0 must print back as written, not as 16), and it is also what
// the type checker's flexible-literal inference will need later.
%token<String> IDENT
%token<String> INT
%token<String> FLOAT

// A string literal carries its own span, not just its text: a data segment is
// written as a run of adjacent literals whose bytes are concatenated, and a
// diagnostic has to be able to point at the individual piece that is wrong.
%token<LocString> STRING
%token<Char> CHAR

%token EOF
%token INF NAN

%token SEMI ";"
%token SHARP "#"
%token QUESTIONMARK "?"
%token LPAREN "("
%token RPAREN ")"
%token LBRACE "{"
%token RBRACE "}"
%token LBRACKET "["
%token RBRACKET "]"
%token COMMA ","
%token COLON ":"
%token COLONCOLON "::"
%token ARROW "->"
%token FATARROW "=>"
%token EQUAL "="
%token COLONEQUAL ":="
%token AT "@"
%token QUOTE "'"
%token DOT "."
%token DOTDOT ".."
%token BANG "!"

%token PLUS "+"
%token PLUSPLUS "++"
%token PLUSEQUAL "+="
%token MINUS "-"
%token MINUSEQUAL "-="
%token STAR "*"
%token STAREQUAL "*="

// Wasm distinguishes signed and unsigned division, remainder, shift and
// comparison, so Wax spells the signedness on the operator itself (`/s`, `>>u`,
// `<=s`). Each has a compound-assignment form.
%token SLASH "/"
%token SLASHEQUAL "/="
%token SLASHS "/s"
%token SLASHSEQUAL "/s="
%token SLASHU "/u"
%token SLASHUEQUAL "/u="
%token PERCENTS "%s"
%token PERCENTSEQUAL "%s="
%token PERCENTU "%u"
%token PERCENTUEQUAL "%u="

%token AMPERSAND "&"
%token AMPERSANDEQUAL "&="
%token PIPE "|"
%token PIPEEQUAL "|="
%token CARET "^"
%token CARETEQUAL "^="
%token SHL "<<"
%token SHLEQUAL "<<="
%token SHRS ">>s"
%token SHRSEQUAL ">>s="
%token SHRU ">>u"
%token SHRUEQUAL ">>u="

%token EQUALEQUAL "=="
%token BANGEQUAL "!="
%token GT ">"
%token GTS ">s"
%token GTU ">u"
%token LT "<"
%token LTS "<s"
%token LTU "<u"
%token GE ">="
%token GES ">=s"
%token GEU ">=u"
%token LE "<="
%token LES "<=s"
%token LEU "<=u"

%token UNDERSCORE "_"

// Keywords.
%token FN
%token TAG
%token MUT
%token TYPE
%token REC
%token OPEN
%token NOP UNREACHABLE NULL
%token DO WHILE LOOP IF ELSE
%token CONST LET AS IS
%token BECOME
%token BR BR_IF BR_TABLE RETURN THROW THROW_REF
%token BR_ON_CAST BR_ON_CAST_FAIL
%token BR_ON_NULL BR_ON_NON_NULL
%token TRY TRY_LEGACY CATCH
%token CONT
%token SUSPEND ON
%token DISPATCH
%token MATCH
%token MEMORY DATA TABLE ELEM PAGESIZE SHARED
%token DESCRIPTOR DESCRIBES
%token IMPORT

// ---------------------------------------------------------------------------
// Precedence, lowest first
// ---------------------------------------------------------------------------
//
// Transcribed unchanged from parser.mly:119-133. The ordering is load-bearing
// and subtle -- see the reference's own notes at parser.mly:135 for the cases
// it is tuned against, e.g. `br 'foo 1 + 2` parsing as `br 'foo (1 + 2)`, and
// `{a| b:}` resolving as a struct.
//
// prec_ident, prec_block, prec_branch and prec_unary are precedence-only
// pseudo-symbols used by %prec; they are not real terminals and do not appear
// in the generated Token enum.

%nonassoc prec_ident prec_block
%right prec_branch
%right ":=" "="
%right "?" ":"
%nonassoc "==" "!=" "<" "<u" "<s" ">" ">u" ">s" "<=" "<=u" "<=s" ">=" ">=u" ">=s"
%left "|"
%left "^"
%left "&"
%left "<<" ">>u" ">>s"
%left "+" "-"
%left "*" "/" "/u" "/s" "%u" "%s"
%left AS IS ON
%nonassoc prec_unary
%nonassoc "!"
%left "." "(" "["


%start parse

%%

// ===========================================================================
// Generic list helpers
// ===========================================================================
//
// Wax allows a trailing separator in every comma-separated list, so the
// standard `separated_list` is not enough. The reference defines these as
// parameterised rules and so do we -- MoonYacc supports the same form.

non_empty_sep_trailing[T](SEP, X : T) -> Array[T]
  : X { [$1] }
  | X SEP { [$1] }
  | X SEP non_empty_sep_trailing(SEP, X) { [$1, ..$3] }
  ;

sep_trailing[T](SEP, X : T) -> Array[T]
  : { [] }
  | non_empty_sep_trailing(SEP, X) { $1 }
  ;

// ===========================================================================
// Identifiers
// ===========================================================================

%inline ident -> Ident
  : IDENT { { name: $1, loc: loc_of($loc($1)) } }
  ;

// A label may be spelled with a keyword -- `'loop`, `'if` -- because a label
// lives in its own namespace and the leading `'` already disambiguates. The
// lexer cannot know that, so the grammar spells out every keyword here.
ident_or_keyword -> String
  : IDENT { $1 }
  | FN { "fn" }
  | TAG { "tag" }
  | MUT { "mut" }
  | TYPE { "type" }
  | REC { "rec" }
  | OPEN { "open" }
  | NOP { "nop" }
  | UNREACHABLE { "unreachable" }
  | NULL { "null" }
  | DO { "do" }
  | WHILE { "while" }
  | LOOP { "loop" }
  | IF { "if" }
  | ELSE { "else" }
  | CONST { "const" }
  | LET { "let" }
  | AS { "as" }
  | IS { "is" }
  | BECOME { "become" }
  | BR { "br" }
  | BR_IF { "br_if" }
  | BR_TABLE { "br_table" }
  | RETURN { "return" }
  | THROW { "throw" }
  | THROW_REF { "throw_ref" }
  | BR_ON_CAST { "br_on_cast" }
  | BR_ON_CAST_FAIL { "br_on_cast_fail" }
  | BR_ON_NULL { "br_on_null" }
  | BR_ON_NON_NULL { "br_on_non_null" }
  | TRY { "try" }
  | TRY_LEGACY { "try_legacy" }
  | CATCH { "catch" }
  | CONT { "cont" }
  | SUSPEND { "suspend" }
  | ON { "on" }
  | MEMORY { "memory" }
  | IMPORT { "import" }
  | PAGESIZE { "pagesize" }
  | SHARED { "shared" }
  | DATA { "data" }
  | TABLE { "table" }
  | ELEM { "elem" }
  | DISPATCH { "dispatch" }
  | MATCH { "match" }
  | DESCRIPTOR { "descriptor" }
  | DESCRIBES { "describes" }
  | INF { "inf" }
  | NAN { "nan" }
  ;

label_name -> String
  : ident_or_keyword { $1 }
  ;

%inline label -> Ident
  : "'" label_name { { name: $2, loc: loc_of($sloc) } }
  ;

// ===========================================================================
// Types
// ===========================================================================

heap_type -> HeapType
  : CONT { Cont }
  | ident { heap_type_of($1) }
  ;

reference_type -> RefType
  : "&" boption("?") boption("!") heap_type {
      let typ = if $3 { make_exact($sloc, $4) } else { $4 }
      { nullable: $2, typ }
    }
  ;

value_type -> ValType
  : IDENT { value_type_of($loc($1), $1) }
  | reference_type { Ref($1) }
  ;

cast_type -> CastType
  : IDENT { cast_type_of($loc($1), $1) }
  | reference_type { Value(Ref($1)) }
  | "&" boption("?") FN function_type_as { Func(nullable=$2, sign=$4) }
  ;

result_type_ -> Array[ValType]
  : non_empty_sep_trailing(",", value_type) { $1 }
  ;

result_type -> Array[ValType]
  : "(" ")" { [] }
  | value_type { [$1] }
  | "(" result_type_ ")" { $2 }
  ;

storage_type -> StorageType
  : IDENT { storage_type_of($loc($1), $1) }
  | reference_type { Value(Ref($1)) }
  ;

field_type -> FieldType
  : boption(MUT) storage_type { { mut_: $1, typ: $2 } }
  ;

field_name -> Ident
  : ident { $1 }
  ;

structure_type_field -> Annotated[(Ident, FieldType), Location]
  : field_name ":" field_type { annot($sloc, ($1, $3)) }
  ;

structure_type -> Array[Annotated[(Ident, FieldType), Location]]
  : sep_trailing(",", structure_type_field) { $1 }
  ;

// A leading `..` inherits the supertype's fields. It must come first and appear
// at most once, which these three productions enforce structurally rather than
// by a check in the action.
structtype -> Array[Annotated[(Ident, FieldType), Location]]
  : "{" ".." "}" { [@ast.splice_field(loc_of($sloc))] }
  | "{" ".." "," structure_type "}" {
      [@ast.splice_field(loc_of($sloc)), ..$4]
    }
  | "{" structure_type "}" { $2 }
  ;

arraytype -> FieldType
  : "[" field_type "]" { $2 }
  ;

composite_type -> CompType
  : structtype { Struct($1) }
  | function_type_definition { Func($1) }
  | arraytype { Array($1) }
  // A continuation type wraps a NAMED function type: `cont ft`.
  | CONT type_name { Cont($2) }
  ;

type_name -> Ident
  : ident { $1 }
  ;

type_definition -> Annotated[(Ident, SubType), Location]
  : TYPE type_name option(supertype_clause) "=" boption(OPEN)
    ioption(describes_clause) ioption(descriptor_clause) composite_type ";" {
      annot($sloc, ($2, {
        typ: $8,
        supertype: $3,
        // `open` is the spelling; the AST stores the negation, because
        // final-by-default is what WebAssembly encodes.
        final_: not($5),
        descriptor: $7,
        describes: $6,
      }))
    }
  ;

%inline supertype_clause -> Ident
  : ":" type_name { $2 }
  ;

%inline describes_clause -> Ident
  : DESCRIBES type_name { $2 }
  ;

%inline descriptor_clause -> Ident
  : DESCRIPTOR type_name { $2 }
  ;

rectype -> Annotated[Array[Annotated[(Ident, SubType), Location]], Location]
  : REC "{" list_of(type_definition) "}" { annot($loc($1), $3) }
  // Reuse the type definition's OWN already-registered span rather than
  // registering a duplicate for the same range, which would split trivia
  // between the two.
  | type_definition { { desc: [$1], info: $1.info } }
  ;

// An array-returning list. The stdlib's `list` yields @list.List, but the AST
// holds arrays; left recursion also keeps this linear rather than quadratic.
list_of[T](X : T) -> Array[T]
  : { [] }
  | list_of(X) X { $1.push($2); $1 }
  ;

// ===========================================================================
// Attributes
// ===========================================================================

attribute_expression -> Instr[Location]
  : expression { $1 }
  ;

// `import` heads a grouped-import block, so it is a keyword rather than an
// IDENT; accept it explicitly so `#[import = ...]` keeps working.
%inline attribute_name -> String
  : IDENT { $1 }
  | IMPORT { "import" }
  ;

// An optional conditional-compilation guard on a SINGLE attribute,
// `#[export = "n", if(not(portable))]`. It reuses the `#[if(...)]` condition
// grammar, parentheses included; only `export` accepts one, which the typer
// checks.
attribute_guard -> Annotated[Cond, Location]?
  : { None }
  | "," IF "(" condition ")" { Some({ desc: $4, info: loc_of($loc($2)) }) }
  ;

attribute -> Attribute
  : "#" "[" attribute_name "=" attribute_expression attribute_guard "]" {
      {
        attr_name: $3,
        attr_value: Some($5),
        attr_guard: $6,
        attr_span: loc_of($sloc),
      }
    }
  | "#" "[" attribute_name attribute_guard "]" {
      {
        attr_name: $3,
        attr_value: None,
        attr_guard: $4,
        attr_span: loc_of($sloc),
      }
    }
  ;

// One hint attribute, carrying its own span so a diagnostic about a misplaced
// hint points at the attribute rather than at the instruction it decorates.
hint_attr -> ((Position, Position), HintSetter)
  : attribute { ($loc($1), hint_of_attr($loc($1), $1)) }
  | "#" "[" IDENT "(" sep_trailing(",", hint_target) ")" "]" {
      ($sloc, targets_of_attr($sloc, $3, $5))
    }
  ;

// One likely callee of an indirect call, with how often it is taken as a
// fraction of 1.
hint_target -> (Ident, Int)
  : ident ":" target_fraction { ($1, $3) }
  ;

%inline target_fraction -> Int
  : FLOAT { target_percent($loc($1), $1) }
  | INT { target_percent($loc($1), $1) }
  ;

// A module-level inner attribute, `#![module = "name"]`.
inner_attribute -> Attribute
  : "#" "!" "[" IDENT "=" attribute_expression "]" {
      {
        attr_name: $4,
        attr_value: Some($6),
        attr_guard: None,
        attr_span: loc_of($sloc),
      }
    }
  | "#" "!" "[" IDENT "]" {
      {
        attr_name: $4,
        attr_value: None,
        attr_guard: None,
        attr_span: loc_of($sloc),
      }
    }
  ;

// ===========================================================================
// Function signatures
// ===========================================================================

simple_pattern -> Ident?
  : ident { Some($1) }
  | "_" { None }
  ;

function_parameter -> Annotated[(Ident?, ValType), Location]
  : ident ":" value_type { annot($sloc, (Some($1), $3)) }
  | value_type { annot($sloc, (None, $1)) }
  ;

parameter_list -> Array[Annotated[(Ident?, ValType), Location]]
  : sep_trailing(",", function_parameter) { $1 }
  ;

// `ctx` is a PHANTOM parameter (Pottier, "Reachability and Error Diagnosis in
// LR(1) Parsers", CC 2016, section 4 "Selective Duplication"): it is unused in
// the body, but instantiating this rule at each of its homes makes the
// generator expand it into distinct automaton nonterminals with their own LR
// items. So the "after the parameter list" error state of a DECLARATION no
// longer merges with the type-position one, and reports only the continuations
// a signature admits (`->`, `{`, `;`) instead of their union with an
// expression's operator FOLLOW.
//
// Never inline it: an inlined rule vanishes from the automaton and the split
// goes with it. The two actuals are existing terminals chosen only as symbols
// evocative of each home; the parameter is never referenced.
function_type(ctx) -> FuncType
  : "(" parameter_list ")" ioption(result_arrow) {
      { params: $2, results: $4.unwrap_or([]) }
    }
  ;

%inline result_arrow -> Array[ValType]
  : "->" result_type { $2 }
  ;

%inline function_type_as -> FuncType
  : function_type(AS) { $1 }
  ;

function_type_definition -> FuncType
  : FN function_type(TYPE) { $2 }
  ;

function_name -> Ident
  : ident { $1 }
  ;

// TEMPORARY: placeholder while the remaining sections are translated.
parse -> Unit
  : EOF { () }
  ;

expression -> Instr[Location]
  : EOF { with_loc($sloc, Nop) }
  ;

condition -> Cond
  : EOF { Not(Version(0, 0, 0)) }
  ;
