// The Wax grammar, translated from wax/src/lib-wax/parser.mly (Menhir).
//
// This file is the single source of truth for BOTH the parser and the token
// definitions: tokens/ generates its Token / TokenKind enums from this same
// file with `moonyacc --mode only-tokens`, exactly as moonbitlang/parser
// generates lexer/tokens/tokens.mbt from yacc_parser/parser.mbty. Keeping one
// grammar file means a token can never be declared here and missing there.
//
// MoonYacc is ocamlyacc-compatible and, like Menhir, is built on Pager's LR(1)
// algorithm, so most of the translation is mechanical: $loc, $loc($n), $sloc,
// %prec, %inline, %left/%right/%nonassoc and `%token X "alias"` all carry over
// unchanged. Three things do not:
//
//   * %parameter<Context> -- Menhir functorises the grammar over the trivia
//     context so every semantic action can register its span. MoonBit has no
//     functors; the context becomes a package-level Ref set at parse entry.
//     (Consequence: parsing is not reentrant. Documented, and fine for a CLI.)
//
//   * %on_error_reduce -- no MoonYacc equivalent. It only shapes WHICH state an
//     error is reported from, so dropping it costs message quality, not
//     correctness, and message wording is explicitly not gated yet.
//
//   * Every rule must state its result type (`nonterm -> Type`), which Menhir
//     infers from the OCaml actions.
//
// MoonYacc also has no error recovery, so `--all-errors` / panic-mode recovery
// is out of scope. That matches the reference's DEFAULT behaviour, which stops
// at the first syntax error.

%position<Position>

// TokenKind is given Debug by MoonYacc itself; asking for it again is a
// duplicate-method error.
%derive<Debug> Token
%derive<Eq> TokenKind
%derive<Hash> TokenKind
%derive<Compare> TokenKind

// ---------------------------------------------------------------------------
// Terminals
// ---------------------------------------------------------------------------

// Numeric literals stay RAW STRINGS through the whole front end -- they are
// never converted to numbers here. That is what makes byte-exact round-tripping
// possible (0x1_0 must print back as written, not as 16), and it is also what
// the type checker's flexible-literal inference will need later.
%token<String> IDENT
%token<String> INT
%token<String> FLOAT

// A string literal carries its own span, not just its text: a data segment is
// written as a run of adjacent literals whose bytes are concatenated, and a
// diagnostic has to be able to point at the individual piece that is wrong.
%token<LocString> STRING
%token<Char> CHAR

%token EOF
%token INF NAN

%token SEMI ";"
%token SHARP "#"
%token QUESTIONMARK "?"
%token LPAREN "("
%token RPAREN ")"
%token LBRACE "{"
%token RBRACE "}"
%token LBRACKET "["
%token RBRACKET "]"
%token COMMA ","
%token COLON ":"
%token COLONCOLON "::"
%token ARROW "->"
%token FATARROW "=>"
%token EQUAL "="
%token COLONEQUAL ":="
%token AT "@"
%token QUOTE "'"
%token DOT "."
%token DOTDOT ".."
%token BANG "!"

%token PLUS "+"
%token PLUSPLUS "++"
%token PLUSEQUAL "+="
%token MINUS "-"
%token MINUSEQUAL "-="
%token STAR "*"
%token STAREQUAL "*="

// Wasm distinguishes signed and unsigned division, remainder, shift and
// comparison, so Wax spells the signedness on the operator itself (`/s`, `>>u`,
// `<=s`). Each has a compound-assignment form.
%token SLASH "/"
%token SLASHEQUAL "/="
%token SLASHS "/s"
%token SLASHSEQUAL "/s="
%token SLASHU "/u"
%token SLASHUEQUAL "/u="
%token PERCENTS "%s"
%token PERCENTSEQUAL "%s="
%token PERCENTU "%u"
%token PERCENTUEQUAL "%u="

%token AMPERSAND "&"
%token AMPERSANDEQUAL "&="
%token PIPE "|"
%token PIPEEQUAL "|="
%token CARET "^"
%token CARETEQUAL "^="
%token SHL "<<"
%token SHLEQUAL "<<="
%token SHRS ">>s"
%token SHRSEQUAL ">>s="
%token SHRU ">>u"
%token SHRUEQUAL ">>u="

%token EQUALEQUAL "=="
%token BANGEQUAL "!="
%token GT ">"
%token GTS ">s"
%token GTU ">u"
%token LT "<"
%token LTS "<s"
%token LTU "<u"
%token GE ">="
%token GES ">=s"
%token GEU ">=u"
%token LE "<="
%token LES "<=s"
%token LEU "<=u"

%token UNDERSCORE "_"

// Keywords.
%token FN
%token TAG
%token MUT
%token TYPE
%token REC
%token OPEN
%token NOP UNREACHABLE NULL
%token DO WHILE LOOP IF ELSE
%token CONST LET AS IS
%token BECOME
%token BR BR_IF BR_TABLE RETURN THROW THROW_REF
%token BR_ON_CAST BR_ON_CAST_FAIL
%token BR_ON_NULL BR_ON_NON_NULL
%token TRY TRY_LEGACY CATCH
%token CONT
%token SUSPEND ON
%token DISPATCH
%token MATCH
%token MEMORY DATA TABLE ELEM PAGESIZE SHARED
%token DESCRIPTOR DESCRIBES
%token IMPORT

// ---------------------------------------------------------------------------
// Precedence, lowest first
// ---------------------------------------------------------------------------
//
// Transcribed unchanged from parser.mly:119-133. The ordering is load-bearing
// and subtle -- see the reference's own notes at parser.mly:135 for the cases
// it is tuned against, e.g. `br 'foo 1 + 2` parsing as `br 'foo (1 + 2)`, and
// `{a| b:}` resolving as a struct.
//
// prec_ident, prec_block, prec_branch and prec_unary are precedence-only
// pseudo-symbols used by %prec; they are not real terminals and do not appear
// in the generated Token enum.

%nonassoc prec_ident prec_block
%right prec_branch
%right ":=" "="
%right "?" ":"
%nonassoc "==" "!=" "<" "<u" "<s" ">" ">u" ">s" "<=" "<=u" "<=s" ">=" ">=u" ">=s"
%left "|"
%left "^"
%left "&"
%left "<<" ">>u" ">>s"
%left "+" "-"
%left "*" "/" "/u" "/s" "%u" "%s"
%left AS IS ON
%nonassoc prec_unary
%nonassoc "!"
%left "." "(" "["


%start parse

%%

// ===========================================================================
// Generic list helpers
// ===========================================================================
//
// Wax allows a trailing separator in every comma-separated list, so the
// standard `separated_list` is not enough. The reference defines these as
// parameterised rules and so do we -- MoonYacc supports the same form.

non_empty_sep_trailing[T](sep : Unit, X : T) -> Array[T]
  : X { [$1] }
  | X sep { [$1] }
  | X sep non_empty_sep_trailing(sep, X) { [$1, ..$3] }
  ;

sep_trailing[T](sep : Unit, X : T) -> Array[T]
  : { [] }
  | non_empty_sep_trailing(sep, X) { $1 }
  ;

// ===========================================================================
// Identifiers
// ===========================================================================

%inline ident -> Ident
  : IDENT { { name: $1, loc: loc_of($loc($1)) } }
  ;

// A label may be spelled with a keyword -- `'loop`, `'if` -- because a label
// lives in its own namespace and the leading `'` already disambiguates. The
// lexer cannot know that, so the grammar spells out every keyword here.
ident_or_keyword -> String
  : IDENT { $1 }
  | FN { "fn" }
  | TAG { "tag" }
  | MUT { "mut" }
  | TYPE { "type" }
  | REC { "rec" }
  | OPEN { "open" }
  | NOP { "nop" }
  | UNREACHABLE { "unreachable" }
  | NULL { "null" }
  | DO { "do" }
  | WHILE { "while" }
  | LOOP { "loop" }
  | IF { "if" }
  | ELSE { "else" }
  | CONST { "const" }
  | LET { "let" }
  | AS { "as" }
  | IS { "is" }
  | BECOME { "become" }
  | BR { "br" }
  | BR_IF { "br_if" }
  | BR_TABLE { "br_table" }
  | RETURN { "return" }
  | THROW { "throw" }
  | THROW_REF { "throw_ref" }
  | BR_ON_CAST { "br_on_cast" }
  | BR_ON_CAST_FAIL { "br_on_cast_fail" }
  | BR_ON_NULL { "br_on_null" }
  | BR_ON_NON_NULL { "br_on_non_null" }
  | TRY { "try" }
  | TRY_LEGACY { "try_legacy" }
  | CATCH { "catch" }
  | CONT { "cont" }
  | SUSPEND { "suspend" }
  | ON { "on" }
  | MEMORY { "memory" }
  | IMPORT { "import" }
  | PAGESIZE { "pagesize" }
  | SHARED { "shared" }
  | DATA { "data" }
  | TABLE { "table" }
  | ELEM { "elem" }
  | DISPATCH { "dispatch" }
  | MATCH { "match" }
  | DESCRIPTOR { "descriptor" }
  | DESCRIBES { "describes" }
  | INF { "inf" }
  | NAN { "nan" }
  ;

label_name -> String
  : ident_or_keyword { $1 }
  ;

%inline label -> Ident
  : "'" label_name { { name: $2, loc: loc_of($sloc) } }
  ;

// ===========================================================================
// Types
// ===========================================================================

heap_type -> HeapType
  : CONT { Cont }
  | ident { heap_type_of($1) }
  ;

reference_type -> RefType
  : "&" opt_question opt_bang heap_type {
      let typ = if $3 { make_exact($sloc, $4) } else { $4 }
      { nullable: $2, typ }
    }
  ;

%inline opt_question -> Bool
  : { false }
  | "?" { true }
  ;

%inline opt_bang -> Bool
  : { false }
  | "!" { true }
  ;

value_type -> ValType
  : IDENT { value_type_of($loc($1), $1) }
  | reference_type { Ref($1) }
  ;

cast_type -> CastType
  : IDENT { cast_type_of($loc($1), $1) }
  | reference_type { Value(Ref($1)) }
  | "&" opt_question FN function_type_as { Func(nullable=$2, sign=$4) }
  ;

result_type_ -> Array[ValType]
  : non_empty_sep_trailing(",", value_type) { $1 }
  ;

result_type -> Array[ValType]
  : "(" ")" { [] }
  | value_type { [$1] }
  | "(" result_type_ ")" { $2 }
  ;

storage_type -> StorageType
  : IDENT { storage_type_of($loc($1), $1) }
  | reference_type { Value(Ref($1)) }
  ;

field_type -> FieldType
  : opt_mut storage_type { { mut_: $1, typ: $2 } }
  ;

%inline opt_mut -> Bool
  : { false }
  | MUT { true }
  ;

field_name -> Ident
  : ident { $1 }
  ;

structure_type_field -> Annotated[(Ident, FieldType), Location]
  : field_name ":" field_type { annot($sloc, ($1, $3)) }
  ;

structure_type -> Array[Annotated[(Ident, FieldType), Location]]
  : sep_trailing(",", structure_type_field) { $1 }
  ;

// A leading `..` inherits the supertype's fields. It must come first and appear
// at most once, which these three productions enforce structurally rather than
// by a check in the action.
structtype -> Array[Annotated[(Ident, FieldType), Location]]
  : "{" ".." "}" { [@ast.splice_field(loc_of($sloc))] }
  | "{" ".." "," structure_type "}" {
      [@ast.splice_field(loc_of($sloc)), ..$4]
    }
  | "{" structure_type "}" { $2 }
  ;

// TEMPORARY: placeholder so the grammar is well-formed while the remaining
// sections are translated. Replaced by the real `parse` rule.
parse -> Unit
  : EOF { () }
  ;

function_type_as -> FuncType
  : EOF { { params: [], results: [] } }
  ;
