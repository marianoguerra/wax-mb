// The Wax grammar, translated from wax/src/lib-wax/parser.mly (Menhir).
//
// This file is the single source of truth for BOTH the parser and the token
// definitions: tokens/ generates its Token / TokenKind enums from this same
// file with `moonyacc --mode only-tokens`, exactly as moonbitlang/parser
// generates lexer/tokens/tokens.mbt from yacc_parser/parser.mbty. Keeping one
// grammar file means a token can never be declared here and missing there.
//
// MoonYacc is ocamlyacc-compatible and, like Menhir, is built on Pager's LR(1)
// algorithm, so most of the translation is mechanical: $loc, $loc($n), $sloc,
// %prec, %inline, %left/%right/%nonassoc and `%token X "alias"` all carry over
// unchanged. Three things do not:
//
//   * %parameter<Context> -- Menhir functorises the grammar over the trivia
//     context so every semantic action can register its span. MoonBit has no
//     functors; the context becomes a package-level Ref set at parse entry.
//     (Consequence: parsing is not reentrant. Documented, and fine for a CLI.)
//
//   * %on_error_reduce -- no MoonYacc equivalent. It only shapes WHICH state an
//     error is reported from, so dropping it costs message quality, not
//     correctness, and message wording is explicitly not gated yet.
//
//   * Every rule must state its result type (`nonterm -> Type`), which Menhir
//     infers from the OCaml actions.
//
//   * %inline is NOT used, though the reference uses it widely. MoonYacc's
//     inliner mis-maps semantic-value indices when an inlined rule can expand
//     to nothing: the generated action reads the wrong argument slot, or one
//     past the end, and fails at run time with a guard mismatch or an
//     index-out-of-bounds -- not at generation time. Inlining never changes the
//     language a grammar accepts, only how many distinct LR states it has, so
//     dropping it costs error-message granularity (which is not gated here) and
//     nothing else. See test/UPSTREAM-FINDINGS.md.
//
// MoonYacc also has no error recovery, so `--all-errors` / panic-mode recovery
// is out of scope. That matches the reference's DEFAULT behaviour, which stops
// at the first syntax error.
//
// CONFLICTS ARE REPORTED, but only on a fresh generation. MoonYacc prints
// "Shift-reduce conflict resolved without precedence" (and the other cases in
// its lr1/resolve_conflicts.mbt) while generating -- so a cached parser.mbt
// hides them, and `moon check` after an unrelated edit says nothing. Delete
// grammar/parser.mbt before trusting a clean run.
//
// It does NOT report the number of conflicts or where they are, and an
// unresolvable %nonassoc conflict is a panic rather than a diagnostic: see the
// note on the comparison precedence level below, and
// test/UPSTREAM-FINDINGS.md.

%position<Position>

// TokenKind is given Debug by MoonYacc itself; asking for it again is a
// duplicate-method error.
%derive<Debug> Token
%derive<Eq> TokenKind
%derive<Hash> TokenKind
%derive<Compare> TokenKind

// ---------------------------------------------------------------------------
// Terminals
// ---------------------------------------------------------------------------

// Numeric literals stay RAW STRINGS through the whole front end -- they are
// never converted to numbers here. That is what makes byte-exact round-tripping
// possible (0x1_0 must print back as written, not as 16), and it is also what
// the type checker's flexible-literal inference will need later.
%token<String> IDENT
%token<String> INT
%token<String> FLOAT

// A string literal carries its own span, not just its text: a data segment is
// written as a run of adjacent literals whose bytes are concatenated, and a
// diagnostic has to be able to point at the individual piece that is wrong.
%token<LocString> STRING
%token<Char> CHAR

%token EOF
%token INF NAN

%token SEMI ";"
%token SHARP "#"
%token QUESTIONMARK "?"
%token LPAREN "("
%token RPAREN ")"
%token LBRACE "{"
%token RBRACE "}"
%token LBRACKET "["
%token RBRACKET "]"
%token COMMA ","
%token COLON ":"
%token COLONCOLON "::"
%token ARROW "->"
%token FATARROW "=>"
%token EQUAL "="
%token COLONEQUAL ":="
%token AT "@"
%token QUOTE "'"
%token DOT "."
%token DOTDOT ".."
%token BANG "!"

%token PLUS "+"
%token PLUSPLUS "++"
%token PLUSEQUAL "+="
%token MINUS "-"
%token MINUSEQUAL "-="
%token STAR "*"
%token STAREQUAL "*="

// Wasm distinguishes signed and unsigned division, remainder, shift and
// comparison, so Wax spells the signedness on the operator itself (`/s`, `>>u`,
// `<=s`). Each has a compound-assignment form.
%token SLASH "/"
%token SLASHEQUAL "/="
%token SLASHS "/s"
%token SLASHSEQUAL "/s="
%token SLASHU "/u"
%token SLASHUEQUAL "/u="
%token PERCENTS "%s"
%token PERCENTSEQUAL "%s="
%token PERCENTU "%u"
%token PERCENTUEQUAL "%u="

%token AMPERSAND "&"
%token AMPERSANDEQUAL "&="
%token PIPE "|"
%token PIPEEQUAL "|="
%token CARET "^"
%token CARETEQUAL "^="
%token SHL "<<"
%token SHLEQUAL "<<="
%token SHRS ">>s"
%token SHRSEQUAL ">>s="
%token SHRU ">>u"
%token SHRUEQUAL ">>u="

%token EQUALEQUAL "=="
%token BANGEQUAL "!="
%token GT ">"
%token GTS ">s"
%token GTU ">u"
%token LT "<"
%token LTS "<s"
%token LTU "<u"
%token GE ">="
%token GES ">=s"
%token GEU ">=u"
%token LE "<="
%token LES "<=s"
%token LEU "<=u"

%token UNDERSCORE "_"

// Keywords.
%token FN
%token TAG
%token MUT
%token TYPE
%token REC
%token OPEN
%token NOP UNREACHABLE NULL
%token DO WHILE LOOP IF ELSE
%token CONST LET AS IS
%token BECOME
%token BR BR_IF BR_TABLE RETURN THROW THROW_REF
%token BR_ON_CAST BR_ON_CAST_FAIL
%token BR_ON_NULL BR_ON_NON_NULL
%token TRY TRY_LEGACY CATCH
%token CONT
%token SUSPEND ON
%token DISPATCH
%token MATCH
%token MEMORY DATA TABLE ELEM PAGESIZE SHARED
%token DESCRIPTOR DESCRIBES
%token IMPORT

// ---------------------------------------------------------------------------
// Precedence, lowest first
// ---------------------------------------------------------------------------
//
// Transcribed unchanged from parser.mly:119-133. The ordering is load-bearing
// and subtle -- see the reference's own notes at parser.mly:135 for the cases
// it is tuned against, e.g. `br 'foo 1 + 2` parsing as `br 'foo (1 + 2)`, and
// `{a| b:}` resolving as a struct.
//
// prec_ident, prec_block, prec_branch and prec_unary are precedence-only
// pseudo-symbols used by %prec; they are not real terminals and do not appear
// in the generated Token enum.

%nonassoc prec_ident prec_block
%right prec_branch
%right ":=" "="
%right "?" ":"
// UPSTREAM BUG WORKAROUND. The reference declares this level %nonassoc, so
// `1 < 2 < 3` is a syntax error while `1 < (2 < 3)` is fine. MoonYacc PANICS
// when a %nonassoc conflict actually arises -- "RuntimeError: unreachable",
// no diagnostic -- which is reproducible in a 20-line grammar; see
// test/UPSTREAM-FINDINGS.md. So the level is declared %left here and the
// non-associativity is enforced in the action instead, by
// `reject_chained_comparison`, which reproduces the reference's rejection at
// the same span.
%left "==" "!=" "<" "<u" "<s" ">" ">u" ">s" "<=" "<=u" "<=s" ">=" ">=u" ">=s"
%left "|"
%left "^"
%left "&"
%left "<<" ">>u" ">>s"
%left "+" "-"
%left "*" "/" "/u" "/s" "%u" "%s"
%left AS IS ON
%nonassoc prec_unary
%nonassoc "!"
%left "." "(" "["


%start parse

%%

// ===========================================================================
// Generic list helpers
// ===========================================================================
//
// Wax allows a trailing separator in every comma-separated list, so the
// standard `separated_list` is not enough. The reference defines these as
// parameterised rules and so do we -- MoonYacc supports the same form.

non_empty_sep_trailing[T](SEP, X : T) -> Array[T]
  : X { [$1] }
  | X SEP { [$1] }
  | X SEP non_empty_sep_trailing(SEP, X) { [$1, ..$3] }
  ;

sep_trailing[T](SEP, X : T) -> Array[T]
  : { [] }
  | non_empty_sep_trailing(SEP, X) { $1 }
  ;

// ===========================================================================
// Identifiers
// ===========================================================================

ident -> Ident
  : IDENT { { name: $1, loc: loc_of($loc($1)) } }
  ;

// A label may be spelled with a keyword -- `'loop`, `'if` -- because a label
// lives in its own namespace and the leading `'` already disambiguates. The
// lexer cannot know that, so the grammar spells out every keyword here.
ident_or_keyword -> String
  : IDENT { $1 }
  | FN { "fn" }
  | TAG { "tag" }
  | MUT { "mut" }
  | TYPE { "type" }
  | REC { "rec" }
  | OPEN { "open" }
  | NOP { "nop" }
  | UNREACHABLE { "unreachable" }
  | NULL { "null" }
  | DO { "do" }
  | WHILE { "while" }
  | LOOP { "loop" }
  | IF { "if" }
  | ELSE { "else" }
  | CONST { "const" }
  | LET { "let" }
  | AS { "as" }
  | IS { "is" }
  | BECOME { "become" }
  | BR { "br" }
  | BR_IF { "br_if" }
  | BR_TABLE { "br_table" }
  | RETURN { "return" }
  | THROW { "throw" }
  | THROW_REF { "throw_ref" }
  | BR_ON_CAST { "br_on_cast" }
  | BR_ON_CAST_FAIL { "br_on_cast_fail" }
  | BR_ON_NULL { "br_on_null" }
  | BR_ON_NON_NULL { "br_on_non_null" }
  | TRY { "try" }
  | TRY_LEGACY { "try_legacy" }
  | CATCH { "catch" }
  | CONT { "cont" }
  | SUSPEND { "suspend" }
  | ON { "on" }
  | MEMORY { "memory" }
  | IMPORT { "import" }
  | PAGESIZE { "pagesize" }
  | SHARED { "shared" }
  | DATA { "data" }
  | TABLE { "table" }
  | ELEM { "elem" }
  | DISPATCH { "dispatch" }
  | MATCH { "match" }
  | DESCRIPTOR { "descriptor" }
  | DESCRIBES { "describes" }
  | INF { "inf" }
  | NAN { "nan" }
  ;

label_name -> String
  : ident_or_keyword { $1 }
  ;

label -> Ident
  : "'" label_name { { name: $2, loc: loc_of($sloc) } }
  ;

// ===========================================================================
// Types
// ===========================================================================

heap_type -> HeapType
  : CONT { Cont }
  | ident { heap_type_of($1) }
  ;

reference_type -> RefType
  : "&" boption("?") boption("!") heap_type {
      let typ = if $3 { make_exact($sloc, $4) } else { $4 }
      { nullable: $2, typ }
    }
  ;

value_type -> ValType
  : IDENT { value_type_of($loc($1), $1) }
  | reference_type { Ref($1) }
  ;

cast_type -> CastType
  : IDENT { cast_type_of($loc($1), $1) }
  | reference_type { Value(Ref($1)) }
  | "&" boption("?") FN function_type_as { Func(nullable=$2, sign=$4) }
  ;

result_type_ -> Array[ValType]
  : non_empty_sep_trailing(",", value_type) { $1 }
  ;

result_type -> Array[ValType]
  : "(" ")" { [] }
  | value_type { [$1] }
  | "(" result_type_ ")" { $2 }
  ;

storage_type -> StorageType
  : IDENT { storage_type_of($loc($1), $1) }
  | reference_type { Value(Ref($1)) }
  ;

field_type -> FieldType
  : boption(MUT) storage_type { { mut_: $1, typ: $2 } }
  ;

field_name -> Ident
  : ident { $1 }
  ;

structure_type_field -> Annotated[(Ident, FieldType), Location]
  : field_name ":" field_type { annot($sloc, ($1, $3)) }
  ;

structure_type -> Array[Annotated[(Ident, FieldType), Location]]
  : sep_trailing(",", structure_type_field) { $1 }
  ;

// A leading `..` inherits the supertype's fields. It must come first and appear
// at most once, which these three productions enforce structurally rather than
// by a check in the action.
structtype -> Array[Annotated[(Ident, FieldType), Location]]
  : "{" ".." "}" { [@ast.splice_field(loc_of($sloc))] }
  | "{" ".." "," structure_type "}" {
      [@ast.splice_field(loc_of($sloc)), ..$4]
    }
  | "{" structure_type "}" { $2 }
  ;

arraytype -> FieldType
  : "[" field_type "]" { $2 }
  ;

composite_type -> CompType
  : structtype { Struct($1) }
  | function_type_definition { Func($1) }
  | arraytype { Array($1) }
  // A continuation type wraps a NAMED function type: `cont ft`.
  | CONT type_name { Cont($2) }
  ;

type_name -> Ident
  : ident { $1 }
  ;

type_definition -> Annotated[(Ident, SubType), Location]
  : TYPE type_name option(supertype_clause) "=" boption(OPEN)
    ioption(describes_clause) ioption(descriptor_clause) composite_type ";" {
      annot($sloc, ($2, {
        typ: $8,
        supertype: $3,
        // `open` is the spelling; the AST stores the negation, because
        // final-by-default is what WebAssembly encodes.
        final_: !($5),
        descriptor: $7,
        describes: $6,
      }))
    }
  ;

supertype_clause -> Ident
  : ":" type_name { $2 }
  ;

describes_clause -> Ident
  : DESCRIBES type_name { $2 }
  ;

descriptor_clause -> Ident
  : DESCRIPTOR type_name { $2 }
  ;

rectype -> Annotated[Array[Annotated[(Ident, SubType), Location]], Location]
  : REC "{" list_of(type_definition) "}" { annot($loc($1), $3) }
  // Reuse the type definition's OWN already-registered span rather than
  // registering a duplicate for the same range, which would split trivia
  // between the two.
  | type_definition { { desc: [$1], info: $1.info } }
  ;

// An array-returning list. The stdlib's `list` yields @list.List while the AST
// holds arrays, so it is defined here.
//
// RIGHT-recursive, matching the reference's `list`. Left recursion would be
// cheaper -- no repeated array copying -- but it changes the automaton: the
// parser would have to reduce the empty list BEFORE shifting the first token,
// and at the start of a module field that means committing to
// `list_of(attribute) definition` while the lookahead is still `#`, which also
// begins `#[if(...)]`. That is a shift-reduce conflict, and resolving it by
// shift made every attributed definition in the corpus fail with
// "Expecting 'if', 'else'". Right recursion defers the decision until after
// the attribute is parsed.
list_of[T](X : T) -> Array[T]
  : { [] }
  | X list_of(X) { [$1, ..$2] }
  ;

// ===========================================================================
// Attributes
// ===========================================================================

attribute_expression -> Instr[Location]
  : expression { $1 }
  ;

// `import` heads a grouped-import block, so it is a keyword rather than an
// IDENT; accept it explicitly so `#[import = ...]` keeps working.
attribute_name -> String
  : IDENT { $1 }
  | IMPORT { "import" }
  ;

// An optional conditional-compilation guard on a SINGLE attribute,
// `#[export = "n", if(not(portable))]`. It reuses the `#[if(...)]` condition
// grammar, parentheses included; only `export` accepts one, which the typer
// checks.
attribute_guard -> Annotated[Cond, Location]?
  : { None }
  | "," IF "(" condition ")" { Some({ desc: $4, info: loc_of($loc($2)) }) }
  ;

attribute -> Attribute
  : "#" "[" attribute_name "=" attribute_expression attribute_guard "]" {
      {
        attr_name: $3,
        attr_value: Some($5),
        attr_guard: $6,
        attr_span: loc_of($sloc),
      }
    }
  | "#" "[" attribute_name attribute_guard "]" {
      {
        attr_name: $3,
        attr_value: None,
        attr_guard: $4,
        attr_span: loc_of($sloc),
      }
    }
  ;

// One hint attribute, carrying its own span so a diagnostic about a misplaced
// hint points at the attribute rather than at the instruction it decorates.
hint_attr -> ((Position, Position), HintSetter)
  : attribute { ($loc($1), hint_of_attr($loc($1), $1)) }
  | "#" "[" IDENT "(" sep_trailing(",", hint_target) ")" "]" {
      ($sloc, targets_of_attr($sloc, $3, $5))
    }
  ;

// One likely callee of an indirect call, with how often it is taken as a
// fraction of 1.
hint_target -> (Ident, Int)
  : ident ":" target_fraction { ($1, $3) }
  ;

target_fraction -> Int
  : FLOAT { target_percent($loc($1), $1) }
  | INT { target_percent($loc($1), $1) }
  ;

// A module-level inner attribute, `#![module = "name"]`.
inner_attribute -> Attribute
  : "#" "!" "[" IDENT "=" attribute_expression "]" {
      {
        attr_name: $4,
        attr_value: Some($6),
        attr_guard: None,
        attr_span: loc_of($sloc),
      }
    }
  | "#" "!" "[" IDENT "]" {
      {
        attr_name: $4,
        attr_value: None,
        attr_guard: None,
        attr_span: loc_of($sloc),
      }
    }
  ;

// ===========================================================================
// Function signatures
// ===========================================================================

simple_pattern -> Ident?
  : ident { Some($1) }
  | "_" { None }
  ;

function_parameter -> Annotated[(Ident?, ValType), Location]
  : ident ":" value_type { annot($sloc, (Some($1), $3)) }
  | value_type { annot($sloc, (None, $1)) }
  ;

parameter_list -> Array[Annotated[(Ident?, ValType), Location]]
  : sep_trailing(",", function_parameter) { $1 }
  ;

// `ctx` is a PHANTOM parameter (Pottier, "Reachability and Error Diagnosis in
// LR(1) Parsers", CC 2016, section 4 "Selective Duplication"): it is unused in
// the body, but instantiating this rule at each of its homes makes the
// generator expand it into distinct automaton nonterminals with their own LR
// items. So the "after the parameter list" error state of a DECLARATION no
// longer merges with the type-position one, and reports only the continuations
// a signature admits (`->`, `{`, `;`) instead of their union with an
// expression's operator FOLLOW.
//
// Never inline it: an inlined rule vanishes from the automaton and the split
// goes with it. The two actuals are existing terminals chosen only as symbols
// evocative of each home; the parameter is never referenced.
function_type(ctx) -> FuncType
  : "(" parameter_list ")" ioption(result_arrow) {
      { params: $2, results: $4.unwrap_or([]) }
    }
  ;

result_arrow -> Array[ValType]
  : "->" result_type { $2 }
  ;

function_type_as -> FuncType
  : function_type(AS) { $1 }
  ;

function_type_definition -> FuncType
  : FN function_type(TYPE) { $2 }
  ;

function_name -> Ident
  : ident { $1 }
  ;

// ===========================================================================
// Declarations
// ===========================================================================

optional_function_type -> FuncType?
  : option(function_type(FN)) { $1 }
  ;

// The exactness marker `!` may be written in either of two places -- `fn f!` or
// `fn f: !t` -- but not both.
fundecl -> (Ident, Ident?, FuncType?, Bool)
  : FN function_name boption("!") ioption(fundecl_type) optional_function_type {
      let (ex2, t) = match $4 {
        Some((e, ty)) => (e, Some(ty))
        None => (false, None)
      }
      if $3 && ex2 {
        record_error(loc_of($sloc), "Duplicate exact marker '!'.")
      }
      ($2, t, decl_sign($sloc, t, $5), $3 || ex2)
    }
  ;

fundecl_type -> (Bool, Ident)
  : ":" boption("!") type_name { ($2, $3) }
  ;

func -> (Attributes) -> Annotated[ModuleField[Location], Location]
  : fundecl block {
      let (name, typ, sign, exact) = $1
      let body = $2
      if exact {
        record_error(
          loc_of($sloc),
          "A function definition is always exact; the '!' marker is only allowed on an (imported) function declaration.",
        )
      }
      fn(attributes) {
        annot($sloc, ModuleField::Func(name~, typ~, sign~, body~, attributes~))
      }
    }
  ;

tag_name -> Ident
  : ident { $1 }
  ;

tag_signature -> (Ident, Ident?, FuncType?)
  : TAG tag_name ioption(tag_type) optional_function_type {
      ($2, $3, decl_sign($sloc, $3, $4))
    }
  ;

tag_type -> Ident
  : ":" type_name { $2 }
  ;

// ===========================================================================
// Blocks
// ===========================================================================

// NOT %inline, unlike the reference. MoonYacc miscomputes semantic-value
// indices when a production contains two %inline symbols that can each expand
// to nothing: the `if` production reads _args[4] for its trailing
// ioption(else_branch), which is out of bounds once an absent inline label has
// also shrunk the argument list. Keeping this a real nonterminal makes it
// always occupy one slot. The reference marks it %inline only to split error
// states, which is message quality, not semantics.
block_label -> Ident?
  : ioption(labelled) { $1 }
  ;

labelled -> Ident
  : label ":" { $1 }
  ;

// An anonymous block parameter, located at its value type so a trailing
// comment attaches to it rather than to the enclosing list.
block_param_type -> Annotated[(Ident?, ValType), Location]
  : value_type { annot($sloc, (None, $1)) }
  ;

parameter_types -> Array[Annotated[(Ident?, ValType), Location]]
  : sep_trailing(",", block_param_type) { $1 }
  ;

block_type -> FuncType
  : "(" parameter_types ")" ioption(result_arrow) {
      { params: $2, results: $4.unwrap_or([]) }
    }
  | value_type { { params: [], results: [$1] } }
  ;

block -> (Ident?, Array[Instr[Location]])
  : block_label "{" statement_list "}" { ($1, $3) }
  ;

braced_block -> Body[Location]
  : "{" statement_list "}" { annot($sloc, $2) }
  ;

// ===========================================================================
// Handler clauses
// ===========================================================================

catch -> Catch
  : ident "->" label { Catch($1, $3) }
  | ident "&" "->" label { CatchRef($1, $4) }
  | "_" "->" label { CatchAll($3) }
  | "_" "&" "->" label { CatchAllRef($4) }
  ;

on_clause -> OnClause
  : ident "->" label { OnLabel($1, $3) }
  // `switch` is a contextual identifier here, not a keyword.
  | ident "->" ident {
      if $3.name == "switch" {
        OnSwitch($1)
      } else {
        fail_at(
          loc_of($loc($3)),
          "Expected a label or 'switch' as the handler target.",
          default=OnSwitch($1),
        )
      }
    }
  ;

on_clauses -> Array[OnClause]
  : "[" sep_trailing(",", on_clause) "]" { $2 }
  ;

legacy_catch -> (Ident, Body[Location])
  : ident "=>" braced_block { ($1, $3) }
  ;

// A structured `try`'s catch arm. The `&` form (catch_ref) delivers the `&exn`
// above the payload. The catch-all is grammar-enforced last, matching
// try_table's first-match-wins clause order.
catch_arm -> TryCatchArm[Location]
  : ident "=>" braced_block {
      { arm_tag: Some($1), arm_ref: false, arm_types: [], arm_body: $3 }
    }
  | ident "&" "=>" braced_block {
      { arm_tag: Some($1), arm_ref: true, arm_types: [], arm_body: $4 }
    }
  ;

catch_all_arm -> TryCatchArm[Location]
  : "_" "=>" braced_block {
      { arm_tag: None, arm_ref: false, arm_types: [], arm_body: $3 }
    }
  | "_" "&" "=>" braced_block {
      { arm_tag: None, arm_ref: true, arm_types: [], arm_body: $4 }
    }
  ;

legacy_catch_all -> Body[Location]
  : "_" "=>" braced_block { $3 }
  ;

// ===========================================================================
// Aggregates and arms
// ===========================================================================

structure_field -> (Ident, Instr[Location]?)
  : field_name ":" expression { ($1, Some($3)) }
  // Punning: `{x}` abbreviates `{x: x}`, taking the value from the like-named
  // local or global. Carried as None so the printer can put it back as written.
  | field_name { ($1, None) }
  ;

structure -> Array[(Ident, Instr[Location]?)]
  : sep_trailing(",", structure_field) { $1 }
  ;

// A `dispatch` case: a labelled, brace-delimited statement list. The label
// names the case; the body runs when the index selects it, and falls through
// into the following cases.
dispatch_arm -> (Ident, Body[Location])
  : label ":" braced_block { ($1, $3) }
  ;

// A `match` arm: a reference-type test, optionally binding the narrowed value,
// or a `null` test.
match_pattern -> MatchPattern
  : ident ":" reference_type { MatchCast(Some($1), $3) }
  | reference_type { MatchCast(None, $1) }
  | NULL { MatchNull }
  ;

match_arm -> (MatchPattern, Body[Location])
  : match_pattern "=>" braced_block { ($1, $3) }
  ;

// The default arm is required, like a dispatch's `else`: no-match always has a
// written destination.
match_default -> Body[Location]
  : "_" "=>" braced_block { $3 }
  ;

// A list that also swallows bare `;` empty elements -- the list analogue of
// statement_list's empty statement. Used where an entry carries no separator of
// its own: module fields, import items, and the arm lists of
// dispatch/match/try. Each entry begins with a distinctive token, never `;`, so
// the empty case cannot clash.
semi_list[T](X : T) -> Array[T]
  : { [] }
  | ";" semi_list(X) { $2 }
  | X semi_list(X) { [$1, ..$2] }
  ;

// The comma-separated case labels of a br_table/dispatch bracket, ending in the
// mandatory `else <default>`.
case_labels -> (Array[Ident], Ident)
  : ELSE label { ([], $2) }
  | label "," case_labels { let (ls, d) = $3; ([$1, ..ls], d) }
  ;

// ===========================================================================
// Structured control flow
// ===========================================================================

blockinstr -> Instr[Location]
  : DISPATCH expression "[" case_labels "]" "{" semi_list(dispatch_arm) "}" {
      let (cases, default) = $4
      with_loc($sloc, Dispatch(index=$2, cases~, default~, arms=$7))
    }
  | MATCH expression "{" semi_list(match_arm) match_default "}" {
      with_loc($sloc, Match(scrutinee=$2, arms=$4, default=$5))
    }
  | block_label DO option(block_type) braced_block {
      with_loc($sloc, Block(label=$1, typ=blocktype($3), block=$4))
    }
  | block_label WHILE condition_expression braced_block {
      with_loc($sloc, While(label=$1, cond=$3, step=None, block=$4))
    }
  // Zig-style continue-expression: `while c : (step) { ... }`. The step runs at
  // the end of every iteration, INCLUDING one reached by `continue`.
  // Parentheses are required: a bare statement would collide with the body
  // brace for branch statements.
  | block_label WHILE condition_expression ":" "(" hinted_statement ")"
    braced_block {
      with_loc($sloc, While(label=$1, cond=$3, step=Some($6), block=$8))
    }
  | block_label LOOP option(block_type) braced_block {
      with_loc($sloc, Loop(label=$1, typ=blocktype($3), block=$4))
    }
  | block_label IF condition_expression option(if_block_type) braced_block
    ioption(else_branch) {
      with_loc(
        $sloc,
        If(
          label=$1,
          typ=blocktype($4),
          cond=$3,
          if_block=$5,
          else_block=$6,
        ),
      )
    }
  | block_label TRY option(block_type) braced_block CATCH "["
    sep_trailing(",", catch) "]" {
      with_loc(
        $sloc,
        TryTable(label=$1, typ=blocktype($3), catches=$7, block=$4),
      )
    }
  | block_label TRY option(block_type) braced_block CATCH "{"
    semi_list(catch_arm) option(catch_all_arm) "}" {
      let arms = $7
      match $8 {
        Some(a) => arms.push(a)
        None => ()
      }
      with_loc(
        $sloc,
        TryCatch(label=$1, typ=blocktype($3), block=$4, arms~),
      )
    }
  | block_label TRY_LEGACY option(block_type) braced_block CATCH "{"
    semi_list(legacy_catch) option(legacy_catch_all) "}" {
      with_loc(
        $sloc,
        Try(
          label=$1,
          typ=blocktype($3),
          block=$4,
          catches=$7,
          catch_all=$8,
        ),
      )
    }
  ;

if_block_type -> FuncType
  : "=>" block_type { $2 }
  ;

else_branch -> Body[Location]
  : ELSE braced_block { $2 }
  ;

// ===========================================================================
// Expression positions
// ===========================================================================
//
// These are all just `expression`, named separately so an error inside one
// reports what the position is for -- "Expecting an index expression" rather
// than a bare "Expecting an expression".

parenthesized_expression -> Instr[Location]
  : expression { $1 }
  ;

// The `descriptor(d)` clause shared by the custom-descriptors instructions.
// The target type is recovered from d's descriptor type, so only the operand
// is written.
descriptor_operand -> Instr[Location]
  : DESCRIPTOR "(" expression ")" { $3 }
  ;

index_expression -> Instr[Location]
  : expression { $1 }
  ;

then_branch -> Instr[Location]
  : expression { $1 }
  ;

condition_expression -> Instr[Location]
  : expression { $1 }
  ;

length_expression -> Instr[Location]
  : expression { $1 }
  ;

expression_list -> Array[Instr[Location]]
  : sep_trailing(",", expression) { $1 }
  ;

// A call argument: an expression, or a labelled immediate `name: expr` -- the
// offset/align/lane immediates of a memory access. Typing rejects labels
// anywhere else.
argument -> Instr[Location]
  : expression { $1 }
  | ident ":" expression { with_loc($sloc, Labelled($1, $3)) }
  // `tag` is a keyword (tag declarations), so the `tag:` immediate of a
  // `switch` needs its own production.
  | TAG ":" expression {
      with_loc(
        $sloc,
        Labelled({ name: "tag", loc: loc_of($loc($1)) }, $3),
      )
    }
  ;

argument_list -> Array[Instr[Location]]
  : sep_trailing(",", argument) { $1 }
  ;

// ===========================================================================
// Plain instructions
// ===========================================================================

plaininstr -> Instr[Location]
  : NULL { with_loc($sloc, Null) }
  | "_" { with_loc($sloc, Hole) }
  | ident %prec prec_ident { with_loc($sloc, Get($1)) }
  | ident "::" ident { with_loc($sloc, Path($1, $3)) }
  | "(" parenthesized_expression ")" { mark_parenthesized($2) }
  | "(" expression "," expression_list ")" {
      with_loc($sloc, Sequence([$2, ..$4]))
    }
  | expression "(" argument_list ")" { with_loc($sloc, Call($1, $3)) }
  | CHAR { with_loc($sloc, Char($1)) }
  | STRING { with_loc($sloc, Str(None, $1.desc)) }
  | ident "#" STRING { with_loc($sloc, Str(Some($1), $3.desc)) }
  | INT { with_loc($sloc, Int($1)) }
  | FLOAT { with_loc($sloc, Float($1)) }
  | INF { with_loc($sloc, Float("inf")) }
  | NAN { with_loc($sloc, Float("nan")) }
  | "{" ident "|" structure "}" { with_loc($sloc, Struct(Some($2), $4)) }
  | "{" structure_field "," structure "}" {
      with_loc($sloc, Struct(None, [$2, ..$4]))
    }
  | "{" structure_field "}" { with_loc($sloc, Struct(None, [$2])) }
  | "{" "}" { with_loc($sloc, Struct(None, [])) }
  | "{" ident "|" ".." "}" { with_loc($sloc, StructDefault(Some($2))) }
  | "{" ".." "}" { with_loc($sloc, StructDefault(None)) }
  | "{" descriptor_operand "|" structure "}" {
      with_loc($sloc, StructDesc($2, $4))
    }
  | "{" descriptor_operand "|" ".." "}" {
      with_loc($sloc, StructDefaultDesc($2))
    }
  | "[" array_body "]" { with_loc($sloc, $2(None)) }
  | "[" ident "|" array_body "]" { with_loc($sloc, $4(Some($2))) }
  | ident ":=" expression { with_loc($sloc, Tee($1, $3)) }
  | expression AS cast_type { with_loc($sloc, Cast($1, $3)) }
  | expression AS boption("?") descriptor_operand {
      with_loc($sloc, CastDesc($1, $3, $4))
    }
  | expression IS reference_type { with_loc($sloc, Test($1, $3)) }
  | expression "." ident { with_loc($sloc, StructGet($1, $3)) }
  | expression "." DESCRIPTOR { with_loc($sloc, GetDescriptor($1)) }
  | expression "." ident "=" expression {
      with_loc($sloc, StructSet($1, $3, $5))
    }
  | expression "+" expression { binop($sloc, $loc($2), Add, $1, $3) }
  | expression "-" expression { binop($sloc, $loc($2), Sub, $1, $3) }
  | expression "*" expression { binop($sloc, $loc($2), Mul, $1, $3) }
  | expression "/" expression { binop($sloc, $loc($2), Div(None), $1, $3) }
  | expression "/s" expression { binop($sloc, $loc($2), Div(Some(Signed)), $1, $3) }
  | expression "/u" expression { binop($sloc, $loc($2), Div(Some(Unsigned)), $1, $3) }
  | expression "%s" expression { binop($sloc, $loc($2), Rem(Signed), $1, $3) }
  | expression "%u" expression { binop($sloc, $loc($2), Rem(Unsigned), $1, $3) }
  | expression "&" expression { binop($sloc, $loc($2), And, $1, $3) }
  | expression "^" expression { binop($sloc, $loc($2), Xor, $1, $3) }
  | expression "|" expression { binop($sloc, $loc($2), Or, $1, $3) }
  | expression "<<" expression { binop($sloc, $loc($2), Shl, $1, $3) }
  | expression ">>s" expression { binop($sloc, $loc($2), Shr(Signed), $1, $3) }
  | expression ">>u" expression { binop($sloc, $loc($2), Shr(Unsigned), $1, $3) }
  | expression "==" expression { binop($sloc, $loc($2), Eq, $1, $3) }
  | expression "!=" expression { binop($sloc, $loc($2), Ne, $1, $3) }
  | expression ">" expression { binop($sloc, $loc($2), Gt(None), $1, $3) }
  | expression ">s" expression { binop($sloc, $loc($2), Gt(Some(Signed)), $1, $3) }
  | expression ">u" expression { binop($sloc, $loc($2), Gt(Some(Unsigned)), $1, $3) }
  | expression "<" expression { binop($sloc, $loc($2), Lt(None), $1, $3) }
  | expression "<s" expression { binop($sloc, $loc($2), Lt(Some(Signed)), $1, $3) }
  | expression "<u" expression { binop($sloc, $loc($2), Lt(Some(Unsigned)), $1, $3) }
  | expression ">=" expression { binop($sloc, $loc($2), Ge(None), $1, $3) }
  | expression ">=s" expression { binop($sloc, $loc($2), Ge(Some(Signed)), $1, $3) }
  | expression ">=u" expression { binop($sloc, $loc($2), Ge(Some(Unsigned)), $1, $3) }
  | expression "<=" expression { binop($sloc, $loc($2), Le(None), $1, $3) }
  | expression "<=s" expression { binop($sloc, $loc($2), Le(Some(Signed)), $1, $3) }
  | expression "<=u" expression { binop($sloc, $loc($2), Le(Some(Unsigned)), $1, $3) }
  | branch_expr { $1 }
  | SUSPEND tag_name "(" expression_list ")" {
      with_loc($sloc, Suspend($2, $4))
    }
  // The postfix handler clause of a resume-family method call, binding tightly
  // like `as`/`is`. Grammatically it attaches to any expression; the typer
  // accepts it only on the resume forms.
  | expression ON on_clauses { with_loc($sloc, On($1, $3)) }
  | expression "[" index_expression "]" { with_loc($sloc, ArrayGet($1, $3)) }
  | expression "?" then_branch ":" expression {
      with_loc($sloc, Select($1, $3, $5))
    }
  | "!" expression %prec prec_unary { unop($sloc, $loc($1), Not, $2) }
  | "+" expression %prec prec_unary { unop($sloc, $loc($1), Pos, $2) }
  | "-" expression %prec prec_unary { unop($sloc, $loc($1), Neg, $2) }
  | expression "!" { with_loc($sloc, NonNull($1)) }
  | expression "[" index_expression "]" "=" expression {
      with_loc($sloc, ArraySet($1, $3, $6))
    }
  ;

// The conditional branches that carry an operand. `if` is a blockinstr and is
// handled separately. Grouped so their shared prec_branch is declared once.
branch_expr -> Instr[Location]
  : BR_IF label expression %prec prec_branch { with_loc($sloc, BrIf($2, $3)) }
  | BR_ON_NULL label expression %prec prec_branch {
      with_loc($sloc, BrOnNull($2, $3))
    }
  | BR_ON_NON_NULL label expression %prec prec_branch {
      with_loc($sloc, BrOnNonNull($2, $3))
    }
  | BR_ON_CAST label reference_type expression %prec prec_branch {
      with_loc($sloc, BrOnCast($2, $3, $4))
    }
  | BR_ON_CAST_FAIL label reference_type expression %prec prec_branch {
      with_loc($sloc, BrOnCastFail($2, $3, $4))
    }
  | BR_ON_CAST label boption("?") descriptor_operand expression %prec prec_branch {
      with_loc($sloc, BrOnCastDescEq($2, $3, $5, $4))
    }
  | BR_ON_CAST_FAIL label boption("?") descriptor_operand expression %prec prec_branch {
      with_loc($sloc, BrOnCastDescEqFail($2, $3, $5, $4))
    }
  ;

// An array literal's contents, parameterised over the optional element type
// written before the `|`, which the caller supplies.
array_body -> (Ident?) -> InstrDesc[Location]
  : expression_list { fn(t) { ArrayFixed(t, $1) } }
  | expression ";" length_expression { fn(t) { Array(t, $1, $3) } }
  | ".." ";" length_expression { fn(t) { ArrayDefault(t, $3) } }
  | ident "@" expression ";" length_expression {
      fn(t) { ArraySegment(t, $1, $3, $5) }
    }
  ;

expression -> Instr[Location]
  : blockinstr %prec prec_block { $1 }
  | plaininstr { $1 }
  // A hint attribute prefixing an expression is deliberately GREEDY:
  // prec_block is the lowest precedence, so every operator shifts and the hint
  // takes the WHOLE expression. A placement whose extent a reader could not
  // guess -- `#[freq = 4] f(x) + 1` -- therefore lands on the BinOp and is
  // rejected by `hinted`'s target check, rather than silently binding to one
  // of the two readings. Rust refuses the same case in stmt_expr_attributes.
  | hint_attr expression %prec prec_block { hinted($1.0, [$1.1], $2) }
  ;

// ===========================================================================
// Statements
// ===========================================================================

let_pattern -> (Ident?, ValType?)
  : simple_pattern ioption(type_annot) { ($1, $2) }
  ;

type_annot -> ValType
  : ":" value_type { $2 }
  ;

let_pattern_ -> Array[(Ident?, ValType?)]
  : sep_trailing(",", let_pattern) { $1 }
  ;

// The operator of a compound assignment `x op= e`. Mirrors the value-producing
// arithmetic and bitwise operators; comparisons are excluded, since `x <= e`
// would be a comparison rather than an assignment.
compound_assign_op -> Annotated[@ast.BinOp, Location]
  : "+=" { annot($sloc, Add) }
  | "-=" { annot($sloc, Sub) }
  | "*=" { annot($sloc, Mul) }
  | "/=" { annot($sloc, Div(None)) }
  | "/s=" { annot($sloc, Div(Some(Signed))) }
  | "/u=" { annot($sloc, Div(Some(Unsigned))) }
  | "%s=" { annot($sloc, Rem(Signed)) }
  | "%u=" { annot($sloc, Rem(Unsigned)) }
  | "&=" { annot($sloc, And) }
  | "|=" { annot($sloc, Or) }
  | "^=" { annot($sloc, Xor) }
  | "<<=" { annot($sloc, Shl) }
  | ">>s=" { annot($sloc, Shr(Signed)) }
  | ">>u=" { annot($sloc, Shr(Unsigned)) }
  ;

// A statement with an optional stack of hint attributes.
//
// Statement-LIST positions do not use this: there a hint is a prefix of the
// list itself (see raw_statement_list), because `statement` excludes blockinstr
// and a list position must also serve the `;`-less hinted block form. This
// nonterminal is for the one isolated statement position -- the `while`
// continue-expression -- where the closing `)` keeps the recursion
// conflict-free.
hinted_statement -> Instr[Location]
  : statement { $1 }
  | hint_attr hinted_statement { hinted($1.0, [$1.1], $2) }
  ;

statement -> Instr[Location]
  : plaininstr { $1 }
  | NOP { with_loc($sloc, Nop) }
  | UNREACHABLE { with_loc($sloc, Unreachable) }
  | ident "=" expression { with_loc($sloc, Set($1, None, $3)) }
  // A discarded value: `_ = e` drops e. An optional type annotation pins a
  // width the surface syntax of the value would not otherwise carry, so it
  // round-trips at its original width. Represented as an ANONYMOUS Let --
  // nothing is bound -- not a Set.
  | "_" "=" expression { with_loc($sloc, Let([(None, None)], Some($3))) }
  | "_" ":" value_type "=" expression {
      with_loc($sloc, Let([(None, Some($3))], Some($5)))
    }
  | ident compound_assign_op expression {
      with_loc($sloc, Set($1, Some($2), $3))
    }
  | LET simple_pattern { with_loc($sloc, Let([($2, None)], None)) }
  | LET simple_pattern "=" expression {
      with_loc($sloc, Let([($2, None)], Some($4)))
    }
  | LET simple_pattern ":" value_type "=" expression {
      with_loc($sloc, Let([($2, Some($4))], Some($6)))
    }
  | LET simple_pattern ":" value_type {
      with_loc($sloc, Let([($2, Some($4))], None))
    }
  | LET "(" let_pattern_ ")" ioption(let_init) {
      with_loc($sloc, Let($3, $5))
    }
  | BR label ioption(expression) { with_loc($sloc, Br($2, $3)) }
  | BR_TABLE "[" case_labels "]" expression {
      let (lst, l) = $3
      with_loc($sloc, BrTable([..lst, l], $5))
    }
  | RETURN ioption(expression) { with_loc($sloc, Return($2)) }
  | THROW tag_name "(" expression_list ")" {
      with_loc($sloc, Throw($2, $4))
    }
  | THROW_REF expression { with_loc($sloc, ThrowRef($2)) }
  | BECOME expression "(" argument_list ")" {
      with_loc($sloc, TailCall($2, $4))
    }
  ;

let_init -> Instr[Location]
  : "=" expression { $2 }
  ;

// process_stmts pairs adjacent #[if]/#[else] groups; see raw.mbt.
statement_list -> Array[Instr[Location]]
  : raw_statement_list { process_stmts($1) }
  ;

raw_statement_list -> Array[RawStmt]
  : { [] }
  // A bare `;` is an empty statement. process_stmts strips it, so it
  // contributes nothing -- which makes a redundant `;` harmless anywhere, most
  // usefully after a block-shaped statement, which needs none (its `}` ends it)
  // but where the `;`-per-statement habit is strong.
  | ";" raw_statement_list { [Semi, ..$2] }
  | blockinstr raw_statement_list { [Plain($1), ..$2] }
  // A statement-level hint is NOT parsed together with its statement: it is a
  // prefix of the LIST, attached afterwards to the first statement that
  // follows.
  //
  // Parsing the pair as one unit cannot be done conflict-free. plaininstr has
  // `expression "(" argument_list ")"`, so a hinted expression is reachable at
  // statement start and any hint-plus-statement production overlaps it:
  // `#[a] if c { ... }` becomes derivable two ways. Attaching after the fact
  // leaves the grammar after the attribute EXACTLY the plain statement grammar
  // -- same states, same precedence resolutions, no conflicts -- and the
  // `;`-less block form and `;`-less stacking come for free.
  //
  // The hint must sit directly on its instruction: with nothing to land on (at
  // the end of a block), or landing on something that is not an instruction (an
  // empty `;` statement, still present in the raw list here, or an `#[if(...)]`
  // group), it is rejected at the attribute.
  | hint_attr raw_statement_list {
      let l = $2
      if l.length() > 0 && l[0] is Plain(i) {
        [Plain(hinted($1.0, [$1.1], i)), ..l[1:]]
      } else {
        {
          record_error(loc_of($1.0), "A hint may only prefix an instruction.")
          l
        }
      }
    }
  | cond_stmt raw_statement_list { [$1, ..$2] }
  // A statement is followed by an optional `";" more-statements`: the final `;`
  // of a block is OPTIONAL.
  //
  // This optional part is deliberately a real `option(...)` wrapper rather than
  // `ioption`, which is %inline and would re-expand into a direct
  // `raw_statement_list -> statement` production. Keeping it a distinct
  // nonterminal is what lets a missing `;` stop at this post-statement state --
  // where `;` is still shiftable -- and report the statement itself as the
  // subject, instead of folding on into the enclosing block.
  | statement option(semi_then_statements) {
      [Plain($1), ..$2.unwrap_or([])]
    }
  ;

semi_then_statements -> Array[RawStmt]
  : ";" raw_statement_list { $2 }
  ;

// Instruction-level conditional annotation. Braces are required, so the body is
// a transparent statement list rather than a block.
cond_stmt -> RawStmt
  : "#" "[" IF "(" condition ")" "]" braced_block { If($sloc, $5, $8) }
  | "#" "[" ELSE "]" braced_block { Else($sloc, $5) }
  ;

// ===========================================================================
// Module fields
// ===========================================================================

globalmut -> Bool
  : LET { true }
  | CONST { false }
  ;

constant_expression -> Instr[Location]
  : expression { $1 }
  ;

global -> (Attributes) -> Annotated[ModuleField[Location], Location]
  : globalmut ident ioption(type_annot) "=" constant_expression ";" {
      let (mut_, name, typ, def) = ($1, $2, $3, $5)
      fn(attributes) {
        annot($sloc, ModuleField::Global(name~, mut_~, typ~, def~, attributes~))
      }
    }
  ;

tag_def -> (Attributes) -> Annotated[ModuleField[Location], Location]
  : tag_signature ";" {
      let (name, typ, sign) = $1
      fn(attributes) {
        annot($sloc, ModuleField::Tag(name~, typ~, sign~, attributes~))
      }
    }
  ;

definition -> (Attributes) -> Annotated[ModuleField[Location], Location]
  : func { $1 }
  | global { $1 }
  | memory { $1 }
  | data { $1 }
  | table { $1 }
  | elem { $1 }
  | tag_def { $1 }
  ;

address_type -> AddressType
  : IDENT { address_type_of($sloc, $1) }
  ;

mem_limits -> (UInt64, UInt64?)
  : "[" INT ioption(limit_max) "]" {
      (u64_of_int_literal($loc($2), $2), $3)
    }
  ;

limit_max -> UInt64
  : "," INT { u64_of_int_literal($loc($2), $2) }
  ;

data_name -> Ident?
  : "_" { None }
  | ident { Some($1) }
  ;

// A data segment's contents: one or more elements -- a string literal, a
// numeric run, or a v128 constant -- concatenated with `++`.
data_init -> Array[@ast.DataElem]
  : data_element { [$1] }
  | data_element "++" data_init { [$1, ..$3] }
  ;

data_element -> @ast.DataElem
  : STRING { Str($1.desc) }
  | "[" ident ":" sep_trailing(",", data_run_item) "]" {
      data_run($loc($2), $2, $4)
    }
  ;

// One element of a data run: a scalar literal, or a v128 lane group
// `shape(lane, ...)`. data_run checks it matches the run's element type.
data_run_item -> DataRunItem
  : data_number { Num($1) }
  | ident "(" sep_trailing(",", data_number) ")" {
      let comps : Array[String] = []
      for n in $3 {
        comps.push(n.desc)
      }
      Vec(annot($sloc, { shape: vec_shape($loc($1), $1), components: comps }))
    }
  ;

// A bare numeric literal in a data run, kept as RAW TEXT: values are
// range-checked and encoded at typing and lowering, not here.
data_number -> Annotated[String, Location]
  : ioption(data_sign) raw_number { annot($sloc, $1.unwrap_or("") + $2) }
  ;

data_sign -> String
  : "-" { "-" }
  | "+" { "" }
  ;

raw_number -> String
  : INT { $1 }
  | FLOAT { $1 }
  | INF { "inf" }
  | NAN { "nan" }
  ;

data_item -> @ast.MemData[Location]
  : DATA data_name "@" "[" constant_expression "]" loption_data_init ";" {
      { data_name: $2, offset: $5, init: $7 }
    }
  ;

// `loption` in the stdlib works on @list.List; the AST holds arrays.
loption_data_init -> Array[@ast.DataElem]
  : { [] }
  | "=" data_init { $2 }
  ;

mem_pagesize -> Int
  : PAGESIZE INT { page_size_log2($loc($2), $2) }
  ;

memory -> (Attributes) -> Annotated[ModuleField[Location], Location]
  : MEMORY ident ":" address_type ioption(mem_limits) ioption(mem_pagesize)
    boption(SHARED) ";" {
      let (name, at, lim, ps, sh) = ($2, $4, $5, $6, $7)
      fn(attributes) {
        annot(
          $sloc,
          ModuleField::Memory(
            name~,
            address_type=at,
            limits=lim,
            page_size_log2=ps,
            shared=sh,
            data=[],
            attributes~,
          ),
        )
      }
    }
  | MEMORY ident ":" address_type ioption(mem_limits) ioption(mem_pagesize)
    boption(SHARED) "{" list_of(data_item) "}" {
      let (name, at, lim, ps, sh, items) = ($2, $4, $5, $6, $7, $9)
      fn(attributes) {
        annot(
          $sloc,
          ModuleField::Memory(
            name~,
            address_type=at,
            limits=lim,
            page_size_log2=ps,
            shared=sh,
            data=items,
            attributes~,
          ),
        )
      }
    }
  ;

data -> (Attributes) -> Annotated[ModuleField[Location], Location]
  : DATA data_name loption_data_init ";" {
      let (n, init) = ($2, $3)
      fn(attributes) {
        annot(
          $sloc,
          ModuleField::Data(name=n, mode=Passive, init~, attributes~),
        )
      }
    }
  | DATA data_name "@" ident "[" constant_expression "]" loption_data_init ";" {
      let (n, mem, off, init) = ($2, $4, $6, $8)
      fn(attributes) {
        annot(
          $sloc,
          ModuleField::Data(
            name=n,
            mode=Active(mem, off),
            init~,
            attributes~,
          ),
        )
      }
    }
  ;

table -> (Attributes) -> Annotated[ModuleField[Location], Location]
  : TABLE ident ":" ioption(address_type) reference_type ioption(mem_limits)
    ioption(table_init) ";" {
      let (name, at, rt, lim, init) = ($2, $4, $5, $6, $7)
      fn(attributes) {
        annot(
          $sloc,
          ModuleField::Table(
            name~,
            address_type=at.unwrap_or(I32),
            reftype=rt,
            limits=lim,
            init~,
            attributes~,
          ),
        )
      }
    }
  ;

table_init -> Instr[Location]
  : "=" expression { $2 }
  ;

elem -> (Attributes) -> Annotated[ModuleField[Location], Location]
  : ELEM ident ":" reference_type "=" "[" expression_list "]" ";" {
      let (name, rt, l) = ($2, $4, $7)
      fn(attributes) {
        annot(
          $sloc,
          ModuleField::Elem(
            name~,
            reftype=rt,
            mode=EPassive,
            init=l,
            attributes~,
          ),
        )
      }
    }
  | ELEM ident ":" reference_type "@" ident "[" constant_expression "]" "=" "["
    expression_list "]" ";" {
      let (name, rt, tab, off, l) = ($2, $4, $6, $8, $12)
      fn(attributes) {
        annot(
          $sloc,
          ModuleField::Elem(
            name~,
            reftype=rt,
            mode=EActive(tab, off),
            init=l,
            attributes~,
          ),
        )
      }
    }
  ;

// A module field yields a RawField. The `#[if]`/`#[else]` productions carry a
// located field list (braces mandatory) and become markers that lower_fields
// pairs into Conditionals. There is no standalone brace group: `{ ... }`
// appears only as a conditional branch body.
module_field -> RawField
  : rectype { FPlain({ desc: ModuleField::Type($1.desc), info: $1.info }) }
  | inner_attribute { FPlain(annot($sloc, ModuleField::ModuleAnnotation([$1]))) }
  | list_of(attribute) definition { FPlain(attributed($sloc, $1, $2)) }
  | IMPORT STRING import_item {
      FPlain(annot($sloc, ModuleField::Import(module_=$2, decl=$3)))
    }
  | IMPORT STRING "{" semi_list(import_item) "}" {
      FPlain(annot($sloc, ModuleField::ImportGroup(module_=$2, decls=$4)))
    }
  | "#" "[" IF "(" condition ")" "]" braced_fields { FIf($sloc, $5, $8) }
  | "#" "[" ELSE "]" braced_fields { FElse($sloc, $5) }
  ;

// A brace-delimited, lowered field list carrying a span over the whole
// `{ ... }`. A comment past the `}` is the branch's trailing trivia, emitted on
// the far side of the closing brace.
braced_fields -> LocatedFields
  : "{" semi_list(module_field) "}" { annot($sloc, lower_fields($2)) }
  ;

// One entry of an import block: an fn/const/let/tag/memory/table declaration,
// optionally carrying a name-only `#[import = "name"]` -- imported under that
// name rather than the Wax one -- or other attributes such as `#[export]`.
import_item -> Annotated[@ast.ImportDecl, Location]
  : list_of(attribute) import_kind_decl ";" {
      let (id, kind) = $2
      annot($sloc, { id, kind, attributes: $1 })
    }
  ;

import_kind_decl -> (Ident, @ast.ImportKind)
  : fundecl {
      let (name, typ, sign, exact) = $1
      (name, Func(typ~, sign~, exact~))
    }
  | globalmut ident ":" value_type { ($2, Global(mut_=$1, typ=$4)) }
  | tag_signature {
      let (name, typ, sign) = $1
      (name, Tag(typ~, sign~))
    }
  | MEMORY ident ":" address_type ioption(mem_limits) ioption(mem_pagesize)
    boption(SHARED) {
      (
        $2,
        Memory(
          address_type=$4,
          limits=$5,
          page_size_log2=$6,
          shared=$7,
        ),
      )
    }
  | TABLE ident ":" ioption(address_type) reference_type ioption(mem_limits) {
      ($2, Table(address_type=$4.unwrap_or(I32), reftype=$5, limits=$6))
    }
  ;

// ===========================================================================
// Conditional-compilation conditions
// ===========================================================================
//
// These are preserved, never evaluated here: the preprocessor consumes them.

condition -> Cond
  : ident { Var({ desc: $1.name, info: $1.loc }) }
  | ident condition_relop condition_literal {
      Cmp($2, Var({ desc: $1.name, info: $1.loc }), $3)
    }
  | ident "(" sep_trailing(",", condition) ")" {
      match ($1.name, $3) {
        ("all", l) => And(l)
        ("any", l) => Or(l)
        ("not", [c]) => Not(c)
        _ =>
          fail_at(
            loc_of($sloc),
            "Expected 'all', 'any', or 'not(<cond>)' in a condition.",
            default=And($3),
          )
      }
    }
  ;

condition_literal -> Cond
  : "(" INT "," INT "," INT ")" {
      Version(
        int_of_version_component($loc($2), $2),
        int_of_version_component($loc($4), $4),
        int_of_version_component($loc($6), $6),
      )
    }
  | STRING { Str($1) }
  ;

condition_relop -> @wasm_types.CmpOp
  : "=" { Eq }
  | "!=" { Ne }
  | "<" { Lt }
  | ">" { Gt }
  | "<=" { Le }
  | ">=" { Ge }
  ;

// ===========================================================================
// Entry point
// ===========================================================================

// lower_fields pairs top-level #[if]/#[else] fields into Conditionals.
parse -> @ast.LocModule
  : raw_parse { lower_fields($1) }
  ;

raw_parse -> Array[RawField]
  : EOF { [] }
  | ";" raw_parse { $2 }
  | module_field raw_parse { [$1, ..$2] }
  ;
