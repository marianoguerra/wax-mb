import {
  "waxmb/wax/basic",
  "waxmb/wax/tokens",
  "waxmb/wax/trivia",
  "waxmb/wax/lexer",
  "waxmb/wax/ast",
  "waxmb/wax/wasm_types",
  "moonbitlang/core/ref",
  "moonbitlang/core/list",
  "moonbitlang/core/string",
  "moonbitlang/core/math",
  "moonbitlang/core/set",
}

import {
  "moonbitlang/core/test",
  "moonbitlang/core/debug",
} for "test"

// parser.mbt is generated by moonyacc from parser.mbty.
//
// --table selects the TABLE engine over the default direct-style one (a
// function per state). The two parse identically; what differs is that the
// table engine represents a state as an Int, which is what makes the error
// state observable -- see state.mbt. Without it a state is an anonymous
// closure with no identity, and the reference's per-state messages have
// nothing to key on.

// -27 (deprecated_syntax) is the table engine's doing: it emits
// `priv suberror E T`, which the compiler now deprecates in favour of
// `priv suberror E { E(T) }`. 93 of them, all in the generated file. See
// test/UPSTREAM-FINDINGS.md finding 10.

warnings = "-6-27-text_segment_excceed"

formatter(ignore: [ "parser.mbt" ])

rule(
  name: "moonyacc",
  command: "moon runwasm moonbitlang/yacc@0.7.18 --no-comments --external-tokens --table $input -o $output",
)

dev_build(rule: "moonyacc", input: "parser.mbty", output: "parser.mbt")
